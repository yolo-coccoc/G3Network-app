# Settings of the charging test-day tools. Copy to .env (same folder) and fill
# in. The process environment wins over this file; inside the repository,
# backend/.env does too.

# The backend API. On a laptop it is reached through an SSH tunnel:
#   ssh -p 10022 -N -L 8000:127.0.0.1:8000 <user>@112.137.129.163
G3_API_URL=http://localhost:8000

# The OCPP gateway, reached directly on the public IP (TCP 9000).
G3_OCPP_URL=ws://112.137.129.163:9000

# The bootstrap HEAD_ADMIN (operator console, topology seed).
G3_ADMIN_PHONE=
G3_ADMIN_PASSWORD=

# The test drivers' password (seeded on the server with
# make charging-test-drivers-seed).
CHARGING_TEST_DRIVER_PASSWORD=

# The charger the tools act on when --charger / --identity is not given.
TEST_DAY_CHARGER_ID=G3WD-DHR75E
