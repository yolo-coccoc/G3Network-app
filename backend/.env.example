# Backend runtime configuration. `make setup` copies this file to backend/.env.
# Every setting lives in backend/app/libs/common/config.py (types, validation,
# defaults); only DATABASE_URL is required. Commented lines show the default -
# uncomment to override.
DATABASE_URL=postgresql+asyncpg://g3network:g3network123@localhost:5432/g3network

# Application metadata and process behavior
APP_NAME=G3Network Backend
APP_VERSION=0.1.0
APP_DESCRIPTION=Backend for G3Network - Electric truck driver support system
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# MQTT telemetry ingestion
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=g3network-backend
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_QOS=0
MQTT_TELEMETRY_TOPIC=g3network/telematics/+/telemetry
MQTT_STATUS_TOPIC_TEMPLATE=g3network/consumers/{client_id}/status
MQTT_WILL_QOS=1
MQTT_WILL_RETAIN=true

# Backend -> device commands over MQTT (F-J2 config push)
# MQTT_COMMAND_TOPIC_TEMPLATE=g3network/telematics/{telematic_serial}/command
# MQTT_COMMAND_CLIENT_ID=g3network-backend-command
# MQTT_COMMAND_QOS=1
# MQTT_COMMAND_RETAIN=false
# MQTT_COMMAND_TIMEOUT_SECONDS=5.0
# Bounds accepted for a pushed telemetry publish interval (seconds)
# TELEMATICS_MIN_TELEMETRY_INTERVAL_SECONDS=5
# TELEMATICS_MAX_TELEMETRY_INTERVAL_SECONDS=3600

# Telemetry ingestion tuning
TELEMETRY_QUEUE_SIZE=10000

# Telemetry history (F-A5) and operating/energy reports (F-A6/F-C6)
# TELEMETRY_HISTORY_MAX_RANGE_DAYS=7
# TELEMETRY_HISTORY_DEFAULT_LIMIT=500
# TELEMETRY_HISTORY_MAX_LIMIT=2000
# TELEMETRY_REPORT_MAX_RANGE_DAYS=366
# A vehicle is "online" while its newest telemetry arrived within this many seconds
# TELEMETRY_ONLINE_THRESHOLD_SECONDS=300
# Flat electricity price for report cost figures, and the SOH alert threshold
# TELEMETRY_ENERGY_COST_PER_KWH_VND=3000.0
# TELEMETRY_SOH_ALERT_THRESHOLD_PERCENT=70.0
# TELEMETRY_BATTERY_HEALTH_MAX_RANGE_DAYS=366

# Device-health monitor (F-J1/F-J3): sweep interval, and silence that raises an alert
# TELEMATICS_HEALTH_CHECK_INTERVAL_SECONDS=300.0
# TELEMATICS_SILENT_THRESHOLD_MINUTES=180

# Time zone that defines a report "day"/"week"/"month" (responses stay UTC)
# APP_REPORT_TIMEZONE=Asia/Ho_Chi_Minh

# Pagination for every list endpoint
# API_DEFAULT_PAGE=1
# API_DEFAULT_PAGE_SIZE=10
# API_MAX_PAGE_SIZE=100

# Nearby charging-station search (F-D1)
# CHARGING_STATIONS_NEARBY_MAX_RADIUS_KM=200.0
# Maximum span of the station energy time series (F-C5)
# CHARGING_ENERGY_SERIES_MAX_RANGE_DAYS=31

# Support SLA: minutes allowed to first respond (F-I1 tickets, F-I2 SOS)
# SUPPORT_TICKET_RESPONSE_SLA_MINUTES=60
# SUPPORT_SOS_RESPONSE_SLA_MINUTES=5

# Charging/OCPP development defaults; production needs review against real devices.
CHARGING_OCPP_HOST=0.0.0.0
CHARGING_OCPP_PORT=9000
# Largest accepted OCPP message (bytes); bigger frames are refused (close code
# 1009) instead of being stored truncated in the raw message log.
CHARGING_OCPP_MAX_MESSAGE_BYTES=1048576
# OCPP 1.6J heartbeat interval sent to chargers (seconds; spec range 60-300) and
# how long without any frame before a charger is reported offline.
CHARGING_OCPP_HEARTBEAT_INTERVAL_SECONDS=60
CHARGING_OFFLINE_TIMEOUT_SECONDS=180
# How long to wait for a charger's answer to a request the gateway sends.
CHARGING_OCPP_REQUEST_TIMEOUT_SECONDS=30
# Retry/DLQ/reconnect settings for chargers are deferred
# (docs/01-requirements/future.md item 27).
