# Settings of the charger simulator. Copy to .env (same folder) and fill in.
# The process environment wins over this file. Like a real charger's screen,
# the simulator needs the central system's URL and its own charger ID; it
# connects to <CHARGER_SERVER_URL><CHARGER_ID>.

# The central system (OCPP server): its IP, port and path.
CHARGER_SERVER_URL=ws://127.0.0.1:9000/ocpp/

# The charger's OCPP identity (chargePointId). The server must know it, or the
# connection is refused (HTTP 404 on our backend).
CHARGER_ID=SIM-CHARGER-01

# What the charger reports in its BootNotification. Empty serial = not sent.
CHARGER_VENDOR=G3 Simulator
CHARGER_MODEL=CHARGER-SIM-16
CHARGER_SERIAL=
CHARGER_FIRMWARE=charger-sim-0.1

# Seconds between heartbeats. Empty = the interval the server returns at boot
# (what a well-behaved charger does).
CHARGER_HEARTBEAT_INTERVAL=

# The simulator's web page. 127.0.0.1 = only this computer can open it;
# 0.0.0.0 = any computer on the network.
CHARGER_UI_HOST=127.0.0.1
CHARGER_UI_PORT=8090
