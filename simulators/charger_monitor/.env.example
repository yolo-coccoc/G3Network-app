# Settings of the charger monitor. Copy to .env (same folder) and fill in.
# The process environment wins over this file.

# The backend HTTP API (on the same machine by default).
MONITOR_API_URL=http://127.0.0.1:8000

# An internal staff account allowed to read the OCPP message log (the
# bootstrap HEAD_ADMIN works).
MONITOR_ADMIN_PHONE=
MONITOR_ADMIN_PASSWORD=

# The monitor's web page. 127.0.0.1 = only this machine (reach it through a
# port forward); 0.0.0.0 = any computer on the network.
MONITOR_UI_HOST=127.0.0.1
MONITOR_UI_PORT=8095
