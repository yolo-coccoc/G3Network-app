# Settings of the phone simulator. Copy to .env (same folder) and fill in.
# The process environment wins over this file.

# The backend HTTP API. On a laptop the API is reached through an SSH tunnel
# to the server's port 8000:  ssh -p 10022 -N -L 8000:127.0.0.1:8000 <user>@<server>
PHONE_API_URL=http://127.0.0.1:8000

# The phone's page (shaped like a phone screen).
PHONE_UI_HOST=127.0.0.1
PHONE_UI_PORT=8093

# A driver account to prefill on the login screen (optional). The account
# must have the DRIVER role (a self-signed-up customer has it).
PHONE_LOGIN_PHONE=
PHONE_LOGIN_PASSWORD=

# The simulated bank: an internal admin (HEAD_ADMIN or CO_ADMIN) it logs in as
# to confirm a VietQR top-up through the backend's development endpoint
# (BILLING_SIMULATE_TRANSFERS_ENABLED must be on). Empty = no bank button.
PHONE_BANK_ADMIN_PHONE=
PHONE_BANK_ADMIN_PASSWORD=
