# Infrastructure environment variables, read by infra/docker-compose.yml.
# `make setup` copies this file to infra/.env.

# PostgreSQL Configuration
POSTGRES_USER=g3network
POSTGRES_PASSWORD=g3network123
POSTGRES_DB=g3network

