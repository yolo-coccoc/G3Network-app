# === PYTHON ===
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing / coverage / dependency audit output
.pytest_cache/
.coverage
htmlcov/
backend/.audit/

# Type checking
.mypy_cache/

# Linting
.ruff_cache/

# === ENVIRONMENT VARIABLES ===
.env
.env.local
.env.*.local
infra/.env

# === IDE / EDITORS ===
# Shared VS Code workspace settings and recommended extensions are tracked;
# anything else under .vscode/ (launch configs, personal tweaks) stays local.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# === AI AGENT (.claude/ rules, skills and agents are tracked; personal overrides are not) ===
.claude/settings.local.json

# === OS ===
.DS_Store
Thumbs.db

# === LOGS ===
*.log
logs/
.claude/worktrees/
