// Domain model: the single source of truth for the whole database design.
//
// Every view under this directory (overview.md, domains/*.md,
// domain-model.xlsx) is GENERATED from this file. Edit only this file, then
// regenerate (see "How to use" in the Project note below).
//
// Conventions (enforced by the generator):
//   - Every table belongs to exactly one TableGroup; a TableGroup is a
//     backend domain (a bounded context).
//   - Every table note starts with a tag line:
//       @status built|planned|proposed  @owner customer|internal|two-party|undecided
//       @features F-xx,F-yy  [@hypertable <time column>]
//     built    = exists in backend/app/domains/*/models.py (must match exactly)
//     planned  = required by a feature in feature-list.md, not built yet
//     proposed = not in feature-list.md, but the model needs it
//   - Every column note gives the column's meaning, its Vietnamese meaning
//     (for the Excel export), then a sample value, in this order:
//       note: 'What the column holds. @vi Ý nghĩa của cột. @example 51D-123.45'
//     A foreign key's example reuses the example ID of the row it points to.
//   - Table and TableGroup notes end with a "@vi-name <tên>" line and a
//     "@vi <mô tả>" block; the open_decisions note ends with a "@vi" block.
//   - A column added to a BUILT table as a design proposal carries a note
//     starting with "@planned" (optionally followed by decision IDs and a
//     colon). The check command ignores such columns.
//   - Built tables use the exact PostgreSQL types and enum names from the
//     models; planned tables use plain types and list values in notes.
//   - Every foreign key is a standalone Ref with its delete action, written
//     FK side first.

Project g3_network {
  database_type: 'PostgreSQL'
  Note: '''
This is the domain model of the G3 Network backend: every table, which
domain owns it, who owns its data, and how it links to the rest.

**Status:** ✅ built (in the code today) · 📋 planned (a feature needs it)
· 🆕 proposed (not in the feature list, but the model needs it).

**Data owner:** *customer* = belongs to one organization (normally a customer; a G3
company can own such rows too, e.g. G3 Mobility's trucks) and carries
`organization_id`; *internal* = our own data, shared across organizations;
*two-party* = a G3 asset used by a customer (e.g. a charging session);
*undecided* = waiting on an open decision.

**How to use:** edit `domain-model.dbml` only, then run
`uv run --project backend --with pydbml --with openpyxl python .claude/skills/domain-model/scripts/domain_model.py generate`
from the repository root. `... check` verifies that built tables still match
the backend models and that these views are up to date.
'''
}

// ---------------------------------------------------------------------------
// Enums (built tables only; names are the PostgreSQL type names)
// ---------------------------------------------------------------------------

Enum vehiclestatus {
  ACTIVE
  INACTIVE
  MAINTENANCE [note: '@remove DM-25']
  DECOMMISSIONED [note: '@remove DM-25']
}

Enum vehicleactivationstatus {
  PENDING
  DEVICE_ASSIGNED
  ACTIVATED
}

Enum telematicstatus {
  ACTIVE
  INACTIVE
  MAINTENANCE [note: '@remove DM-25']
}

Enum driverstatus {
  ACTIVE
  INACTIVE
}

Enum fleetstatus {
  ACTIVE [note: '@remove FL-08']
  INACTIVE [note: '@remove FL-08']
}

Enum chargingstationmaintenancestatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
}

Enum chargingconnectorstatus {
  Available
  Occupied
  Reserved
  Unavailable
  Faulted
  Preparing
  Charging
  SuspendedEV
  SuspendedEVSE
  Finishing
}

Enum chargingocppmessagedirection {
  CP_TO_CSMS
  CSMS_TO_CP
}

Enum chargingsessionstatus {
  active [note: '@remove CE-10: becomes ACTIVE']
  completed [note: '@remove CE-10: becomes COMPLETED']
  PENDING [note: '@planned CE-10']
  ACTIVE [note: '@planned CE-10']
  COMPLETED [note: '@planned CE-10']
  ABANDONED [note: '@planned CE-10']
}

Enum chargingsessioneventtype {
  Started
  Updated
  Ended
}

Enum notificationtype {
  BATTERY_ALERT
  ANOMALY_ALERT
  SOH_ALERT
  DEVICE_OFFLINE_ALERT
  SOS_ALERT
  GEOFENCE_ALERT
  NO_DRIVER_CHECK_IN_ALERT [note: '@planned DR-07']
  OUTSIDE_DRIVER_CHECK_IN [note: '@planned DR-07']
}

Enum notificationseverity {
  INFO
  WARNING
  CRITICAL
}

Enum supportcasetype {
  TICKET
  SOS
}

Enum supportcasecategory {
  TECHNICAL
  BATTERY
  CHARGING
  BREAKDOWN
  ACCIDENT
  BILLING
  OTHER
}

Enum supportcasechannel {
  IN_APP
  ZALO
  HOTLINE
}

Enum supportcasestatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CLOSED
  CANCELLED
}

// ===========================================================================
// identity: organizations, users, roles, access audit (F-F1)
// ===========================================================================

Table organizations {
  organization_id uuid [pk, note: 'Internal ID of the organization. @vi Mã nội bộ của tổ chức. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  is_internal boolean [not null, note: 'TRUE for our own organization(s), the ones running this platform (outsourced staff acting for us, e.g. a hired sales company, are members of it too). Its users see data across every organization and get every feature (no plan limit), still limited to their role (decision ID-44); only an internal organization may hold HEAD_ADMIN and CO_ADMIN. FALSE for every other organization (customers, partners), whose users only see data related to their own organization, with features limited by its plan. A partner is recognised by having a repair_partners profile, not by this flag. The most security-sensitive column of the table: setting it grants cross-organization access. @vi TRUE với (các) tổ chức của chính chúng ta, đơn vị vận hành nền tảng (nhân sự thuê ngoài làm thay chúng ta, ví dụ một công ty bán hàng thuê ngoài, cũng là thành viên của tổ chức này). Người dùng của tổ chức này xem được dữ liệu của mọi tổ chức và dùng được mọi tính năng (không giới hạn theo gói), vẫn trong phạm vi vai trò (quyết định ID-44); chỉ tổ chức nội bộ mới được có HEAD_ADMIN và CO_ADMIN. FALSE với mọi tổ chức khác (khách hàng, đối tác): người dùng chỉ thấy dữ liệu liên quan tới tổ chức của mình, tính năng giới hạn theo gói dịch vụ. Đối tác được nhận biết bằng hồ sơ repair_partners, không bằng cờ này. Cột nhạy cảm nhất của bảng: bật cờ này là cấp quyền xem dữ liệu của mọi tổ chức. @example false']
  legal_form varchar(20) [not null, note: 'What kind of legal person the organization is, because the law treats them differently. COMPANY: a registered company (tax code of 10 digits, or 13 for a branch; invoices to the company). INDIVIDUAL: a private person, e.g. an owner-driver with one truck (the 12-digit citizen ID serves as tax code and is personal data: masked, consent required, every view audit-logged). Used to validate tax_code, apply the privacy rules and fill e-invoices. Internal organizations are always COMPANY; a partner may be either (a small workshop is often a household business, whose tax code is the owner\'s citizen ID). Values: COMPANY | INDIVIDUAL. @vi Tổ chức là loại chủ thể pháp lý nào, vì pháp luật đối xử khác nhau. COMPANY: doanh nghiệp có đăng ký (mã số thuế 10 số, hoặc 13 số với chi nhánh; hóa đơn xuất cho doanh nghiệp). INDIVIDUAL: cá nhân, ví dụ chủ xe tự lái một xe (số CCCD 12 số dùng làm mã số thuế, là dữ liệu cá nhân: che khi hiển thị, cần sự đồng ý, mọi lượt xem đều ghi nhật ký). Dùng để kiểm tra mã số thuế, áp dụng quy định bảo vệ dữ liệu cá nhân và điền hóa đơn điện tử. Tổ chức nội bộ luôn là COMPANY; đối tác có thể là một trong hai (xưởng nhỏ thường là hộ kinh doanh, mã số thuế là số CCCD của chủ hộ). Giá trị: COMPANY | INDIVIDUAL. @example COMPANY']
  display_name varchar(200) [not null, note: 'Short name shown in the app and the portal. @vi Tên ngắn hiển thị trên app và portal. @example Minh Phát Logistics']
  legal_name varchar(255) [not null, note: 'Full registered name of the company, or the full name of the person for an INDIVIDUAL; printed on invoices. @vi Tên đầy đủ theo đăng ký kinh doanh, hoặc họ tên đầy đủ với INDIVIDUAL; in trên hóa đơn. @example Công ty Cổ phần Vận tải Minh Phát']
  tax_code varchar(20) [note: 'Tax code required for e-invoices. COMPANY: the company tax code (10 digits, or 13 for a branch). INDIVIDUAL: for now (since 1 Jul 2025, Circular 86/2024), the 12-digit citizen ID (CCCD) number serves as the personal tax code; it is personal data under Decree 13/2023. Unique among organizations not deleted. @vi Mã số thuế để xuất hóa đơn điện tử. COMPANY: mã số thuế doanh nghiệp (10 số, hoặc 13 số với chi nhánh). INDIVIDUAL: hiện tại (từ 1/7/2025, Thông tư 86/2024), số CCCD 12 số được dùng làm mã số thuế cá nhân; đây là dữ liệu cá nhân theo Nghị định 13/2023. Không trùng giữa các tổ chức chưa bị xóa. @example 0312345678']
  address varchar(500) [note: 'Registered address, printed on invoices. @vi Địa chỉ đăng ký, in trên hóa đơn. @example 12 Nguyễn Văn Linh, Phường Tân Thuận Tây, Quận 7, TP.HCM']
  status varchar(20) [not null, note: 'Organization lifecycle. ACTIVE: in service. SUSPENDED: temporarily stopped (e.g. unpaid debt), logins blocked, vehicle data still collected, reversible. CLOSED: has left (no active contract), logins blocked, no new data, data kept for the legal retention period; always together with deleted_at (DM-25); reopened only when a new contract is signed. Values: ACTIVE | SUSPENDED | CLOSED. @vi Vòng đời tổ chức. ACTIVE: đang sử dụng. SUSPENDED: tạm ngừng (ví dụ nợ cước), chặn đăng nhập nhưng vẫn thu dữ liệu xe, có thể mở lại. CLOSED: đã rời đi (không còn hợp đồng), chặn đăng nhập, không nhận dữ liệu mới, dữ liệu được giữ theo thời hạn luật định; luôn đi cùng deleted_at (DM-25); chỉ mở lại khi ký hợp đồng mới. Giá trị: ACTIVE | SUSPENDED | CLOSED. @example ACTIVE']
  status_reason varchar(200) [note: 'Why the organization is in its current status; NULL when ACTIVE. @vi Lý do của trạng thái hiện tại; NULL khi ACTIVE. @example NULL']
  account_manager_id uuid [note: 'Our SALES user responsible for this customer (one at a time); NULL when none is assigned. Reassignments are kept in organization_history. @vi Người dùng SALES của chúng ta phụ trách khách hàng này (mỗi lúc một người); NULL khi chưa giao. Lịch sử thay đổi người phụ trách được lưu trong organization_history. @example 0000001f-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the row is no longer part of the system, because it left or was entered by mistake (DM-25); all its data is kept, and the reason is in status_reason. NULL while it is part of the system. An organization that leaves is CLOSED and soft-deleted; signing a new contract makes it ACTIVE again and clears this. @vi Thời điểm xóa mềm: bản ghi không còn thuộc hệ thống, do đã rời đi hoặc nhập nhầm (DM-25); mọi dữ liệu vẫn được giữ, lý do nằm trong status_reason. NULL khi còn thuộc hệ thống. Tổ chức rời đi được chuyển sang CLOSED và xóa mềm; ký hợp đồng mới thì trở lại ACTIVE và xóa giá trị này. @example NULL']
  indexes {
    tax_code [unique, name: 'uq_organizations_active_tax_code', note: 'WHERE deleted_at IS NULL']
  }
  Note: '''@status proposed @owner internal @features F-F1,F-H3 @tracked *
Every party that people act for: customers (transport companies and
individual owner-drivers), our own internal organization(s), and
repair/rescue partners - all stored the same way. Every organization-owned
row points here through `organization_id`; our own trucks are owned exactly
like a customer's. Only `is_internal` sets organizations apart, for access:
internal users see across organizations, everyone else only their own.
There is no separate contact list: whoever must receive something (invoices,
reminders, alerts) is a user holding the matching role. Contracts and
service packages live in their own tables.
Check constraint: (status = 'CLOSED') = (deleted_at IS NOT NULL) (DM-25).
@vi-name Tổ chức
@vi Mọi bên mà người dùng đại diện: khách hàng (doanh nghiệp vận tải và chủ xe cá nhân tự lái), (các) tổ chức nội bộ của chính chúng ta, và đối tác sửa chữa/cứu hộ - tất cả được lưu như nhau. Mọi dữ liệu thuộc một tổ chức đều trỏ về đây qua organization_id; xe của chính chúng ta được sở hữu giống hệt xe của khách hàng. Chỉ is_internal phân biệt các tổ chức về quyền truy cập: người dùng nội bộ xem được dữ liệu của mọi tổ chức, còn lại chỉ xem dữ liệu của chính mình. Không có danh sách người liên hệ riêng: ai cần nhận thông tin (hóa đơn, nhắc nhở, cảnh báo) đều là người dùng giữ vai trò tương ứng. Hợp đồng và gói dịch vụ nằm ở bảng riêng. Ràng buộc kiểm tra: (status = 'CLOSED') = (deleted_at IS NOT NULL) (DM-25).'''
}

Table users {
  user_id uuid [pk, note: 'Internal ID of the login. @vi Mã nội bộ của tài khoản đăng nhập. @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  email varchar(255) [note: 'E-mail, optional; unique when present among accounts not deleted, ignoring upper/lower case. A message the user is entitled to (its service is in one of their roles and in their organization\'s plan) goes to the app, the fleet portal and, when an address is on file, this e-mail; with no address, nothing is e-mailed. There is no per-user channel choice. @vi Email, không bắt buộc; khi có thì không trùng giữa các tài khoản chưa bị xóa, không phân biệt chữ hoa/thường. Thông tin mà người dùng được hưởng (dịch vụ đó nằm trong một vai trò của họ và trong gói của tổ chức) được gửi tới app, fleet portal và, khi có địa chỉ, tới email này; không có email thì không gửi email. Người dùng không tự chọn kênh nhận. @example dieuvan@minhphat.vn']
  phone_number varchar(20) [not null, note: 'Phone number in E.164 format, required and unique among accounts not deleted: the login ID (login is phone + password; other methods come later). Carriers recycle numbers, so a password reset by OTP on an account inactive for a long time (e.g. 90 days without activity) needs an extra check by customer care or the organization admin before it succeeds. @vi Số điện thoại (định dạng E.164), bắt buộc và không trùng giữa các tài khoản chưa bị xóa: là tên đăng nhập (đăng nhập bằng số điện thoại + mật khẩu; các cách khác sẽ bổ sung sau). Nhà mạng cấp lại số cũ cho thuê bao mới, nên việc đặt lại mật khẩu bằng OTP cho tài khoản lâu không hoạt động (ví dụ 90 ngày) cần CSKH hoặc quản trị tổ chức xác minh thêm mới được thực hiện. @example +84901234567']
  full_name varchar(100) [not null, note: 'The person\'s full name, shown in the app, the portal and audit logs. @vi Họ và tên của người dùng, hiển thị trên app, portal và nhật ký kiểm toán. @example Trần Thị Bình']
  status varchar(20) [not null, note: 'State of the whole account, across every organization: INVITED (no password set yet), ACTIVE, or LOCKED (only our HEAD_ADMIN/CO_ADMIN lock a whole account; an organization locks a person only in its own membership). Values: INVITED | ACTIVE | LOCKED. @vi Trạng thái của cả tài khoản, trên mọi tổ chức: INVITED (chưa đặt mật khẩu), ACTIVE, hoặc LOCKED (chỉ HEAD_ADMIN/CO_ADMIN của chúng ta khóa cả tài khoản; một tổ chức chỉ khóa người đó trong thành viên của tổ chức mình). Giá trị: INVITED | ACTIVE | LOCKED. @example ACTIVE']
  status_reason varchar(200) [note: 'Why the account has its current status (e.g. why it was locked or unlocked); NULL when there is nothing to explain. Earlier reasons are kept in user_history. @vi Lý do của trạng thái hiện tại của tài khoản (ví dụ vì sao bị khóa hoặc được mở khóa); NULL khi không có gì cần giải thích. Các lý do trước đó được lưu trong user_history. @example Báo mất điện thoại, khóa tạm chờ xác minh']
  created_by uuid [note: 'User who created this account (our sales/admin, an ORG_ADMIN, a fleet manager registering a driver); NULL when the person signed up themselves. @vi Người dùng đã tạo tài khoản này (nhân viên bán hàng/quản trị của chúng ta, ORG_ADMIN, quản lý đội xe khi đăng ký tài xế); NULL khi người dùng tự đăng ký. @example 0000001f-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the row is no longer part of the system, because it left or was entered by mistake (DM-25); all its data is kept, and the reason is in status_reason. NULL while it is part of the system. A deleted account is also LOCKED, and its phone number and e-mail are free for a new account (ID-28). @vi Thời điểm xóa mềm: bản ghi không còn thuộc hệ thống, do đã rời đi hoặc nhập nhầm (DM-25); mọi dữ liệu vẫn được giữ, lý do nằm trong status_reason. NULL khi còn thuộc hệ thống. Tài khoản bị xóa cũng bị LOCKED, và số điện thoại, e-mail của nó được dùng lại cho tài khoản mới (ID-28). @example NULL']
  indexes {
    phone_number [unique, name: 'uq_users_active_phone_number', note: 'WHERE deleted_at IS NULL']
    `lower(email)` [unique, name: 'uq_users_active_email', note: 'WHERE deleted_at IS NULL AND email IS NOT NULL: case-insensitive']
  }
  Note: '''@status planned @owner internal @features F-F1 @tracked *
A person - one account per human, across every organization they work for
(a person may belong to several, through memberships): customer staff, a
driver, our own staff or a partner technician. What they may do comes from their roles (job titles);
facts about a job (e.g. a driver's licence) live in a profile, and a DRIVER
role requires an active driver profile.
Check constraint: deleted_at IS NULL OR status = 'LOCKED' (DM-25).
@vi-name Người dùng
@vi Một con người - mỗi người một tài khoản, dùng cho mọi tổ chức mà họ làm việc (một người có thể thuộc nhiều tổ chức, qua bảng memberships): nhân viên khách hàng, tài xế, nhân viên nội bộ hoặc kỹ thuật viên đối tác. Quyền của họ đến từ vai trò (chức danh); thông tin riêng của một công việc (ví dụ bằng lái của tài xế) nằm ở hồ sơ, và vai trò DRIVER cần một hồ sơ tài xế còn hiệu lực. Ràng buộc kiểm tra: deleted_at IS NULL OR status = 'LOCKED' (DM-25).'''
}

Table memberships {
  membership_id uuid [pk, note: 'Internal ID of the membership: one person in one organization. @vi Mã nội bộ của thành viên: một người trong một tổ chức. @example 00000022-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  organization_id uuid [not null, note: 'Organization the person works for or acts for. @vi Tổ chức mà người đó làm việc hoặc đại diện. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  user_id uuid [not null, note: 'The person. @vi Người đó. @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  status varchar(20) [not null, note: 'Standing of the person in this organization only. INVITED: added but not yet accepted (a person already registered elsewhere accepts the invitation in the app). ACTIVE. LOCKED: blocked here by the organization, without affecting their other organizations. Values: INVITED | ACTIVE | LOCKED. The organization\'s ORG_ADMIN cannot be locked or removed: the role is handed over first. If the organization itself is SUSPENDED or CLOSED, its members cannot log in to it, but their memberships are left as they are, so everyone continues if a new contract is signed. @vi Tư cách của người đó chỉ trong tổ chức này. INVITED: đã được thêm nhưng chưa chấp nhận (người đã có tài khoản ở nơi khác chấp nhận lời mời trên app). ACTIVE. LOCKED: bị tổ chức này chặn, không ảnh hưởng các tổ chức khác của họ. Giá trị: INVITED | ACTIVE | LOCKED. Không thể khóa hoặc loại ORG_ADMIN của tổ chức: phải chuyển giao vai trò trước. Khi bản thân tổ chức bị SUSPENDED hoặc CLOSED, thành viên không đăng nhập được vào tổ chức đó, nhưng thành viên được giữ nguyên, để mọi người tiếp tục nếu ký hợp đồng mới. @example ACTIVE']
  status_reason varchar(200) [note: 'Why the membership has its current status, or why it ended: e.g. why the organization locked the person, or whether they left, were removed or never accepted the invitation. NULL when there is nothing to explain. Earlier reasons are kept in membership_history. @vi Lý do của trạng thái hiện tại của thành viên, hoặc vì sao thành viên kết thúc: ví dụ vì sao tổ chức khóa người này, hoặc họ tự rời đi, bị loại hay không bao giờ chấp nhận lời mời. NULL khi không có gì cần giải thích. Các lý do trước đó được lưu trong membership_history. @example NULL']
  joined_at timestamptz [note: 'When the person accepted and became an active member; NULL while INVITED. When they were added or invited is created_at. @vi Thời điểm người đó chấp nhận và trở thành thành viên hoạt động; NULL khi còn INVITED. Thời điểm được thêm hoặc được mời là created_at. @example 2026-09-01T02:00:00Z']
  left_at timestamptz [note: 'When the person left (or was removed, or the invitation was cancelled); NULL while a member. Why is in status_reason. Their roles end with it, but their history stays. @vi Thời điểm người đó rời (hoặc bị loại khỏi) tổ chức; NULL khi vẫn là thành viên. Vai trò kết thúc theo, nhưng lịch sử được giữ nguyên. @example NULL']
  created_by uuid [note: 'User who added the person (an ORG_ADMIN, our sales/admin, a fleet manager registering a driver); NULL when the person created their own personal organization. @vi Người dùng đã thêm người này (ORG_ADMIN, nhân viên bán hàng/quản trị của chúng ta, quản lý đội xe khi đăng ký tài xế); NULL khi người đó tự tạo tổ chức cá nhân. @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  created_at timestamptz [not null, note: 'When the person was added or invited (UTC). @vi Thời điểm người đó được thêm hoặc được mời (UTC). @example 2026-08-31T09:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  indexes {
    (organization_id, user_id) [unique, name: 'uq_memberships_active', note: 'WHERE left_at IS NULL']
    user_id [name: 'ix_memberships_user_id']
    (membership_id, organization_id) [unique, name: 'uq_memberships_id_organization', note: 'Target of the two-column foreign key from user_role_assignments, so a role can only name its membership\'s own organization']
  }
  Note: '''@status proposed @owner customer @features F-F1 @tracked *
One person in one organization (owner decision, 2026-10-03: a person may belong to several,
e.g. their personal organization and the company that hired them as a
driver). Roles, fleet limits and job profiles hang off the membership. After
login, a person with several organizations picks one (the last one is
remembered in user_state); every query then filters by that organization.
@vi-name Thành viên tổ chức
@vi Một người trong một tổ chức (quyết định ngày 03/10/2026: một người có thể thuộc nhiều tổ chức, ví dụ tổ chức cá nhân và công ty tuyển họ làm tài xế). Vai trò, giới hạn đội xe và hồ sơ công việc gắn với thành viên. Sau khi đăng nhập, người thuộc nhiều tổ chức chọn một tổ chức (tổ chức dùng gần nhất được ghi nhớ trong user_state); mọi truy vấn sau đó lọc theo tổ chức đó.'''
}

Table user_state {
  user_id uuid [pk, note: 'The user this live state belongs to (1:1 with users). @vi Người dùng sở hữu trạng thái này (1:1 với users). @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  last_login_at timestamptz [note: 'Latest successful login; NULL if never logged in. @vi Lần đăng nhập thành công gần nhất; NULL nếu chưa từng đăng nhập. @example 2026-09-14T23:10:00Z']
  last_organization_id uuid [note: 'Organization the user last acted for, opened directly at the next login (for a person who belongs to several organizations). If the person no longer has an active membership there, the login shows the organization picker instead. @vi Tổ chức người dùng làm việc gần nhất, được mở thẳng ở lần đăng nhập sau (với người thuộc nhiều tổ chức). Nếu người đó không còn là thành viên đang hoạt động của tổ chức này, lần đăng nhập sẽ hiện màn hình chọn tổ chức. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  failed_login_count integer [not null, note: 'Consecutive failed password attempts since the last successful login; reset to 0 on a successful login and on a successful password reset. Protects against password guessing. @vi Số lần nhập sai mật khẩu liên tiếp kể từ lần đăng nhập thành công gần nhất; trở về 0 khi đăng nhập thành công và khi đặt lại mật khẩu thành công. Dùng để chống dò mật khẩu. @example 0']
  login_locked_until timestamptz [note: 'Logins are refused until this time after too many failures (e.g. 15 minutes after 5 failed attempts); NULL when not locked. Different from a LOCKED account, which an admin decides. Because anyone who knows the phone number could trigger it, the lock is short, a password reset by OTP still works during it and clears it (set back to NULL), and the API also rate-limits attempts per device/IP. @vi Từ chối đăng nhập cho tới thời điểm này sau quá nhiều lần sai (ví dụ 15 phút sau 5 lần sai); NULL khi không bị khóa. Khác với tài khoản LOCKED do quản trị viên quyết định. Vì bất kỳ ai biết số điện thoại cũng có thể gây ra việc khóa này, thời gian khóa ngắn, vẫn đặt lại mật khẩu bằng OTP được trong lúc bị khóa và việc đó gỡ khóa luôn (đưa về NULL), và API còn giới hạn số lần thử theo thiết bị/IP. @example NULL']
  last_active_at timestamptz [note: 'Latest request or action in the app or portal; NULL if never active. Written at most once every 5 minutes per user (not on every request), which is precise enough for an inactive-users report. @vi Lần gần nhất người dùng gửi yêu cầu hoặc thao tác trên app/portal; NULL nếu chưa từng hoạt động. Chỉ ghi tối đa 5 phút một lần cho mỗi người dùng (không ghi ở mọi yêu cầu), đủ chính xác cho báo cáo người dùng không hoạt động. @example 2026-09-15T08:42:10Z']
  Note: '''@status planned @owner internal @features F-F1 @state-of users
Live activity of a user, recorded by the system (observations, not decisions):
updated on every login and request, so kept apart from the users profile and
never history-tracked. Created with default values together with the user, so
every user always has exactly one state row. Only the latest values live here;
the history of logins and other account security events is in
access_audit_logs.
@vi-name Trạng thái người dùng
@vi Hoạt động trực tiếp của người dùng do hệ thống ghi nhận (quan sát, không phải quyết định): cập nhật mỗi lần đăng nhập và mỗi yêu cầu, nên tách khỏi hồ sơ người dùng và không lưu lịch sử thay đổi. Được tạo cùng lúc với người dùng, với giá trị mặc định, nên mỗi người dùng luôn có đúng một dòng trạng thái. Bảng này chỉ giữ giá trị mới nhất; lịch sử đăng nhập và các sự kiện bảo mật tài khoản nằm ở access_audit_logs.'''
}

Table user_credentials {
  user_credential_id uuid [pk, note: 'Internal ID of the credential. @vi Mã nội bộ của thông tin xác thực. @example 0000001e-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  user_id uuid [not null, note: 'User the credential belongs to. @vi Người dùng sở hữu thông tin xác thực. @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  credential_type varchar(20) [not null, note: 'How the user proves who they are. Only PASSWORD today (with phone_number as the login ID); other methods (OTP, single sign-on) are added later as new values. Values: PASSWORD. @vi Cách người dùng chứng minh danh tính. Hiện chỉ có PASSWORD (với phone_number là tên đăng nhập); các cách khác (OTP, đăng nhập một lần) sẽ bổ sung sau bằng giá trị mới. Giá trị: PASSWORD. @example PASSWORD']
  secret_hash varchar(255) [not null, note: 'One-way hash of the secret (e.g. Argon2id of the password), never the secret itself. Never copied to any history table or log. @vi Giá trị băm một chiều của bí mật (ví dụ Argon2id của mật khẩu), không bao giờ lưu bản thân bí mật. Không bao giờ được chép sang bảng lịch sử hay nhật ký. @example $argon2id$v=19$m=65536,t=3,p=4$...']
  created_at timestamptz [not null, note: 'When the credential was set (e.g. the password chosen). @vi Thời điểm thiết lập (ví dụ thời điểm đặt mật khẩu). @example 2026-09-01T02:00:00Z']
  revoked_at timestamptz [note: 'When it stopped being valid (replaced by a new password, or revoked); NULL while valid. @vi Thời điểm hết hiệu lực (bị thay bằng mật khẩu mới hoặc bị thu hồi); NULL khi còn hiệu lực. @example NULL']
  indexes {
    (user_id, credential_type) [unique, name: 'uq_user_credentials_active_type', note: 'WHERE revoked_at IS NULL']
  }
  Note: '''@status planned @owner internal @features F-F1
How each user logs in. Kept out of the users table so a password hash is
never copied into user history, and so new login methods are new rows, not
new columns. A password change revokes the old row and adds a new one; only
the last 5 revoked passwords per user are kept (for the "don't reuse a recent
password" check), older ones are deleted. Login sessions are not here: each
logged-in device is a row of user_sessions.
@vi-name Thông tin đăng nhập
@vi Cách mỗi người dùng đăng nhập. Tách khỏi bảng users để giá trị băm mật khẩu không bao giờ bị chép sang lịch sử người dùng, và để cách đăng nhập mới chỉ là dòng mới, không phải cột mới. Đổi mật khẩu sẽ thu hồi dòng cũ và thêm dòng mới; chỉ giữ 5 mật khẩu đã thu hồi gần nhất của mỗi người dùng (để kiểm tra không dùng lại mật khẩu gần đây), các dòng cũ hơn bị xóa. Phiên đăng nhập không nằm ở đây: mỗi thiết bị đang đăng nhập là một dòng của user_sessions.'''
}

Table user_sessions {
  user_session_id uuid [pk, note: 'Internal ID of the session: one login of one person on one device or browser. @vi Mã nội bộ của phiên: một lần đăng nhập của một người trên một thiết bị hoặc trình duyệt. @example 00000023-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  user_id uuid [not null, note: 'The person logged in. A person can have several sessions (phone, tablet, browsers); one app install holds one login at a time. @vi Người đang đăng nhập. Một người có thể có nhiều phiên (điện thoại, máy tính bảng, trình duyệt); mỗi bản cài app chỉ giữ một lần đăng nhập tại một thời điểm. @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  organization_id uuid [note: 'Organization the app is showing on this device right now (a person in several organizations switches without logging in again; every request is still checked against their membership). Not a filter for push: notifications from all the person\'s organizations reach every session, and opening one switches to its organization. NULL until an organization is picked. @vi Tổ chức mà app đang hiển thị trên thiết bị này (người thuộc nhiều tổ chức chuyển đổi mà không cần đăng nhập lại; mọi yêu cầu vẫn được kiểm tra theo tư cách thành viên). Không dùng để lọc thông báo đẩy: thông báo của mọi tổ chức của người đó tới mọi phiên, và mở thông báo sẽ chuyển sang tổ chức của nó. NULL cho tới khi chọn tổ chức. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  platform varchar(10) [not null, note: 'Where the app runs; also decides the session lifetime. Values: ANDROID | IOS | WEB. @vi Nơi app chạy; cũng quyết định thời hạn phiên. Giá trị: ANDROID | IOS | WEB. @example ANDROID']
  app_version varchar(20) [note: 'App version on the device, for support and forced upgrades; NULL for a browser. @vi Phiên bản app trên thiết bị, phục vụ hỗ trợ và bắt buộc nâng cấp; NULL với trình duyệt. @example 1.4.2']
  device_label varchar(100) [note: 'Readable name of the device or browser, shown in the user\'s "my devices" list. @vi Tên dễ đọc của thiết bị hoặc trình duyệt, hiển thị trong danh sách "thiết bị của tôi". @example Samsung SM-A546E · Android 13']
  refresh_token_hash varchar(255) [not null, unique, note: 'One-way hash of the refresh token that keeps the session alive; replaced by a new token each time it is used. Never the token itself. @vi Giá trị băm một chiều của refresh token giữ cho phiên còn hiệu lực; được thay bằng token mới mỗi lần sử dụng. Không bao giờ lưu bản thân token. @example 9f2c4e…(sha-256)']
  push_token varchar(512) [unique, note: 'Firebase Cloud Messaging token of this device (APNs behind it on iOS), re-sent by the app at login and when it changes; NULL when the user refused notifications or the browser has none. Removed with the session, so a shared phone never gets the previous user\'s messages. @vi Mã nhận thông báo đẩy Firebase Cloud Messaging của thiết bị này (APNs phía sau trên iOS), app gửi lại khi đăng nhập và khi mã thay đổi; NULL khi người dùng từ chối thông báo hoặc trình duyệt không hỗ trợ. Bị xóa cùng phiên, để điện thoại dùng chung không nhận tin của người dùng trước. @example fGx1…:APA91b…']
  created_at timestamptz [not null, note: 'When the person logged in. @vi Thời điểm người dùng đăng nhập. @example 2026-09-01T02:00:00Z']
  last_used_at timestamptz [not null, note: 'Last time the session was used (token refresh or request); written at most once every 5 minutes. @vi Lần gần nhất phiên được dùng (làm mới token hoặc gửi yêu cầu); ghi tối đa 5 phút một lần. @example 2026-09-15T08:40:00Z']
  expires_at timestamptz [not null, note: 'Future time when the session ends if not used: set at login to now + the lifetime, and pushed forward to last use + the lifetime each time it is used. Lifetimes are settings: 90 days for the driver app, 7 days for the customer portal, 1 day for our internal staff. A request after this time is refused; a cleanup job deletes expired rows. @vi Thời điểm trong tương lai phiên hết hạn nếu không được dùng: khi đăng nhập đặt bằng hiện tại + thời hạn, và mỗi lần dùng lại được dời tới lần dùng cuối + thời hạn. Thời hạn là cấu hình: 90 ngày với app tài xế, 7 ngày với portal khách hàng, 1 ngày với nhân viên nội bộ. Yêu cầu sau thời điểm này bị từ chối; một tác vụ dọn dẹp xóa các phiên hết hạn. @example 2026-12-14T08:40:00Z']
  indexes {
    user_id [name: 'ix_user_sessions_user_id']
    expires_at [name: 'ix_user_sessions_expires_at', note: 'Cleanup of expired sessions']
  }
  Note: '''@status proposed @owner internal @features F-F1,F-F3
One login of one person on one device or browser, holding both the session
(refresh token) and that device\'s push token. Ending a session deletes its
row: logout, "log out this device / all devices", a password change, an
account lock, expiry, or Firebase reporting the app uninstalled. The login
and logout history is in access_audit_logs, so nothing is lost. Not
history-tracked.
@vi-name Phiên đăng nhập
@vi Một lần đăng nhập của một người trên một thiết bị hoặc trình duyệt, giữ cả phiên (refresh token) và mã nhận thông báo đẩy của thiết bị đó. Kết thúc phiên là xóa dòng: đăng xuất, "đăng xuất thiết bị này / mọi thiết bị", đổi mật khẩu, khóa tài khoản, hết hạn, hoặc Firebase báo app đã bị gỡ. Lịch sử đăng nhập và đăng xuất nằm ở access_audit_logs, nên không mất thông tin. Không lưu lịch sử thay đổi.'''
}

Table one_time_codes {
  one_time_code_id uuid [pk, note: 'Internal ID of the code. @vi Mã nội bộ của mã dùng một lần. @example 00000020-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  purpose varchar(20) [not null, note: 'What the code is for. INVITE: an invited user sets their password. SIGN_UP: a guest proves their phone before the account is created. PASSWORD_RESET: a forgotten password. PHONE_CHANGE: proving a new phone number. Values: INVITE | SIGN_UP | PASSWORD_RESET | PHONE_CHANGE. @vi Mã dùng cho việc gì. INVITE: người được mời đặt mật khẩu. SIGN_UP: khách vãng lai xác minh số điện thoại trước khi tạo tài khoản. PASSWORD_RESET: quên mật khẩu. PHONE_CHANGE: xác minh số điện thoại mới. Giá trị: INVITE | SIGN_UP | PASSWORD_RESET | PHONE_CHANGE. @example INVITE']
  user_id uuid [note: 'User the code is for; NULL for SIGN_UP, when the account does not exist yet. @vi Người dùng nhận mã; NULL với SIGN_UP, khi tài khoản chưa tồn tại. @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  phone_number varchar(20) [not null, note: 'Phone number the code was sent to by SMS (E.164). @vi Số điện thoại nhận mã qua SMS (định dạng E.164). @example +84901234567']
  code_hash varchar(255) [not null, note: 'One-way hash of the code or link token, never the code itself. @vi Giá trị băm một chiều của mã hoặc token trong đường dẫn, không bao giờ lưu bản thân mã. @example $argon2id$v=19$...']
  issued_by uuid [note: 'User who triggered the code (the admin who sent an invite); NULL when the person asked for it themselves. @vi Người dùng tạo ra mã (quản trị viên gửi lời mời); NULL khi chính người đó yêu cầu. @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  created_at timestamptz [not null, note: 'When the code was sent; used for the resend cooldown and per-phone limits. @vi Thời điểm gửi mã; dùng cho thời gian chờ gửi lại và giới hạn theo số điện thoại. @example 2026-09-01T02:00:00Z']
  expires_at timestamptz [not null, note: 'When the code stops working (e.g. 10 minutes for an OTP, 72 hours for an invite link). @vi Thời điểm mã hết hiệu lực (ví dụ 10 phút với OTP, 72 giờ với đường dẫn mời). @example 2026-09-04T02:00:00Z']
  failed_attempt_count integer [not null, note: 'Wrong codes typed against this code; starts at 0. At 5 the code is dead and the person must ask for a new one (which counts against the send limit again), so a 6-digit code cannot be guessed. @vi Số lần nhập sai đối với mã này; bắt đầu từ 0. Tới 5 lần thì mã hết hiệu lực và người dùng phải xin mã mới (lại tính vào giới hạn gửi), nên không thể dò ra mã 6 chữ số. @example 0']
  used_at timestamptz [note: 'When the code was used; NULL while unused. A code works only once. @vi Thời điểm mã được dùng; NULL khi chưa dùng. Mỗi mã chỉ dùng được một lần. @example NULL']
  indexes {
    (phone_number, created_at) [name: 'ix_one_time_codes_phone_time', note: 'Resend cooldown and per-phone rate limit']
  }
  Note: '''@status proposed @owner internal @features F-F1
One-time codes sent by SMS to prove a person holds a phone number: invites,
guest sign-up, password reset and phone changes. Codes are stored only as
hashes, expire quickly, work once, and die after 5 wrong attempts; when
several were sent, only the newest unexpired code for that phone and purpose
is checked. Sending is rate-limited per phone (cooldown and limits are
application rules) to stop SMS-pumping fraud. A short-lived working table: a
row is deleted 1 day after it expires (the send limit looks back at most 24
hours); the permanent record of what happened is in access_audit_logs.
@vi-name Mã dùng một lần
@vi Mã dùng một lần gửi qua SMS để chứng minh một người giữ số điện thoại: lời mời, khách vãng lai đăng ký, đặt lại mật khẩu và đổi số điện thoại. Mã chỉ được lưu dạng băm, hết hạn nhanh, chỉ dùng một lần, và hết hiệu lực sau 5 lần nhập sai; khi đã gửi nhiều mã, chỉ mã mới nhất còn hạn của số điện thoại và mục đích đó được kiểm tra. Việc gửi mã bị giới hạn theo số điện thoại (thời gian chờ và giới hạn là quy tắc của ứng dụng) để chống gian lận bơm SMS. Đây là bảng làm việc ngắn hạn: mỗi dòng bị xóa 1 ngày sau khi hết hạn (giới hạn gửi chỉ xét tối đa 24 giờ trước); bản ghi lâu dài về những gì đã xảy ra nằm ở access_audit_logs.'''
}

Table user_consents {
  user_consent_id uuid [pk, note: 'Internal ID of the acceptance record. @vi Mã nội bộ của bản ghi chấp thuận. @example 00000021-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  user_id uuid [not null, note: 'Person who accepted (for a company agreement: the person who accepted on its behalf, normally the ORG_ADMIN). @vi Người đã chấp thuận (với thỏa thuận của doanh nghiệp: người chấp thuận thay mặt doanh nghiệp, thường là ORG_ADMIN). @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  organization_id uuid [note: 'Organization on whose behalf the document was accepted (a DATA_PROCESSING_AGREEMENT); NULL for a person\'s own acceptance or acknowledgement. @vi Tổ chức mà văn bản được chấp thuận thay mặt (DATA_PROCESSING_AGREEMENT); NULL khi là chấp thuận hoặc xác nhận của chính cá nhân. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  legal_document_id uuid [not null, note: 'The exact version of the legal text that was accepted; its purpose and version come from legal_documents. @vi Đúng phiên bản văn bản pháp lý đã được chấp thuận; mục đích và phiên bản lấy từ legal_documents. @example 00000025-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  ip_address inet [note: 'IP address the acceptance came from, as proof. @vi Địa chỉ IP gửi chấp thuận, làm bằng chứng. @example 113.161.42.17']
  device_label varchar(100) [note: 'Device and app or browser used, copied as text, as proof (app vs portal is visible here). @vi Thiết bị và app hoặc trình duyệt đã dùng, chép lại dạng chuỗi, làm bằng chứng (nhìn vào đây biết là app hay portal). @example Samsung SM-A546E · Android 13 · G3Driver 1.4.2']
  accepted_at timestamptz [not null, note: 'When it was accepted. @vi Thời điểm chấp thuận. @example 2026-09-01T02:00:00Z']
  indexes {
    (user_id, legal_document_id) [unique, name: 'uq_user_consents_person_legal_document', note: 'WHERE organization_id IS NULL: a person accepts a version once']
    (organization_id, legal_document_id) [unique, name: 'uq_user_consents_organization_legal_document', note: 'WHERE organization_id IS NOT NULL: an organization accepts a version once']
  }
  Note: '''@status proposed @owner internal @features F-F1
Proof of who accepted which version of which legal text, when and from where
(Decree 13/2023, Law 91/2025/QH15). Three levels: a company accepts the data
processing agreement on its own behalf (it is responsible for its drivers'
data, we process it for them); an employed driver acknowledges the privacy
notice (no consent, so nothing to withdraw: an objection goes to the
employer); an individual customer accepts the terms, the privacy policy and
location tracking themselves. Accepting the required texts is a condition of
use: withdrawing them means leaving the service, recorded on the account
(status, status_reason), not here. Append-only: a row is written once and
never changed or deleted. Marketing consent is added when marketing exists.
@vi-name Chấp thuận văn bản pháp lý
@vi Bằng chứng ai đã chấp thuận phiên bản nào của văn bản pháp lý nào, khi nào và từ đâu (Nghị định 13/2023, Luật 91/2025/QH15). Ba cấp: doanh nghiệp chấp thuận thỏa thuận xử lý dữ liệu thay mặt chính mình (doanh nghiệp chịu trách nhiệm về dữ liệu tài xế của mình, chúng ta xử lý thay họ); tài xế là nhân viên xác nhận đã đọc thông báo quyền riêng tư (không phải đồng ý, nên không có gì để rút lại: phản đối thì gửi tới doanh nghiệp); khách hàng cá nhân tự chấp thuận điều khoản, chính sách quyền riêng tư và theo dõi vị trí. Chấp thuận các văn bản bắt buộc là điều kiện sử dụng: rút lại nghĩa là ngừng sử dụng dịch vụ, được ghi trên tài khoản (status, status_reason), không ghi ở đây. Chỉ ghi thêm: mỗi dòng ghi một lần, không bao giờ sửa hay xóa. Đồng ý nhận tin tiếp thị sẽ bổ sung khi có tính năng tiếp thị.'''
}

Table legal_documents {
  legal_document_id uuid [pk, note: 'Internal ID of one version of a legal text. @vi Mã nội bộ của một phiên bản văn bản pháp lý. @example 00000025-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  purpose varchar(30) [not null, note: 'Which text it is and who accepts it. TERMS_OF_SERVICE, PRIVACY_POLICY: every user. DATA_PROCESSING_AGREEMENT: a company, on its own behalf. PRIVACY_NOTICE: an employed driver acknowledges it. LOCATION_TRACKING: an individual customer consents to it. Values: TERMS_OF_SERVICE | PRIVACY_POLICY | DATA_PROCESSING_AGREEMENT | PRIVACY_NOTICE | LOCATION_TRACKING. @vi Văn bản nào và ai chấp thuận. TERMS_OF_SERVICE, PRIVACY_POLICY: mọi người dùng. DATA_PROCESSING_AGREEMENT: doanh nghiệp, thay mặt chính mình. PRIVACY_NOTICE: tài xế là nhân viên xác nhận đã đọc. LOCATION_TRACKING: khách hàng cá nhân đồng ý. Giá trị: TERMS_OF_SERVICE | PRIVACY_POLICY | DATA_PROCESSING_AGREEMENT | PRIVACY_NOTICE | LOCATION_TRACKING. @example PRIVACY_POLICY']
  version varchar(20) [not null, note: 'Version label, unique per purpose. @vi Nhãn phiên bản, không trùng trong cùng mục đích. @example 2026.10']
  title varchar(200) [not null, note: 'Title shown to the person. @vi Tiêu đề hiển thị cho người dùng. @example Chính sách quyền riêng tư G3 Network']
  content text [not null, note: 'The full text exactly as shown, in Vietnamese, final as approved by the legal adviser (drafting happens outside the system). Never changed: a change is a new version. @vi Toàn văn đúng như hiển thị, bằng tiếng Việt, là bản cuối đã được luật sư duyệt (việc soạn thảo diễn ra bên ngoài hệ thống). Không bao giờ sửa: thay đổi là một phiên bản mới. @example (toàn văn)']
  created_by uuid [not null, note: 'Our HEAD_ADMIN or CO_ADMIN who published this version (only they may). @vi HEAD_ADMIN hoặc CO_ADMIN của chúng ta đã công bố phiên bản này (chỉ họ được phép). @example 0000001f-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  created_at timestamptz [not null, note: 'When this version was published and took effect: adding the row is publishing it. The newest version of a purpose is the current one; publishing asks everyone concerned to accept again before they continue. @vi Thời điểm phiên bản này được công bố và có hiệu lực: thêm dòng chính là công bố. Phiên bản mới nhất của một mục đích là phiên bản hiện hành; khi công bố, mọi người liên quan phải chấp thuận lại trước khi tiếp tục. @example 2026-10-01T00:00:00Z']
  indexes {
    (purpose, version) [unique, name: 'uq_legal_documents_purpose_version']
  }
  Note: '''@status proposed @owner internal @features F-F1
Every version of every legal text a person or a company accepts, so we can
always show exactly what was accepted, and know which version is current.
Only final texts are stored: adding a row publishes it, and a row is never
edited or deleted. Vietnamese only for now (a language column comes with the
first other language).
@vi-name Văn bản pháp lý
@vi Mọi phiên bản của mọi văn bản pháp lý mà cá nhân hoặc doanh nghiệp chấp thuận, để luôn chỉ ra được chính xác nội dung đã chấp thuận, và biết phiên bản nào đang hiện hành. Chỉ lưu bản cuối: thêm một dòng là công bố, và không bao giờ sửa hay xóa dòng. Hiện chỉ có tiếng Việt (cột ngôn ngữ được bổ sung khi có ngôn ngữ thứ hai).'''
}

Table user_role_assignments {
  user_role_assignment_id uuid [pk, note: 'Internal ID of the assignment. @vi Mã nội bộ của lần gán vai trò. @example 00000001-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  organization_id uuid [not null, note: 'Organization of the membership, copied here only because the one-ORG_ADMIN unique index needs it on the same row (the one exception to DM-24). The database guarantees it is the membership\'s own organization: a two-column foreign key (membership_id, organization_id) → memberships (membership_id, organization_id) refuses any mismatch. @vi Tổ chức của thành viên, được ghi thêm ở đây để mọi truy vấn lọc theo tổ chức theo cùng một cách (quy tắc cột tổ chức) và để kiểm tra chỉ mục một ORG_ADMIN. Cơ sở dữ liệu đảm bảo đây đúng là tổ chức của thành viên: khóa ngoại hai cột (membership_id, organization_id) → memberships (membership_id, organization_id) từ chối mọi trường hợp không khớp. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  membership_id uuid [not null, note: 'The membership (person in this organization) that holds the role. @vi Thành viên (người trong tổ chức này) giữ vai trò. @example 00000022-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  role varchar(30) [not null, note: 'The job title the role grants: a bundle of features, the same list for every organization. Data reach comes from the organization (is_internal), not from the role; for a customer the features are the role bundle limited by its plan, for an internal user the whole role bundle (internal-only features such as issuing invoices are never put in any plan). Titles: HEAD_ADMIN (full permissions on everything, internal only), CO_ADMIN (daily administration, internal only, cannot manage admins or is_internal), ORG_ADMIN (manages its own organization users and roles), SALES, ACCOUNTANT, CUSTOMER_CARE, OPERATIONS, MAINTENANCE, WARRANTY, FLEET_MANAGER, DISPATCHER, DRIVER (requires an active driver profile in the organization), TECHNICIAN. A fixed list in code (an enum), not a table. @vi Chức danh mà vai trò cấp: một nhóm tính năng, cùng một danh sách cho mọi tổ chức. Phạm vi dữ liệu đến từ tổ chức (is_internal), không từ vai trò; với khách hàng, tính năng là nhóm tính năng của vai trò giới hạn bởi gói dịch vụ, với người dùng nội bộ là toàn bộ nhóm tính năng của vai trò (tính năng chỉ dành cho nội bộ như xuất hóa đơn không bao giờ nằm trong gói nào). Chức danh: HEAD_ADMIN (toàn quyền, chỉ nội bộ), CO_ADMIN (quản trị hằng ngày, chỉ nội bộ, không quản lý quản trị viên hay is_internal), ORG_ADMIN (quản lý người dùng và vai trò của chính tổ chức mình), SALES, ACCOUNTANT, CUSTOMER_CARE, OPERATIONS, MAINTENANCE, WARRANTY, FLEET_MANAGER, DISPATCHER, DRIVER (cần hồ sơ tài xế còn hiệu lực trong tổ chức), TECHNICIAN. Danh sách cố định trong mã nguồn (enum), không phải bảng. @example FLEET_MANAGER']
  granted_at timestamptz [not null, note: 'When the role was granted. @vi Thời điểm cấp vai trò. @example 2026-09-01T02:00:00Z']
  granted_by uuid [note: 'Who granted the role (an ORG_ADMIN, our sales/admin); NULL when granted by the system (e.g. ORG_ADMIN and DRIVER of a guest\'s own personal organization at sign-up). @vi Ai đã cấp vai trò (ORG_ADMIN, nhân viên kinh doanh/quản trị của chúng ta); NULL khi hệ thống tự cấp (ví dụ ORG_ADMIN và DRIVER của tổ chức cá nhân khi khách tự đăng ký). @example 0000001f-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  revoked_at timestamptz [note: 'When the role was revoked; NULL while still held. @vi Thời điểm thu hồi vai trò; NULL khi vẫn đang giữ. @example NULL']
  revoked_by uuid [note: 'Who revoked the role; NULL while held, or when the system revoked it (e.g. because the membership ended). @vi Ai đã thu hồi vai trò; NULL khi vẫn đang giữ, hoặc khi hệ thống tự thu hồi (ví dụ vì thành viên đã rời tổ chức). @example NULL']
  indexes {
    (membership_id, role) [unique, name: 'uq_user_role_assignments_active_role', note: 'WHERE revoked_at IS NULL']
    organization_id [unique, name: 'uq_user_role_assignments_one_org_admin', note: 'WHERE role = ORG_ADMIN AND revoked_at IS NULL: exactly one organization administrator; a handover grants the new one and revokes the old one in one transaction']
  }
  Note: '''@status planned @owner customer @features F-F1
Which roles a person holds in one organization (through their membership); they can hold several at once (e.g. a director
who is also the fleet manager). Each organization has exactly one active ORG_ADMIN
(owner decision, 2026-10-04): it is handed over, never shared; when the admin
is gone, our CO_ADMIN appoints the next one. Enforced by the database (unique
index); a handover grants the new one and revokes the old one in one
transaction. Other rules: ending a membership
revokes all its roles in the same transaction; HEAD_ADMIN and CO_ADMIN only
in an internal organization; DRIVER requires an active driver profile with a
valid licence; TECHNICIAN is for partner organizations. A role is a bundle of
feature permissions only. Kept as history: a revoked role keeps its
row with revoked_at set.
@vi-name Gán vai trò
@vi Một người giữ những vai trò nào trong một tổ chức (qua thành viên); một người có thể giữ nhiều vai trò cùng lúc (ví dụ giám đốc kiêm quản lý đội xe). Mỗi tổ chức có đúng một ORG_ADMIN đang hoạt động (quyết định ngày 04/10/2026): vai trò này được chuyển giao, không dùng chung; khi quản trị viên không còn, CO_ADMIN của chúng ta chỉ định người mới. Cơ sở dữ liệu đảm bảo quy tắc này (chỉ mục duy nhất); việc chuyển giao cấp vai trò cho người mới và thu hồi của người cũ trong cùng một giao dịch. Quy tắc khác: thành viên rời tổ chức thì mọi vai trò của họ bị thu hồi trong cùng giao dịch; HEAD_ADMIN và CO_ADMIN chỉ có ở tổ chức nội bộ; DRIVER cần hồ sơ tài xế còn hiệu lực với bằng lái hợp lệ; TECHNICIAN dành cho tổ chức đối tác. Vai trò chỉ là nhóm quyền dùng tính năng. Có lưu lịch sử: vai trò bị thu hồi vẫn giữ dòng, với revoked_at được điền.'''
}

Table access_audit_logs {
  access_audit_log_id bigint [pk, increment, note: 'Auto-increasing ID of the audit entry. @vi Mã tự tăng của dòng nhật ký. @example 1048576']
  occurred_at timestamptz [pk, note: 'When the access happened; hypertable time column. @vi Thời điểm truy cập; cột thời gian của bảng chuỗi thời gian. @example 2026-09-15T08:30:00Z']
  user_id uuid [note: 'Who accessed the data, or whose account the security event is about. NULL only for a failed login with a phone number that matches no account. @vi Ai đã truy cập dữ liệu, hoặc tài khoản mà sự kiện bảo mật liên quan. Chỉ NULL khi đăng nhập thất bại với số điện thoại không thuộc tài khoản nào. @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  organization_id uuid [note: 'Organization whose data was accessed. @vi Dữ liệu của tổ chức nào bị truy cập. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  action varchar(30) [not null, note: 'What happened. Two families. Actions on data: VIEW (one entry when a screen showing personal or location data is opened, not one per refresh) | EXPORT. Events on a user account (resource_type USER_ACCOUNT): LOGIN_SUCCESS | LOGIN_FAILED | LOGIN_LOCKED | LOGOUT | PASSWORD_CHANGED | PHONE_CHANGED. @vi Việc đã xảy ra. Gồm hai nhóm. Thao tác trên dữ liệu: VIEW (ghi một dòng khi mở màn hình có dữ liệu cá nhân hoặc vị trí, không ghi mỗi lần làm mới) | EXPORT. Sự kiện trên tài khoản người dùng (resource_type USER_ACCOUNT): LOGIN_SUCCESS | LOGIN_FAILED | LOGIN_LOCKED | LOGOUT | PASSWORD_CHANGED | PHONE_CHANGED. @example VIEW']
  resource_type varchar(50) [not null, note: 'Kind of data accessed; USER_ACCOUNT for account security events. @vi Loại dữ liệu bị truy cập; USER_ACCOUNT với sự kiện bảo mật tài khoản. @example VEHICLE_LOCATION_HISTORY']
  resource_id varchar(100) [note: 'ID of the record accessed, as text. @vi Mã của bản ghi bị truy cập (dạng chuỗi). @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  details jsonb [note: 'Facts specific to the action, as JSON; NULL when there are none. Keys per action: EXPORT {"reason": text, required}; LOGIN_FAILED {"failure": "WRONG_PASSWORD" | "UNKNOWN_PHONE" | "ACCOUNT_LOCKED"}; LOGIN_LOCKED {"locked_minutes": number}. A new key is added here when an action needs one, never as a new column. @vi Thông tin riêng của từng thao tác, dạng JSON; NULL khi không có. Khóa theo thao tác: EXPORT {"reason": chuỗi, bắt buộc}; LOGIN_FAILED {"failure": "WRONG_PASSWORD" | "UNKNOWN_PHONE" | "ACCOUNT_LOCKED"}; LOGIN_LOCKED {"locked_minutes": số}. Khóa mới được bổ sung tại đây khi một thao tác cần, không thêm cột mới. @example {"reason": "Ticket #1234 – hồ sơ bồi thường tai nạn"}']
  ip_address inet [note: 'IP address the request came from; NULL for actions run by the system. @vi Địa chỉ IP gửi yêu cầu; NULL với thao tác do hệ thống tự chạy. @example 113.161.42.17']
  user_agent varchar(255) [note: 'Device and app as reported by the client at that moment, copied as text (not a link to user_sessions, whose rows are removed at logout, because an audit row never changes). Used for login history and new-device alerts. @vi Thiết bị và ứng dụng do client báo tại thời điểm đó, chép lại dạng chuỗi (không liên kết tới user_sessions, vì các dòng ở đó bị xóa khi đăng xuất, còn dòng nhật ký không bao giờ thay đổi). Dùng cho lịch sử đăng nhập và cảnh báo thiết bị mới. @example G3Driver/1.4.2 (Android 13; SM-A546E)']
  Note: '''@status planned @owner internal @features F-F1 @hypertable occurred_at
Append-only record of every access to personal/location data (NF-08) and of
account security events (logins, failed logins, lockouts, logouts, password
and phone changes): who, what, when, from which IP and device, and action-specific
facts in details (e.g. why for an export). A data view is logged once per screen opened, not per refresh.
Changes to personal data are not logged here: the history tables already
record them with who changed them. Kept forever (never deleted); older months
are compressed.
@vi-name Nhật ký truy cập & bảo mật
@vi Nhật ký chỉ-ghi-thêm cho mọi lượt truy cập dữ liệu cá nhân/vị trí (NF-08) và các sự kiện bảo mật tài khoản (đăng nhập, đăng nhập sai, bị khóa tạm, đăng xuất, đổi mật khẩu, đổi số điện thoại): ai, làm gì, khi nào, từ IP và thiết bị nào, và thông tin riêng của từng thao tác trong details (ví dụ lý do trích xuất). Việc xem dữ liệu được ghi một lần mỗi lần mở màn hình, không ghi mỗi lần làm mới. Thay đổi dữ liệu cá nhân không ghi ở đây: các bảng lịch sử đã ghi lại kèm người thay đổi. Lưu vĩnh viễn (không bao giờ xóa); các tháng cũ được nén.'''
}

Table organization_settings {
  organization_id uuid [pk, note: 'The organization these settings belong to (1:1 with organizations). @vi Tổ chức sở hữu các thiết lập này (1:1 với organizations). @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  telemetry_interval_seconds integer [not null, note: 'How often the T-Boxes on this organization\'s trucks send telemetry, in seconds (TX-09); default 10, within the backend\'s allowed bounds. Pushed to every device on its trucks when changed, and to a device when it is mounted. @vi Chu kỳ T-Box trên các xe của tổ chức gửi dữ liệu (giây) (TX-09); mặc định 10, trong giới hạn backend cho phép. Được đẩy xuống mọi thiết bị trên xe của tổ chức khi thay đổi, và xuống thiết bị khi được gắn lên xe. @example 10']
  driving_session_auto_end_minutes integer [not null, note: 'A driving session ends on its own once the truck has not moved for this long (DR-07); default 120. @vi Phiên lái tự kết thúc khi xe không di chuyển trong khoảng thời gian này (DR-07); mặc định 120. @example 120']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When a setting was last changed (UTC). @vi Thời điểm thiết lập được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  Note: '''@status proposed @owner customer @features F-F1,F-E4 @tracked *
Settings an organization chooses for itself (ID-45): one row per
organization, created with default values together with it, one typed column
per setting. A new setting is a new column with a default. Change history on,
since a setting is a decision. There is no user or fleet settings table until
a real setting needs one.
@vi-name Thiết lập tổ chức
@vi Các thiết lập do tổ chức tự chọn (ID-45): mỗi tổ chức một dòng, tạo kèm giá trị mặc định cùng lúc với tổ chức, mỗi thiết lập một cột có kiểu riêng. Thiết lập mới là một cột mới có giá trị mặc định. Có lưu lịch sử thay đổi vì thiết lập là một quyết định. Chưa có bảng thiết lập cho người dùng hay đội xe cho tới khi có thiết lập thật sự cần.'''
}

Ref: user_state.user_id - users.user_id [delete: restrict]
Ref: user_credentials.user_id > users.user_id [delete: restrict]
Ref: user_sessions.user_id > users.user_id [delete: restrict]
Ref: user_sessions.organization_id > organizations.organization_id [delete: restrict]
Ref: organizations.account_manager_id > users.user_id [delete: restrict]
Ref: users.created_by > users.user_id [delete: restrict]
Ref: memberships.organization_id > organizations.organization_id [delete: restrict]
Ref: memberships.user_id > users.user_id [delete: restrict]
Ref: memberships.created_by > users.user_id [delete: restrict]
Ref: user_state.last_organization_id > organizations.organization_id [delete: restrict]
Ref: one_time_codes.user_id > users.user_id [delete: restrict]
Ref: one_time_codes.issued_by > users.user_id [delete: restrict]
Ref: user_consents.user_id > users.user_id [delete: restrict]
Ref: user_consents.organization_id > organizations.organization_id [delete: restrict]
Ref: user_consents.legal_document_id > legal_documents.legal_document_id [delete: restrict]
Ref: legal_documents.created_by > users.user_id [delete: restrict]
Ref: user_role_assignments.organization_id > organizations.organization_id [delete: restrict]
Ref: user_role_assignments.membership_id > memberships.membership_id [delete: restrict]
Ref: user_role_assignments.granted_by > users.user_id [delete: restrict]
Ref: user_role_assignments.revoked_by > users.user_id [delete: restrict]
Ref: access_audit_logs.user_id > users.user_id [delete: restrict]
Ref: access_audit_logs.organization_id > organizations.organization_id [delete: restrict]
Ref: organization_settings.organization_id - organizations.organization_id [delete: restrict]

TableGroup identity {
  organizations
  users
  user_state
  memberships
  user_credentials
  user_sessions
  one_time_codes
  user_consents
  legal_documents
  user_role_assignments
  access_audit_logs
  organization_settings
  Note: '''
Who takes part in the platform, who can log in, and what each person may do.
This is the foundational domain: every other domain may depend on it, and it
depends on none of them. Not built yet.

- An **organization** is a customer (a transport company or an individual owner-driver), our own internal organization (`is_internal`), or a repair/rescue partner (has a `repair_partners` profile). Any of them can own vehicles and drivers; only `is_internal` changes access: internal users see across organizations, everyone else only their own.
- A **user** is one person with one account. Through **memberships** a person can belong to several organizations at once (e.g. their personal organization and the company that hired them); after login they pick the organization to act for. Our own staff are members of an internal organization. Job profiles (e.g. the driver profile) point to a membership, never the other way, so identity depends on no other domain.
- A user holds one or more **roles** (job titles) from a fixed list, kept as history. Roles are permissions only; facts about a job live in a **profile** (e.g. the driver profile), and a role that needs one (DRIVER) requires it to be active.
- **Everyone who uses or receives anything from the system is a user.** A message type belongs to a service (a feature): a user receives it when the service is in one of their roles and in their organization's plan (e.g. e-invoices for ACCOUNTANT, operational alerts for FLEET_MANAGER/DISPATCHER). It then goes to every channel - the app, the fleet portal and e-mail (when an address is on file); otherwise nothing is sent. Marketing messages come later; their consent is designed with them.
- Every access to personal or location data writes an **audit log** entry.

@vi-name Danh tính & phân quyền
@vi Ai tham gia nền tảng, ai được đăng nhập và mỗi người được làm gì. Đây là miền nền tảng: mọi miền khác có thể phụ thuộc vào nó, còn nó không phụ thuộc miền nào.
- Một **tổ chức** là khách hàng (doanh nghiệp vận tải hoặc chủ xe cá nhân tự lái), tổ chức nội bộ của chính chúng ta (`is_internal`), hoặc đối tác sửa chữa/cứu hộ (có hồ sơ `repair_partners`). Tổ chức nào cũng có thể sở hữu xe và tài xế; chỉ `is_internal` thay đổi quyền truy cập: người dùng nội bộ xem được mọi tổ chức, còn lại chỉ xem tổ chức của mình.
- Một **người dùng** là một người với một tài khoản. Qua **thành viên tổ chức**, một người có thể thuộc nhiều tổ chức cùng lúc (ví dụ tổ chức cá nhân và công ty đã tuyển họ); sau khi đăng nhập họ chọn tổ chức để làm việc. Nhân viên của chúng ta là thành viên của một tổ chức nội bộ. Hồ sơ tài xế trỏ tới người dùng của mình, không có chiều ngược lại.
- Người dùng giữ một hoặc nhiều **vai trò** (chức danh) trong danh sách cố định, có lưu lịch sử. Vai trò chỉ là quyền; thông tin về một công việc nằm ở **hồ sơ** (ví dụ hồ sơ tài xế), và vai trò cần hồ sơ (DRIVER) đòi hỏi hồ sơ đó còn hiệu lực.
- **Mọi người sử dụng hoặc nhận bất cứ thứ gì từ hệ thống đều là người dùng.** Mỗi loại thông tin thuộc một dịch vụ (một tính năng): người dùng nhận được khi dịch vụ đó nằm trong một vai trò của họ và trong gói của tổ chức (ví dụ hóa đơn điện tử cho ACCOUNTANT, cảnh báo vận hành cho FLEET_MANAGER/DISPATCHER). Khi đó thông tin được gửi tới mọi kênh - app, fleet portal và email (khi có địa chỉ); nếu không thì không gửi gì. Thông tin tiếp thị sẽ có sau; sự đồng ý nhận tin tiếp thị được thiết kế cùng lúc đó.
- Mọi lượt truy cập dữ liệu cá nhân hoặc vị trí đều ghi một dòng **nhật ký kiểm toán**.
'''
}

// ===========================================================================
// vehicles: vehicle profile and provisioning (F-F2)
// ===========================================================================

Table vehicles {
  vehicle_id uuid [pk, note: 'Internal ID of the vehicle. @vi Mã nội bộ của xe. @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  organization_id uuid [not null, note: '@planned VH-07: Organization that owns the vehicle now; changes when ownership is transferred. Earlier owners are in vehicle_history; the ownership periods come from the view vehicle_ownership_periods (VH-10). @vi Tổ chức đang sở hữu xe; đổi khi chuyển quyền sở hữu. Các chủ trước nằm trong vehicle_history; các giai đoạn sở hữu lấy từ view vehicle_ownership_periods (VH-10). @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  acquired_at timestamptz [not null, note: '@planned VH-10: When the current owner took the truck (handover date, effective date of a transfer). A period ends at the next owner\'s acquired_at. The first owner\'s value is the truck\'s handover date. @vi Thời điểm chủ hiện tại nhận xe (ngày bàn giao, ngày hiệu lực của lần chuyển quyền). Một giai đoạn kết thúc tại acquired_at của chủ kế tiếp. Giá trị của chủ đầu tiên là ngày bàn giao xe. @example 2026-06-01T00:00:00Z']
  license_plate varchar(20) [not null, note: 'Registration plate. A truck is registered in the system only once it has a plate. Editable: Vietnamese plates follow the owner (Circular 24/2023/TT-BCA), so a transferred truck gets a new plate and an old plate can reappear on another truck; the change history keeps earlier plates. Unique among vehicles not deleted, so the plate of a truck that left can move to another truck. @vi Biển số đăng ký. Xe chỉ được đăng ký vào hệ thống khi đã có biển số. Sửa được: biển số định danh theo chủ xe (Thông tư 24/2023/TT-BCA), nên xe sang tên sẽ có biển mới và biển cũ có thể xuất hiện lại trên xe khác; lịch sử thay đổi lưu các biển trước đó. Duy nhất trong các xe chưa xóa, nên biển số của xe đã rời hệ thống có thể chuyển sang xe khác. @example 51D-123.45']
  vin varchar(17) [not null, note: '17-character chassis number (VIN); the vehicle\'s business key. Editable so a typing mistake can be corrected (the app warns the user to check it before saving); the change history keeps earlier values. Other tables point to vehicle_id, never to the VIN. Unique among vehicles not deleted. @vi Số khung (VIN) 17 ký tự; là khóa nghiệp vụ của xe. Sửa được để sửa lỗi nhập (ứng dụng nhắc người dùng kiểm tra trước khi lưu); lịch sử thay đổi lưu các giá trị trước. Các bảng khác trỏ tới vehicle_id, không bao giờ tới VIN. Duy nhất trong các xe chưa xóa. @example LZGJLGR4XNX000123']
  vehicle_model_id uuid [not null, note: '@planned VH-15: The truck\'s model, with its specifications. @vi Dòng xe của xe, kèm thông số kỹ thuật. @example 5d1e8a3c-2b4f-4c6d-9e7a-1f0b3c5d7e99']
  make varchar(50) [not null, note: '@remove VH-15: Manufacturer; now vehicle_models.make. @vi Hãng sản xuất; nay là vehicle_models.make. @example Tri-Ring']
  model varchar(50) [not null, note: '@remove VH-15: Model line; now vehicle_models.model_name. @vi Dòng xe; nay là vehicle_models.model_name. @example EVT-400']
  year integer [not null, note: 'Manufacturing year. @vi Năm sản xuất. @example 2025']
  status vehiclestatus [not null, note: 'Service status, set by a person or by a business rule acting for the company (DM-25). ACTIVE: in service. INACTIVE: not in service, e.g. in the workshop or not used by its owner; the reason says which (once repair records exist, being in maintenance is read from an open repair record). A truck that leaves the system is INACTIVE and soft-deleted. Whether it is moving or sending data is computed from telemetry, not stored. @vi Trạng thái phục vụ, do con người hoặc quy tắc nghiệp vụ thay mặt công ty đặt (DM-25). ACTIVE: đang phục vụ. INACTIVE: không phục vụ, ví dụ đang ở xưởng hoặc chủ xe không dùng; lý do cho biết trường hợp nào (khi có hồ sơ sửa chữa, việc đang bảo dưỡng được đọc từ hồ sơ sửa chữa đang mở). Xe rời hệ thống được chuyển sang INACTIVE và xóa mềm. Xe đang chạy hay gửi dữ liệu được tính từ dữ liệu vận hành, không lưu. @example ACTIVE']
  status_reason varchar(200) [note: '@planned DM-19: Why the vehicle is in its current status, or why it left the system; NULL when ACTIVE. @vi Lý do của trạng thái hiện tại, hoặc lý do xe rời hệ thống; NULL khi ACTIVE. @example Brake system repair at the Binh Duong workshop']
  activation_status vehicleactivationstatus [not null, note: '@remove VH-06: Progress through device provisioning, a one-way ladder that never noticed a removed T-Box. Activation is computed instead: device fitted now from telematics, data received from telemetry. @vi Tiến độ kích hoạt thiết bị, thang một chiều không phản ánh việc T-Box bị tháo. Thay bằng tính toán: có thiết bị hiện tại từ telematics, đã nhận dữ liệu từ telemetry. @example ACTIVATED']
  battery_capacity_kwh float8 [note: '@remove VH-16: Nominal usable pack capacity in kWh, not adjusted for SOH; NULL if unknown (reports fall back to a default). Replaced by the installed battery\'s design capacity, or the model\'s nominal capacity when no battery is recorded. @vi Dung lượng pin danh định có thể dùng (kWh), chưa trừ suy giảm SOH; NULL nếu chưa biết (báo cáo sẽ dùng giá trị mặc định). Thay bằng dung lượng thiết kế của pin đang lắp, hoặc dung lượng danh định của dòng xe khi chưa ghi nhận pin. @example 282.0']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the row is no longer part of the system, because it left or was entered by mistake (DM-25); all its data is kept, and the reason is in status_reason. NULL while it is part of the system. @vi Thời điểm xóa mềm: bản ghi không còn thuộc hệ thống, do đã rời đi hoặc nhập nhầm (DM-25); mọi dữ liệu vẫn được giữ, lý do nằm trong status_reason. NULL khi còn thuộc hệ thống. @example NULL']
  indexes {
    vin [unique, name: 'uq_vehicles_live_vin', note: 'Planned (VH-07), replaces the full unique constraint: WHERE deleted_at IS NULL']
    license_plate [unique, name: 'uq_vehicles_live_license_plate', note: 'Planned (VH-07), replaces the full unique constraint: WHERE deleted_at IS NULL']
    status [name: 'ix_vehicles_status']
  }
  Note: '''@status built @owner customer @features F-F2,F-A6 @tracked *
Profile of one electric truck: what it is and the decisions about it. It has
no state table: everything the truck reports comes through its T-Box and is
kept message by message in telemetry.
Check constraint: deleted_at IS NULL OR status = 'INACTIVE' (DM-25).
@vi-name Xe
@vi Hồ sơ của một xe tải điện: xe là gì và các quyết định về xe. Không có bảng trạng thái: mọi thứ xe báo về đi qua T-Box và được lưu từng bản tin trong telemetry. Ràng buộc kiểm tra: deleted_at IS NULL OR status = 'INACTIVE' (DM-25).'''
}

Table vehicle_models {
  vehicle_model_id uuid [pk, note: 'Internal ID of the truck model. @vi Mã nội bộ của dòng xe. @example 5d1e8a3c-2b4f-4c6d-9e7a-1f0b3c5d7e99']
  make varchar(50) [not null, note: 'Manufacturer. @vi Hãng sản xuất. @example Tri-Ring']
  model_name varchar(50) [not null, note: 'Model line, unique per manufacturer. @vi Tên dòng xe, duy nhất theo hãng. @example EVT-400']
  gross_vehicle_weight_kg integer [note: 'Gross vehicle weight in kg; NULL until known. @vi Tổng trọng lượng xe (kg); NULL khi chưa biết. @example 40000']
  max_payload_kg integer [note: 'Maximum payload in kg; the load of the consumption curve is a share of it. NULL until known. @vi Tải trọng tối đa (kg); tải trong đường cong tiêu thụ tính theo phần trăm của giá trị này. NULL khi chưa biết. @example 30000']
  nominal_battery_capacity_kwh numeric(7,1) [note: 'Battery capacity the model is delivered with, in kWh; used when a truck\'s own battery is unknown. A plain number, not a link to battery_models, so vehicles never depends on batteries. NULL until known. @vi Dung lượng pin dòng xe được giao kèm (kWh); dùng khi chưa biết pin của từng xe. Là số, không liên kết tới battery_models, để miền xe không phụ thuộc miền pin. NULL khi chưa biết. @example 282.0']
  consumption_curve jsonb [note: 'Reference energy consumption by load, a list of points [{"load_percent": 0-100, "kwh_per_km": number}], used by forecasts and empty-trip detection. NULL until known. @vi Mức tiêu thụ năng lượng tham chiếu theo tải, danh sách các điểm [{"load_percent": 0-100, "kwh_per_km": số}], dùng cho dự báo và phát hiện chạy rỗng. NULL khi chưa biết. @example [{"load_percent": 0, "kwh_per_km": 0.9}, {"load_percent": 100, "kwh_per_km": 1.6}]']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the model is no longer offered, or was entered by mistake (DM-25); rows already pointing to it keep it. NULL while offered. @vi Thời điểm xóa mềm: dòng này không còn được cung cấp, hoặc nhập nhầm (DM-25); các bản ghi đã trỏ tới vẫn giữ. NULL khi còn cung cấp. @example NULL']
  indexes {
    (make, model_name) [unique, name: 'uq_vehicle_models_live_make_model', note: 'WHERE deleted_at IS NULL']
  }
  Note: '''@status planned @owner internal @features F-F2 @tracked *
Catalog of truck models and their specifications (VEH-03, VH-15), shared by
every organization and maintained by our operations team. Figures are entered only once confirmed and
may be updated later (the history keeps earlier values). Electric only: no
diesel figures here (the diesel baseline for carbon reports is its own
feature). All current models are tractor heads; a body type column is added
when another type arrives. Change history on: reports depend on these
figures.
@vi-name Dòng xe
@vi Danh mục dòng xe và thông số kỹ thuật (VEH-03, VH-15), dùng chung cho mọi tổ chức, do bộ phận vận hành của chúng ta quản lý. Số liệu chỉ được nhập khi đã xác nhận và có thể cập nhật sau (lịch sử lưu các giá trị trước). Chỉ xe điện: không có số liệu diesel (đường cơ sở diesel cho báo cáo carbon là tính năng riêng). Mọi dòng xe hiện tại đều là đầu kéo; cột loại thân xe sẽ được thêm khi có loại khác. Có lưu lịch sử thay đổi vì báo cáo dựa vào các số liệu này.'''
}

Ref: vehicles.organization_id > organizations.organization_id [delete: restrict]
Ref: vehicles.vehicle_model_id > vehicle_models.vehicle_model_id [delete: restrict]

TableGroup vehicles {
  vehicles
  vehicle_models
  Note: '''
The truck itself: identity (VIN, plate), specs, and provisioning state.

- A **vehicle** belongs to one organization at a time (`organization_id`, `acquired_at`); earlier owners are in its change history, and the view `vehicle_ownership_periods` lists every period (VH-10).
- **After a sale (VH-11):** rows recorded under the previous owner (telemetry and what is built from it) stay theirs; the truck's condition (health, faults, maintenance, warranties) and lifetime totals (distance, energy, charge cycles) follow the truck.
- **One owner only (owner decision, 2026-10-03):** a truck (and a driver profile) belongs to exactly one organization in the system. When parties cooperate (e.g. an owner-driver operating under a transport company's licence), they agree between themselves and declare the owner to us; their cooperation terms are outside our responsibility and are not modelled.

@vi-name Xe
@vi Bản thân chiếc xe tải: định danh (VIN, biển số), thông số và trạng thái kích hoạt.
- Tại mỗi thời điểm, một **xe** thuộc một tổ chức (`organization_id`, `acquired_at`); các chủ trước nằm trong lịch sử thay đổi của xe, và view `vehicle_ownership_periods` liệt kê mọi giai đoạn sở hữu (VH-10).
- **Sau khi bán xe (VH-11):** dữ liệu ghi nhận dưới chủ cũ (dữ liệu vận hành và những gì tính từ đó) vẫn thuộc chủ cũ; tình trạng xe (sức khỏe, lỗi, bảo dưỡng, bảo hành) và các tổng tích lũy (quãng đường, năng lượng, chu kỳ sạc) đi theo xe.
- **Chỉ một chủ sở hữu (quyết định ngày 03/10/2026):** mỗi xe (và mỗi hồ sơ tài xế) thuộc đúng một tổ chức trong hệ thống. Khi các bên hợp tác (ví dụ chủ xe tự lái hoạt động dưới giấy phép kinh doanh vận tải của một công ty), các bên tự thỏa thuận và khai báo chủ sở hữu cho chúng ta; điều khoản hợp tác của họ nằm ngoài trách nhiệm của chúng ta và không được mô hình hóa.
'''
}

// ===========================================================================
// batteries: each truck battery as an asset (BAT-01)
// ===========================================================================

Table battery_models {
  battery_model_id uuid [pk, note: 'Internal ID of the battery model. @vi Mã nội bộ của dòng pin. @example 2c7f4e1a-9b3d-4a5e-8c6f-0d1e2f3a4b55']
  manufacturer varchar(50) [not null, note: 'Battery maker. @vi Hãng sản xuất pin. @example CATL']
  model_name varchar(50) [not null, note: 'Model name, unique per manufacturer. @vi Tên dòng pin, duy nhất theo hãng. @example LFP-282']
  chemistry varchar(10) [not null, note: 'Cell chemistry. Values: LFP | NMC. @vi Hóa học của cell pin. @example LFP']
  design_capacity_kwh numeric(7,1) [note: 'Energy the pack holds when new, in kWh; NULL until known. @vi Năng lượng pin chứa được khi mới (kWh); NULL khi chưa biết. @example 282.0']
  nominal_voltage_v numeric(6,1) [note: 'Nominal pack voltage in volts; NULL until known. @vi Điện áp danh định của pin (V); NULL khi chưa biết. @example 576.0']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the model is no longer offered, or was entered by mistake (DM-25); rows already pointing to it keep it. NULL while offered. @vi Thời điểm xóa mềm: dòng này không còn được cung cấp, hoặc nhập nhầm (DM-25); các bản ghi đã trỏ tới vẫn giữ. NULL khi còn cung cấp. @example NULL']
  indexes {
    (manufacturer, model_name) [unique, name: 'uq_battery_models_live_manufacturer_model', note: 'WHERE deleted_at IS NULL']
  }
  Note: '''@status proposed @owner internal @features F-F2 @tracked *
Catalog of battery types (BAT-01, VH-13), the battery counterpart of
vehicle_models: shared by every organization, maintained by our operations
team, figures entered only once confirmed and updated later when needed. The
cell/module layout is deferred (deferred.md 87); warranty terms live in
warranties.
@vi-name Dòng pin
@vi Danh mục các loại pin (BAT-01, VH-13), tương ứng với vehicle_models cho pin: dùng chung cho mọi tổ chức, do bộ phận vận hành của chúng ta quản lý, số liệu chỉ được nhập khi đã xác nhận và cập nhật sau khi cần. Sơ đồ cell/module được hoãn lại (deferred.md 87); điều khoản bảo hành nằm trong warranties.'''
}

Table batteries {
  battery_id uuid [pk, note: 'Internal ID of the battery. @vi Mã nội bộ của pin. @example 8e2a6c4f-1d3b-4f7a-9c5e-2b4d6f8a0c11']
  serial_number varchar(50) [not null, note: 'The pack\'s serial number from the manufacturer; unique among batteries not deleted. @vi Số serial của pin do nhà sản xuất cấp; duy nhất trong các pin chưa xóa. @example CATL-LFP282-2025-004512']
  battery_model_id uuid [not null, note: 'The battery\'s model, with its specifications. @vi Dòng pin, kèm thông số kỹ thuật. @example 2c7f4e1a-9b3d-4a5e-8c6f-0d1e2f3a4b55']
  organization_id uuid [not null, note: 'Organization that owns the battery now; may differ from the truck\'s owner (e.g. G3 leasing it, deferred.md 88). Earlier owners are in battery_history; a view is added when a feature first needs them (DM-27). @vi Tổ chức đang sở hữu pin; có thể khác chủ xe (ví dụ G3 cho thuê pin, deferred.md 88). Các chủ trước nằm trong battery_history; view được thêm khi có tính năng đầu tiên cần (DM-27). @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  acquired_at timestamptz [not null, note: 'When the current owner took the battery. @vi Thời điểm chủ hiện tại nhận pin. @example 2026-06-01T00:00:00Z']
  vehicle_id uuid [note: 'Truck the battery is installed in now; NULL when in stock or removed. A truck holds at most one battery. Earlier installations come from the view battery_installation_periods. @vi Xe đang lắp pin; NULL khi pin trong kho hoặc đã tháo. Mỗi xe lắp tối đa một pin. Các lần lắp trước lấy từ view battery_installation_periods. @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  installed_at timestamptz [note: 'When the battery was installed in its current truck; NULL when not installed. @vi Thời điểm pin được lắp vào xe hiện tại; NULL khi chưa lắp. @example 2026-06-01T00:00:00Z']
  manufactured_on date [note: 'Manufacturing date, for age and warranty; NULL until known. @vi Ngày sản xuất, dùng cho tuổi pin và bảo hành; NULL khi chưa biết. @example 2025-11-20']
  status varchar(20) [not null, note: 'Status set by a person (DM-25). ACTIVE: usable. INACTIVE: not usable now, e.g. being repaired or checked; the reason says why. A battery that leaves the system (recycled, sold for second-life use) is INACTIVE and soft-deleted. Installed or in stock is not a status: it is read from vehicle_id. Values: ACTIVE | INACTIVE. @vi Trạng thái do con người đặt (DM-25). ACTIVE: dùng được. INACTIVE: hiện không dùng được, ví dụ đang sửa chữa hoặc kiểm tra; lý do cho biết vì sao. Pin rời hệ thống (tái chế, bán cho mục đích tái sử dụng) được chuyển sang INACTIVE và xóa mềm. Đang lắp hay trong kho không phải trạng thái: đọc từ vehicle_id. @example ACTIVE']
  status_reason varchar(200) [note: 'Why the battery is in its current status; NULL when ACTIVE. @vi Lý do của trạng thái hiện tại; NULL khi ACTIVE. @example Cell imbalance check at the Binh Duong workshop']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the row is no longer part of the system, because it left or was entered by mistake (DM-25); all its data is kept, and the reason is in status_reason. NULL while it is part of the system. @vi Thời điểm xóa mềm: bản ghi không còn thuộc hệ thống, do đã rời đi hoặc nhập nhầm (DM-25); mọi dữ liệu vẫn được giữ, lý do nằm trong status_reason. NULL khi còn thuộc hệ thống. @example NULL']
  indexes {
    serial_number [unique, name: 'uq_batteries_live_serial_number', note: 'WHERE deleted_at IS NULL']
    vehicle_id [unique, name: 'uq_batteries_installed_vehicle', note: 'WHERE vehicle_id IS NOT NULL AND deleted_at IS NULL: one battery per truck']
  }
  Note: '''@status proposed @owner customer @features F-F2 @tracked *
One physical battery, managed as an asset (BAT-01, VH-16). The truck it is
installed in and its owner are columns with a start time (DM-22). Its
installation periods come from the view battery_installation_periods (see the
views note); owner periods get a view when first needed (DM-27). Code never
reads battery_history directly. A battery's health history across trucks joins telemetry with the
installation periods. When a truck is sold and the seller owns its battery,
the battery moves to the buyer in the same transfer action (VH-12); a battery
owned by someone else (e.g. leased from G3) stays with its owner.
Check constraint: deleted_at IS NULL OR status = 'INACTIVE' (DM-25).
@vi-name Pin
@vi Một viên pin vật lý, được quản lý như một tài sản (BAT-01, VH-16). Xe đang lắp pin và chủ sở hữu pin là các cột kèm thời điểm bắt đầu (DM-22); các giai đoạn lắp lấy từ view battery_installation_periods (xem ghi chú views); giai đoạn sở hữu có view khi cần lần đầu (DM-27); mã nguồn không bao giờ đọc trực tiếp bảng lịch sử. Lịch sử sức khỏe của pin qua các xe được ghép từ dữ liệu vận hành với các giai đoạn lắp. Khi bán xe mà bên bán sở hữu pin, pin chuyển sang bên mua trong cùng thao tác chuyển quyền (VH-12); pin thuộc bên khác (ví dụ thuê của G3) vẫn thuộc chủ của nó. Ràng buộc kiểm tra: deleted_at IS NULL OR status = 'INACTIVE' (DM-25).'''
}

Ref: batteries.battery_model_id > battery_models.battery_model_id [delete: restrict]
Ref: batteries.organization_id > organizations.organization_id [delete: restrict]
Ref: batteries.vehicle_id > vehicles.vehicle_id [delete: restrict]

TableGroup batteries {
  battery_models
  batteries
  Note: '''
Each truck battery managed as an asset of its own: it can move between
trucks and may belong to another organization than the truck. Depends on
vehicles and identity; nothing in vehicles depends on it. Not built yet.

- A **battery model** is a battery type with its specifications.
- A **battery** is one physical pack: its owner and the truck it is installed in are columns with their history (one battery per truck).

@vi-name Pin
@vi Quản lý từng pin xe như một tài sản riêng: pin có thể chuyển giữa các xe và có thể thuộc một tổ chức khác với chủ xe. Phụ thuộc miền xe và miền định danh; miền xe không phụ thuộc miền này. Chưa được xây dựng.
- Một **dòng pin** là một loại pin kèm thông số kỹ thuật.
- Một **pin** là một khối pin vật lý: chủ sở hữu và xe đang lắp là các cột kèm lịch sử (mỗi xe một pin).
'''
}

// ===========================================================================
// warranties: warranties of trucks, batteries and devices (WAR-01)
// ===========================================================================

Table warranties {
  warranty_id uuid [pk, note: 'Internal ID of the warranty. @vi Mã nội bộ của bảo hành. @example 4b9d2f6e-3a1c-4e8b-a7d5-6c0e2f4a8b33']
  vehicle_id uuid [note: 'The truck covered; set only for a truck warranty. Exactly one of vehicle_id, battery_id, telematic_id and station_id is set (check constraint). @vi Xe được bảo hành; chỉ có giá trị với bảo hành xe. Đúng một trong bốn cột vehicle_id, battery_id, telematic_id, station_id có giá trị (ràng buộc kiểm tra). @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  battery_id uuid [note: 'The battery covered; set only for a battery warranty, which therefore follows the battery to another truck. @vi Pin được bảo hành; chỉ có giá trị với bảo hành pin, nên bảo hành đi theo pin sang xe khác. @example NULL']
  telematic_id uuid [note: 'The T-Box covered; set only for a device warranty. @vi T-Box được bảo hành; chỉ có giá trị với bảo hành thiết bị. @example NULL']
  station_id uuid [note: 'The charger (charging station) covered; set only for a charger warranty, which follows the charger to its next owner (VH-19). @vi Trụ sạc được bảo hành; chỉ có giá trị với bảo hành trụ sạc, và đi theo trụ sang chủ kế tiếp (VH-19). @example NULL']
  warranty_type varchar(20) [not null, note: 'STANDARD: delivered with the object. EXTENDED: bought later. Values: STANDARD | EXTENDED. @vi STANDARD: đi kèm khi giao. EXTENDED: mua thêm sau. @example STANDARD']
  contract_reference varchar(100) [note: 'Number of the warranty contract or certificate whose terms apply (rules that are not numbers, e.g. following the charging policy, live there); NULL if none. @vi Số hợp đồng hoặc phiếu bảo hành chứa điều khoản áp dụng (các quy định không phải con số, ví dụ tuân thủ chính sách sạc, nằm trong đó); NULL nếu không có. @example BH-2026-000451']
  starts_on date [not null, note: 'First day of coverage. @vi Ngày bắt đầu bảo hành. @example 2026-06-01']
  ends_on date [not null, note: 'Last day of coverage. @vi Ngày kết thúc bảo hành. @example 2031-05-31']
  limits jsonb [note: 'Other limits, written as the counter reading at which coverage ends (a contract saying "100,000 km from handover" is entered as the handover odometer plus 100,000). Keys by object: truck distance_km; battery energy_throughput_kwh, charge_cycles; T-Box operating_hours, message_count; charger energy_delivered_kwh, session_count (counted from the charger\'s sessions across every owner, VH-19). Coverage ends at whichever limit or ends_on comes first. NULL when there is no other limit. @vi Các giới hạn khác, ghi bằng chỉ số bộ đếm tại đó bảo hành kết thúc (hợp đồng ghi "100.000 km từ ngày bàn giao" thì nhập số odo lúc bàn giao cộng 100.000). Khóa theo đối tượng: xe distance_km; pin energy_throughput_kwh, charge_cycles; T-Box operating_hours, message_count. Bảo hành kết thúc khi chạm giới hạn nào hoặc ends_on trước. NULL khi không có giới hạn khác. @example {"distance_km": 212000}']
  status varchar(10) [not null, note: 'ACTIVE: in force unless expired. VOIDED: revoked by our warranty team (e.g. charging-policy violations), with the reason. Expired is not stored: it is computed from ends_on and the counters. Values: ACTIVE | VOIDED. @vi ACTIVE: còn hiệu lực nếu chưa hết hạn. VOIDED: bị bộ phận bảo hành của chúng ta hủy (ví dụ vi phạm chính sách sạc), kèm lý do. Hết hạn không lưu: được tính từ ends_on và các bộ đếm. @example ACTIVE']
  status_reason varchar(200) [note: 'Why the warranty was voided; NULL when ACTIVE. @vi Lý do bảo hành bị hủy; NULL khi ACTIVE. @example Repeated charging outside the allowed window']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-06-01T03:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the warranty was entered by mistake and is no longer part of the system (DM-25); it is also VOIDED, with the reason. NULL while it is part of the system. @vi Thời điểm xóa mềm: bảo hành nhập nhầm và không còn thuộc hệ thống (DM-25); đồng thời bị VOIDED, kèm lý do. NULL khi còn thuộc hệ thống. @example NULL']
  indexes {
    vehicle_id [name: 'ix_warranties_vehicle_id']
    battery_id [name: 'ix_warranties_battery_id']
    telematic_id [name: 'ix_warranties_telematic_id']
    station_id [name: 'ix_warranties_station_id']
    ends_on [name: 'ix_warranties_ends_on', note: 'Warranties ending soon']
  }
  Note: '''@status proposed @owner customer @features F-F2 @tracked *
One warranty of one truck, battery, T-Box (WAR-01, VH-18) or charger (VH-19), set per object.
Which object is covered is the one link that is set (exactly one, check
constraint); that also decides which limits keys apply. No organization_id
(DM-24): a warranty follows its object, and whoever owns the object now sees
it. A truck usually has several (vehicle, battery, an extended one). Change
history on: voiding must show who and why.
Check constraints: num_nonnulls(vehicle_id, battery_id, telematic_id, station_id) = 1 (VH-18, VH-19); deleted_at IS NULL OR status = 'VOIDED' (DM-25). The limits keys allowed for the set link are checked by the application. Possible later: one warranty table per covered object, each in its own domain (vehicle, battery, T-Box warranties), if their rules drift apart.
@vi-name Bảo hành
@vi Một bảo hành của một xe, pin, T-Box (WAR-01, VH-18) hoặc trụ sạc (VH-19), đặt riêng cho từng đối tượng. Đối tượng được bảo hành là liên kết duy nhất có giá trị (đúng một, ràng buộc kiểm tra); liên kết đó cũng quyết định các khóa giới hạn áp dụng. Không có organization_id (DM-24): bảo hành đi theo đối tượng, ai đang sở hữu đối tượng thì xem được. Một xe thường có nhiều bảo hành (xe, pin, gia hạn). Có lưu lịch sử thay đổi: việc hủy bảo hành phải cho biết ai và vì sao. Ràng buộc kiểm tra: num_nonnulls(vehicle_id, battery_id, telematic_id, station_id) = 1 (VH-18, VH-19); deleted_at IS NULL OR status = 'VOIDED' (DM-25). Các khóa limits hợp lệ theo liên kết được đặt do ứng dụng kiểm tra. Có thể sau này: mỗi loại đối tượng một bảng bảo hành, nằm trong miền của đối tượng đó (bảo hành xe, pin, T-Box), nếu quy định của chúng khác nhau nhiều.'''
}

Ref: warranties.vehicle_id > vehicles.vehicle_id [delete: restrict]
Ref: warranties.battery_id > batteries.battery_id [delete: restrict]
Ref: warranties.telematic_id > telematics.telematic_id [delete: restrict]
Ref: warranties.station_id > charging_stations.station_id [delete: restrict]

TableGroup warranties {
  warranties
  Note: '''
The warranties of trucks, batteries, T-Boxes and chargers: their periods and
limits, and why a warranty was voided. Depends on vehicles, batteries,
telematics and charging_stations; nothing depends on it. Not built yet.

- A **warranty** covers exactly one truck, battery, T-Box or charger and follows it to its next owner.

@vi-name Bảo hành
@vi Bảo hành của xe, pin, T-Box và trụ sạc: thời hạn, giới hạn và lý do một bảo hành bị hủy. Phụ thuộc miền xe, pin, telematics và trạm sạc; không miền nào phụ thuộc miền này. Chưa được xây dựng.
- Một **bảo hành** áp dụng cho đúng một xe, pin, T-Box hoặc trụ sạc và đi theo đối tượng sang chủ kế tiếp.
'''
}

// ===========================================================================
// telematics: telematic devices mounted on vehicles (F-G1, F-J1-J3)
// ===========================================================================

Table telematics {
  telematic_id uuid [pk, note: 'Internal ID of the telematic device. @vi Mã nội bộ của thiết bị telematics. @example 2c8e5a1d-9f3b-4d7c-b2e6-8a1f0c5d9e55']
  imei varchar(15) [note: '@planned TX-09: The device modem\'s IMEI, entered at provisioning; fixed hardware identity, unique among devices not deleted. NULL until entered. @vi Số IMEI của modem thiết bị, nhập khi cấp phát; định danh phần cứng cố định, duy nhất trong các thiết bị chưa xóa. NULL khi chưa nhập. @example 356938035643809']
  telematic_serial varchar(50) [not null, note: 'Serial printed on the device; also its MQTT identity. Unique among devices not deleted. @vi Số serial in trên thiết bị; cũng là định danh MQTT. Duy nhất trong các thiết bị chưa xóa. @example TBX-2409-000123']
  organization_id uuid [not null, note: '@planned TX-07: Organization that owns the device now: the truck\'s owner, or G3 when it supplies the device (e.g. with the subscription). @vi Tổ chức đang sở hữu thiết bị: chủ xe, hoặc G3 khi G3 cung cấp thiết bị (ví dụ kèm gói thuê bao). @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  acquired_at timestamptz [not null, note: '@planned TX-07: When the current owner took the device (DM-22). @vi Thời điểm chủ hiện tại nhận thiết bị (DM-22). @example 2026-06-01T00:00:00Z']
  vehicle_id uuid [note: 'Truck the device is mounted on now; NULL when in stock or removed. A truck holds at most one device. Earlier trucks are in telematic_history; a view is added when a feature first needs them (DM-27). Planned: its foreign key becomes ON DELETE RESTRICT, like every other link (today SET NULL). @vi Xe mà thiết bị đang gắn; NULL khi trong kho hoặc đã tháo. Mỗi xe gắn tối đa một thiết bị. Các xe trước nằm trong telematic_history; view được thêm khi có tính năng đầu tiên cần (DM-27). Dự kiến: khóa ngoại chuyển sang ON DELETE RESTRICT như mọi liên kết khác (hiện là SET NULL). @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  installed_at timestamptz [note: '@planned TX-08: When the device was mounted on its current truck; NULL when not mounted (DM-22). @vi Thời điểm thiết bị được gắn lên xe hiện tại; NULL khi chưa gắn (DM-22). @example 2026-06-01T00:00:00Z']
  status telematicstatus [not null, note: 'Status set by a person (DM-25). ACTIVE: usable. INACTIVE: not usable now, e.g. being repaired; the reason says why. A device that leaves the system (scrapped, returned) is INACTIVE, unmounted and soft-deleted. Mounted or in stock is read from vehicle_id; sending data or silent is computed from telemetry (TX-06). Only a mounted, ACTIVE device receives configuration. @vi Trạng thái do con người đặt (DM-25). ACTIVE: dùng được. INACTIVE: hiện không dùng được, ví dụ đang sửa chữa; lý do cho biết vì sao. Thiết bị rời hệ thống (thanh lý, trả lại) được chuyển sang INACTIVE, tháo khỏi xe và xóa mềm. Đang gắn hay trong kho đọc từ vehicle_id; có gửi dữ liệu hay im lặng được tính từ dữ liệu vận hành (TX-06). Chỉ thiết bị đang gắn và ACTIVE mới nhận cấu hình. @example ACTIVE']
  status_reason varchar(200) [note: '@planned DM-19: Why the device is in its current status; NULL when ACTIVE. @vi Lý do của trạng thái hiện tại; NULL khi ACTIVE. @example Antenna replaced at the Hanoi workshop']
  firmware_version varchar(50) [note: '@remove TX-08: Firmware typed in through the API; the device reports it in its status reports (telematic_status_reports). @vi Firmware nhập qua API; thiết bị tự báo trong báo cáo trạng thái (telematic_status_reports). @example 1.4.2']
  telemetry_interval_seconds integer [note: '@remove TX-09: Publish interval last pushed to this device; the interval is now an organization setting (organization_settings), and what the device actually uses is in its status reports (telematic_status_reports). @vi Chu kỳ gửi đã đẩy xuống thiết bị này; chu kỳ nay là thiết lập của tổ chức (organization_settings), còn chu kỳ thiết bị thực sự dùng nằm trong báo cáo trạng thái (telematic_status_reports). @example 10']
  config_pushed_at timestamptz [note: '@remove TX-08: When the interval was last pushed; the push happens when the change is saved, so the history\'s changed_at gives it (DM-23). @vi Thời điểm đẩy chu kỳ lần gần nhất; việc đẩy xảy ra khi lưu thay đổi nên lấy từ changed_at của lịch sử (DM-23). @example 2026-09-12T03:00:00Z']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the row is no longer part of the system, because it left or was entered by mistake (DM-25); all its data is kept, and the reason is in status_reason. NULL while it is part of the system. Its past trucks stay in the history. @vi Thời điểm xóa mềm: bản ghi không còn thuộc hệ thống, do đã rời đi hoặc nhập nhầm (DM-25); mọi dữ liệu vẫn được giữ, lý do nằm trong status_reason. NULL khi còn thuộc hệ thống. Các xe trước vẫn nằm trong lịch sử. @example NULL']
  indexes {
    status [name: 'ix_telematics_status']
    telematic_serial [unique, name: 'ix_telematics_telematic_serial', note: 'Planned (TX-08): unique only among devices not deleted (WHERE deleted_at IS NULL)']
    vehicle_id [name: 'ix_telematics_vehicle_id', note: 'To be removed (TX-08): the unique index below serves it']
    vehicle_id [unique, name: 'uq_telematics_active_vehicle', note: 'WHERE deleted_at IS NULL; planned (TX-08): WHERE vehicle_id IS NOT NULL AND deleted_at IS NULL, one device per truck']
  }
  Note: '''@status built @owner customer @features F-G1,F-J1,F-J2,F-J3 @tracked *
Profile of one telematic device (T-Box): what it is and the decisions about it
(TX-08). The device is an asset with its own owner, the truck's owner or G3
(TX-07); a device the seller owns moves with the truck at a sale. Its owner
and truck are columns with a start time (DM-22); their periods get views when
a feature first needs them (DM-27).
What the device reports about itself is kept in telematic_status_reports;
its current health is the newest report (TX-11).
Check constraint: deleted_at IS NULL OR (status = 'INACTIVE' AND vehicle_id IS NULL) (DM-25).
@vi-name Thiết bị telematics
@vi Hồ sơ của một thiết bị telematics (T-Box): thiết bị là gì và các quyết định về nó (TX-08). Thiết bị là một tài sản có chủ riêng, là chủ xe hoặc G3 (TX-07); thiết bị thuộc bên bán đi theo xe khi bán xe. Chủ sở hữu và xe đang gắn là các cột kèm thời điểm bắt đầu (DM-22), các giai đoạn có view khi có tính năng đầu tiên cần (DM-27). Những gì thiết bị tự báo về mình được lưu trong telematic_status_reports; sức khỏe hiện tại là báo cáo mới nhất (TX-11). Ràng buộc kiểm tra: deleted_at IS NULL OR (status = 'INACTIVE' AND vehicle_id IS NULL) (DM-25).'''
}

Table telematic_status_reports {
  telematic_status_report_id bigint [pk, increment, note: 'Auto-increasing ID of the report. @vi Mã tự tăng của báo cáo. @example 51234']
  telematic_id uuid [not null, note: 'Device that sent the report. @vi Thiết bị gửi báo cáo. @example 2c8e5a1d-9f3b-4d7c-b2e6-8a1f0c5d9e55']
  firmware_version varchar(50) [note: 'Firmware version reported. @vi Phiên bản firmware được báo. @example 1.4.2']
  telemetry_interval_seconds integer [note: 'Publish interval the device said it used. @vi Chu kỳ gửi thiết bị báo đang dùng. @example 10']
  sim_iccid varchar(22) [note: 'ICCID of the SIM in the device. @vi Số ICCID của SIM trong thiết bị. @example 8984049000001234567']
  is_esim boolean [note: 'TRUE when the SIM is an eSIM. @vi TRUE khi SIM là eSIM. @example false']
  sim_data_status varchar(20) [note: 'Mobile data status (provisional values: ACTIVE | NO_DATA | SUSPENDED | NO_SIM). @vi Trạng thái dữ liệu di động (giá trị tạm: ACTIVE | NO_DATA | SUSPENDED | NO_SIM). @example ACTIVE']
  supply_voltage_v numeric(5,2) [note: 'Power supply voltage at the device, in volts. @vi Điện áp nguồn cấp tại thiết bị (V). @example 24.30']
  signal_dbm smallint [note: 'Mobile signal strength in dBm. @vi Cường độ sóng di động (dBm). @example -78']
  storage_used_percent numeric(5,2) [note: 'Share of the device\'s storage in use, 0-100. @vi Tỷ lệ bộ nhớ thiết bị đã dùng, 0-100. @example 41.50']
  gnss_status varchar(20) [note: 'Satellite positioning status (provisional values: FIX | NO_FIX | ANTENNA_FAULT). @vi Trạng thái định vị vệ tinh (giá trị tạm: FIX | NO_FIX | ANTENNA_FAULT). @example FIX']
  reported_at timestamptz [not null, note: 'When the device produced the report (its own timestamp, normalized to UTC). @vi Thời điểm thiết bị tạo báo cáo (theo đồng hồ thiết bị, chuẩn hóa về UTC). @example 2026-09-14T00:30:00Z']
  received_at timestamptz [not null, note: 'When the backend received it. @vi Thời điểm backend nhận được. @example 2026-09-14T00:30:02Z']
  indexes {
    (telematic_id, reported_at) [name: 'ix_telematic_status_reports_device_time', note: 'A device\'s reports over time, newest first']
  }
  Note: '''@status planned @owner customer @features F-J1,F-J3
Every health report a T-Box sends about itself, about once a day (TX-10), so
trends can be seen (signal getting weaker, voltage dropping before it went
silent). Append-only: rows are never edited, so no change history. An
ordinary table, not a hypertable: about 365 rows per device per year. No
organization_id (DM-24): like other condition data it follows the device to
its next owner (VH-11). Fields are provisional until the vendor confirms the
message (mqtt-spec.md section 2.2).
@vi-name Báo cáo trạng thái thiết bị telematics
@vi Mọi báo cáo sức khỏe mà T-Box gửi về chính nó, khoảng mỗi ngày một lần (TX-10), để xem được xu hướng (sóng yếu dần, điện áp tụt trước khi mất tín hiệu). Chỉ ghi thêm: không bao giờ sửa dòng nên không cần lịch sử thay đổi. Là bảng thường, không phải hypertable: khoảng 365 dòng mỗi thiết bị mỗi năm. Không có organization_id (DM-24): như các dữ liệu tình trạng khác, đi theo thiết bị sang chủ kế tiếp (VH-11). Các trường là tạm thời cho tới khi nhà cung cấp xác nhận bản tin (mqtt-spec.md mục 2.2).'''
}

Ref: telematics.vehicle_id - vehicles.vehicle_id [delete: set null]
Ref: telematics.organization_id > organizations.organization_id [delete: restrict]
Ref: telematic_status_reports.telematic_id > telematics.telematic_id [delete: restrict]

TableGroup telematics {
  telematics
  telematic_status_reports
  Note: '''
The telematic devices that send vehicle data over MQTT.

- A **device** is an asset with its own owner; it is mounted on at most one vehicle, and a vehicle has at most one device.
- What it reports about itself (firmware, SIM, power, signal) is kept as **status reports**, one row per report; its current health is the newest report (TX-11). The send interval is an organization setting (TX-09).

@vi-name Thiết bị telematics
@vi Các thiết bị telematics (T-box) gửi dữ liệu xe qua MQTT.
- Một **thiết bị** là tài sản có chủ riêng; gắn trên tối đa một xe, và một xe có tối đa một thiết bị.
- Những gì thiết bị tự báo về mình (firmware, SIM, nguồn điện, sóng) được lưu thành **báo cáo trạng thái**, mỗi báo cáo một dòng; sức khỏe hiện tại là báo cáo mới nhất (TX-11). Chu kỳ gửi là thiết lập của tổ chức (TX-09).
'''
}

// ===========================================================================
// telemetry: real-time and historical vehicle data (F-A1 ...)
// ===========================================================================

Table telemetry {
  message_id bigint [pk, increment, note: 'Auto-increasing ID assigned by the backend. @vi Mã tự tăng do backend cấp. @example 90213377']
  recorded_at timestamptz [pk, note: 'When the device recorded the sample; hypertable time column. @vi Thời điểm thiết bị ghi nhận dữ liệu; cột thời gian của bảng chuỗi thời gian. @example 2026-09-15T08:30:00Z']
  organization_id uuid [not null, note: '@planned VH-11: Customer that owned the vehicle at recorded_at (not today\'s owner). @vi Khách hàng sở hữu xe tại thời điểm recorded_at (không phải chủ hiện tại). @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  device_message_id uuid [not null, note: '@built-as message_uuid: ID the device gives each message (an external identifier, hence the device prefix), used to trace it in the device\'s logs and to spot duplicates; not unique, since a device can repeat it (TM-06). @vi Mã thiết bị gán cho mỗi bản tin, dùng để phát hiện trùng. @example 5b0e3c7a-9d21-4f6e-8a4b-c3d2e1f0a9b8']
  telematic_id uuid [not null, note: 'Device that sent the sample. Planned: its foreign key becomes ON DELETE RESTRICT, like every other link (today CASCADE would delete the samples with their parent). @vi Thiết bị đã gửi bản ghi. @example 2c8e5a1d-9f3b-4d7c-b2e6-8a1f0c5d9e55']
  telematic_serial varchar(50) [not null, note: '@remove TM-16: Device serial copied onto every row; it is already in raw_payload and reachable through telematic_id. @vi Serial thiết bị, chép vào dòng để phục vụ kiểm tra và gỡ lỗi. @example TBX-2409-000123']
  vehicle_id uuid [not null, note: 'Vehicle the sample describes. Planned: its foreign key becomes ON DELETE RESTRICT, like every other link (today CASCADE would delete the samples with their parent). @vi Xe mà bản ghi mô tả. @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  received_at timestamptz [not null, note: 'When the backend received the message. @vi Thời điểm backend nhận bản tin. @example 2026-09-15T08:30:02Z']
  location "geography(POINT,4326)" [not null, note: 'GPS position (WGS84 point, longitude first). No spatial index (write-heavy path). @vi Vị trí GPS (điểm WGS84, kinh độ trước). Không có chỉ mục không gian (luồng ghi dày đặc). @example POINT(106.6297 10.8231)']
  speed_kmh float8 [note: '@built-as speed: Speed in km/h. @vi Tốc độ (km/h). @example 62.5']
  heading_degrees float8 [note: '@built-as heading: Direction of travel in degrees (0-360, 0 = north); NULL if unknown. @vi Hướng di chuyển (độ, 0-360, 0 = hướng bắc); NULL nếu không rõ. @example 135.0']
  soc_percent float8 [not null, note: '@built-as soc: State of charge: battery left, in % (0-100). @vi Mức pin còn lại (SOC), % (0-100). @example 64.2']
  battery_voltage_v float8 [note: '@built-as battery_voltage: Pack voltage in volts. @vi Điện áp pack pin (V). @example 612.4']
  battery_current_a float8 [note: '@built-as battery_current: Pack current in amperes. @vi Dòng điện pack pin (A). @example -85.3']
  battery_temperature_celsius float8 [note: '@built-as battery_temperature: Battery temperature in °C. @vi Nhiệt độ pin (°C). @example 34.5']
  soh_percent float8 [note: 'State of health: capacity left compared with new, in % (F-A3). @vi Sức khỏe pin (SOH): dung lượng còn lại so với khi mới, % (F-A3). @example 97.8']
  cycle_count integer [note: 'Cumulative charge/discharge cycles of the pack (F-A3). @vi Số chu kỳ sạc-xả tích lũy của pack pin (F-A3). @example 213']
  motor_temperature_celsius float8 [note: '@built-as motor_temperature: Motor temperature in °C. @vi Nhiệt độ động cơ (°C). @example 58.0']
  odometer_km float8 [note: '@built-as odometer: Total distance driven, in km. @vi Tổng quãng đường đã chạy (km). @example 48213.7']
  signal_dbm bigint [note: '@built-as signal_strength: Cellular signal strength in dBm. @vi Cường độ sóng di động (dBm). @example -71']
  error_codes jsonb [note: 'Fault codes active at the time, as a JSON array; NULL if none. @vi Các mã lỗi đang hoạt động, dạng mảng JSON; NULL nếu không có. @example ["P0A80", "U0100"]']
  raw_payload jsonb [not null, note: 'Original message exactly as received, for debugging and reprocessing. @vi Bản tin gốc đúng như khi nhận, để gỡ lỗi và xử lý lại. @example {"serial": "TBX-2409-000123", "soc": 64.2, ...}']
  schema_version integer [not null, note: 'Version of the MQTT message contract the device used (F-A1). @vi Phiên bản cấu trúc bản tin MQTT mà thiết bị dùng (F-A1). @example 1']
  indexes {
    (vehicle_id, `recorded_at DESC`) [name: 'ix_telemetry_vehicle_time']
    (vehicle_id, `received_at DESC`) [name: 'ix_telemetry_vehicle_received', note: 'Last time the backend heard from a vehicle (F-J1/F-J3 device-health monitor); uses the receive clock, which a skewed device clock cannot move. @vi Lần cuối backend nhận dữ liệu từ xe (giám sát thiết bị F-J1/F-J3); dùng đồng hồ nhận của backend, không bị lệch giờ thiết bị làm sai.']
    device_message_id [name: 'ix_telemetry_device_message_id']
    (telematic_id, recorded_at) [unique, name: 'uq_telemetry_telematic_recorded_at']
  }
  Note: '''@status built @owner customer @features F-A1,F-A2,F-A3,F-A4,F-A6,F-C6 @hypertable recorded_at @built-as vehicle_telemetry
One telemetry sample from a vehicle, every 5-10 s per vehicle: the largest table.
A signal becomes a typed column only when a feature queries it; until then it
stays in raw_payload, which keeps every message as received (TM-16). Every
row is kept; no retention or compression for now (TM-17).
@vi-name Dữ liệu vận hành xe
@vi Một bản ghi dữ liệu xe gửi về, mỗi 5-10 giây một bản ghi cho mỗi xe: bảng lớn nhất hệ thống. Một tín hiệu chỉ trở thành cột riêng khi có tính năng truy vấn nó; trước đó vẫn nằm trong raw_payload, nơi lưu nguyên vẹn mọi bản tin (TM-16). Mọi dòng đều được giữ; hiện chưa xóa hay nén dữ liệu cũ (TM-17).'''
}

Ref: telemetry.organization_id > organizations.organization_id [delete: restrict]
Ref: telemetry.telematic_id > telematics.telematic_id [delete: cascade]
Ref: telemetry.vehicle_id > vehicles.vehicle_id [delete: cascade]

TableGroup telemetry {
  telemetry
  Note: '''
Everything the vehicle reports: position, battery, motor, errors. Alerts and
energy reports are computed from it.

- Each **sample** comes from one device and is stored against one vehicle.
- Each sample also records the organization that owned the vehicle *at that moment*, so it stays with that owner after a sale (VH-11).

@vi-name Dữ liệu vận hành xe
@vi Mọi thứ xe gửi về: vị trí, pin, động cơ, mã lỗi. Cảnh báo và báo cáo năng lượng được tính từ dữ liệu này.
- Mỗi **bản ghi** đến từ một thiết bị và được lưu theo một xe.
- Mỗi bản ghi ghi thêm tổ chức sở hữu xe *tại đúng thời điểm đó*, nên vẫn thuộc chủ đó sau khi bán xe (VH-11).
'''
}

// ===========================================================================
// drivers: driver profiles and driving sessions (F-E4)
// ===========================================================================

Table drivers {
  driver_id uuid [pk, note: 'Internal ID of the driver profile. @vi Mã nội bộ của hồ sơ tài xế. @example 6e3b9d2a-4c1f-4e8b-9a7d-0c2e5f1b8d66']
  membership_id uuid [not null, unique, note: '@planned DR-09: The membership (one person in one organization) this profile belongs to; the organization is read through it (DM-24). A person who drives for two organizations has one profile in each, and each organization keeps its own copy of the facts. A new membership after leaving gets a new profile. @vi Thành viên (một người trong một tổ chức) sở hữu hồ sơ này; tổ chức được đọc qua thành viên (DM-24). Người lái xe cho hai tổ chức có một hồ sơ ở mỗi tổ chức, và mỗi tổ chức tự giữ bản thông tin của mình. Thành viên mới sau khi đã rời đi có hồ sơ mới. @example 00000022-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  full_name varchar(100) [not null, note: '@remove DR-09: Driver\'s full name; a fact about the person, already users.full_name. @vi Họ tên tài xế; là thông tin của con người, đã có ở users.full_name. @example Nguyễn Văn An']
  phone_number varchar(20) [not null, unique, note: '@remove DR-09: Contact phone number; a fact about the person, already users.phone_number. @vi Số điện thoại liên hệ; là thông tin của con người, đã có ở users.phone_number. @example +84912345678']
  license_number varchar(50) [not null, note: 'Driving licence number as recorded by this organization. Not unique: a person who drives for two organizations has it on both profiles. When the number is already on another person\'s live profile, the app warns instead of refusing, so one organization learns nothing about another\'s driver (DR-09). @vi Số giấy phép lái xe do tổ chức này ghi nhận. Không duy nhất: người lái xe cho hai tổ chức có số này ở cả hai hồ sơ. Khi số đã có trên hồ sơ còn hiệu lực của người khác, ứng dụng chỉ cảnh báo chứ không từ chối, để một tổ chức không biết gì về tài xế của tổ chức khác (DR-09). @example 790123456789']
  license_class varchar(5) [not null, note: '@planned DR-09: Licence class under Law 36/2024/QH15 (the highest one held for trucks). A tractor head needs CE; any other class only gives a warning at check-in until vehicle models have a body type (DR-10). Values: B | C1 | C | D1 | D2 | D | BE | C1E | CE | D1E | D2E | DE. @vi Hạng giấy phép lái xe theo Luật 36/2024/QH15 (hạng cao nhất dùng cho xe tải). Đầu kéo cần hạng CE; hạng khác chỉ bị cảnh báo khi nhận xe cho tới khi dòng xe có loại thân xe (DR-10). @example CE']
  license_expires_on date [not null, note: '@planned DR-09: Expiry date printed on the licence (DM-26); every truck class expires. "Expired" is computed from it, never stored as a status; an expired licence blocks check-in and drives the expiry reminder (DRV-01). @vi Ngày hết hạn ghi trên giấy phép (DM-26); mọi hạng xe tải đều có thời hạn. "Hết hạn" được tính từ cột này, không lưu thành trạng thái; giấy phép hết hạn chặn việc nhận xe và dùng để nhắc gia hạn (DRV-01). @example 2029-03-01']
  status driverstatus [not null, note: 'Decided by the organization. ACTIVE: may check in to a truck (with the other conditions of DR-10). INACTIVE: may not, e.g. suspended, or the person left (then also soft-deleted). Values: ACTIVE | INACTIVE. @vi Do tổ chức quyết định. ACTIVE: được nhận xe (cùng các điều kiện khác của DR-10). INACTIVE: không được, ví dụ bị tạm đình chỉ, hoặc người đó đã rời đi (khi đó cũng bị xóa mềm). @example ACTIVE']
  status_reason varchar(200) [note: '@planned DM-19: Why the profile has its current status, or why it left the system; NULL when there is nothing to explain. Earlier reasons are in driver_history. @vi Lý do của trạng thái hiện tại, hoặc lý do hồ sơ rời hệ thống; NULL khi không có gì cần giải thích. Các lý do trước đó nằm trong driver_history. @example Tạm đình chỉ sau va chạm ngày 12/09']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the profile is no longer part of the system, because the person left the organization (the membership ended) or it was entered by mistake (DM-25); all its data is kept, and the reason is in status_reason. Ending a membership sets the profile INACTIVE and fills this in the same transaction (DR-10). NULL while it is part of the system. @vi Thời điểm xóa mềm: hồ sơ không còn thuộc hệ thống, do người đó rời tổ chức (thành viên kết thúc) hoặc nhập nhầm (DM-25); mọi dữ liệu vẫn được giữ, lý do nằm trong status_reason. Khi thành viên kết thúc, hồ sơ được chuyển sang INACTIVE và điền cột này trong cùng giao dịch (DR-10). NULL khi còn thuộc hệ thống. @example NULL']
  indexes {
    license_number [name: 'ix_drivers_license_number', note: 'Planned (DR-09): no longer unique; for search and the duplicate-number warning']
  }
  Note: '''@status built @owner customer @features F-E4 @tracked *
Driver profile: the facts the system acts on about one person's job as a
driver in one organization (ID-13). Who the person is (name, phone) lives on
users; the organization is read through the membership. A person driving
for two organizations has two profiles, and each organization is responsible
for its own (DR-09). A driver may check in to a truck when the profile is
ACTIVE and not deleted, its licence has not expired, and the membership and
the user are ACTIVE (DR-10).
Check constraint: deleted_at IS NULL OR status = 'INACTIVE' (DM-25).
@vi-name Tài xế
@vi Hồ sơ tài xế: các thông tin mà hệ thống dùng về công việc lái xe của một người trong một tổ chức (ID-13). Người đó là ai (họ tên, số điện thoại) nằm ở users; tổ chức được đọc qua thành viên. Người lái xe cho hai tổ chức có hai hồ sơ, và mỗi tổ chức chịu trách nhiệm về hồ sơ của mình (DR-09). Tài xế được nhận xe khi hồ sơ ACTIVE và chưa bị xóa, giấy phép chưa hết hạn, thành viên và người dùng đều ACTIVE (DR-10). Ràng buộc kiểm tra: deleted_at IS NULL OR status = 'INACTIVE' (DM-25).'''
}

Table driver_vehicle_assignments {
  assignment_id uuid [pk, note: 'Internal ID of the assignment. @vi Mã nội bộ của lần phân công. @example 00000004-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  organization_id uuid [note: '@planned: Customer organization the assignment belongs to. @vi Tổ chức khách hàng của lần phân công. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  driver_id uuid [not null, note: 'Driver assigned. @vi Tài xế được phân công. @example 6e3b9d2a-4c1f-4e8b-9a7d-0c2e5f1b8d66']
  vehicle_id uuid [not null, note: 'Vehicle assigned. @vi Xe được phân công. @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  assigned_at timestamptz [not null, note: 'When the assignment began. @vi Thời điểm bắt đầu phân công. @example 2026-09-01T00:00:00Z']
  unassigned_at timestamptz [note: 'When it ended; NULL while the driver still has the vehicle. @vi Thời điểm kết thúc; NULL khi tài xế vẫn đang giữ xe. @example NULL']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (moves when the assignment is closed). @vi Thời điểm bản ghi được sửa gần nhất (thay đổi khi kết thúc phân công). @example 2026-09-10T07:15:00Z']
  indexes {
    vehicle_id [unique, name: 'uq_driver_vehicle_assignments_active_vehicle', note: 'WHERE unassigned_at IS NULL']
    driver_id [unique, name: 'uq_driver_vehicle_assignments_active_driver', note: 'WHERE unassigned_at IS NULL']
    (driver_id, assigned_at) [name: 'ix_driver_vehicle_assignments_driver_time']
    driver_id [name: 'ix_driver_vehicle_assignments_driver_id']
    vehicle_id [name: 'ix_driver_vehicle_assignments_vehicle_id']
  }
  Note: '''@status built @owner customer @features F-E4 @remove DR-07
Which driver drove which vehicle, and when (open/close history).
To be removed: replaced by driving_sessions (DR-07) and dropped in the bulk
refactor; there is no real data to carry over.
@vi-name Phân công tài xế - xe
@vi Tài xế nào lái xe nào, trong khoảng thời gian nào (lịch sử mở/đóng). Sẽ bị bỏ: được thay bằng driving_sessions (DR-07) và xóa khi tái cấu trúc; không có dữ liệu thật cần chuyển.'''
}

Table driving_sessions {
  driving_session_id uuid [pk, note: 'Internal ID of the driving session. @vi Mã nội bộ của phiên lái. @example 0000001d-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  organization_id uuid [not null, note: 'Organization that owns the truck; the session belongs to it. The driver may belong to another organization (DR-07). @vi Tổ chức sở hữu xe; phiên lái thuộc về tổ chức này. Tài xế có thể thuộc tổ chức khác (DR-07). @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  driver_id uuid [not null, note: 'Driver profile at the wheel: any active driver in the system, from any organization; a driver from another organization is a normal case (e.g. a truck owner hiring drivers from another company) and only gives a warning. The profile is the person\'s profile in the truck\'s organization when they have one, otherwise their profile in the organization they act for in the app; a manager checking someone in from the portal picks one of their own organization\'s profiles (DR-10). @vi Hồ sơ tài xế đang cầm lái: bất kỳ tài xế đang hoạt động nào trong hệ thống, thuộc bất kỳ tổ chức nào; tài xế của tổ chức khác là trường hợp bình thường (ví dụ chủ xe thuê tài xế của công ty khác) và chỉ có cảnh báo. Hồ sơ được dùng là hồ sơ của người đó trong tổ chức sở hữu xe nếu có, nếu không thì hồ sơ trong tổ chức họ đang làm việc trên ứng dụng; quản lý nhận xe giúp trên portal chọn một hồ sơ của chính tổ chức mình (DR-10). @example 6e3b9d2a-4c1f-4e8b-9a7d-0c2e5f1b8d66']
  vehicle_id uuid [not null, note: 'Truck being driven. @vi Xe đang được lái. @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  check_in_method varchar(10) [not null, note: 'How the driver checked in. QR: scanned the code on the truck. APP: picked the truck from the nearby trucks listed in the app. PORTAL: a manager checked the driver in from the portal (e.g. a driver without a phone). Values: QR | APP | PORTAL. @vi Cách tài xế nhận xe. QR: quét mã trên xe. APP: chọn xe trong danh sách xe ở gần hiển thị trên ứng dụng. PORTAL: quản lý nhận xe giúp tài xế trên portal (ví dụ tài xế không có điện thoại). @example QR']
  check_in_location "geography(POINT,4326)" [note: 'Where the phone was at check-in, compared with the truck\'s last T-Box position to refuse a check-in far from the truck; NULL for PORTAL. @vi Vị trí điện thoại lúc nhận xe, so với vị trí T-Box gần nhất của xe để từ chối nhận xe từ xa; NULL với PORTAL. @example POINT(106.66 10.76)']
  started_at timestamptz [not null, note: 'Check-in time; the truck may be started before or after it. @vi Thời điểm nhận xe; xe có thể được khởi động trước hoặc sau. @example 2026-09-14T00:30:00Z']
  ended_at timestamptz [note: 'When the session ended; NULL while the driver is at the wheel. @vi Thời điểm kết thúc phiên; NULL khi tài xế vẫn đang cầm lái. @example NULL']
  end_cause varchar(20) [note: 'Why the session ended. CHECKED_OUT: the driver checked out. TAKEN_OVER: another driver checked in to the truck. OTHER_TRUCK: the driver checked in to another truck. AUTO_ENDED: the truck did not move for the organization\'s auto-end time. DRIVER_REMOVED: the driver profile was deleted. OWNER_CHANGED: the truck was transferred to another organization (VH-12). NULL while open. Values: CHECKED_OUT | TAKEN_OVER | OTHER_TRUCK | AUTO_ENDED | DRIVER_REMOVED | OWNER_CHANGED. @vi Lý do kết thúc phiên. CHECKED_OUT: tài xế trả xe. TAKEN_OVER: tài xế khác nhận xe. OTHER_TRUCK: tài xế nhận xe khác. AUTO_ENDED: xe không di chuyển quá thời gian tự kết thúc của tổ chức. DRIVER_REMOVED: hồ sơ tài xế bị xóa. OWNER_CHANGED: xe được chuyển cho tổ chức khác (VH-12). NULL khi phiên còn mở. @example TAKEN_OVER']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-14T00:30:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (moves when the session ends). @vi Thời điểm bản ghi được sửa gần nhất (thay đổi khi phiên kết thúc). @example 2026-09-14T09:10:00Z']
  indexes {
    vehicle_id [unique, name: 'uq_driving_sessions_open_vehicle', note: 'WHERE ended_at IS NULL: one driver at the wheel per truck']
    driver_id [unique, name: 'uq_driving_sessions_open_driver', note: 'WHERE ended_at IS NULL: one truck per driver at a time']
    (vehicle_id, started_at) [name: 'ix_driving_sessions_vehicle_time']
    (driver_id, started_at) [name: 'ix_driving_sessions_driver_time']
  }
  Note: '''@status planned @owner customer @features F-E4
Who was at the wheel of which truck, and when (DR-07): the driver checks in by
scanning the QR code on the truck or picking a nearby truck in the app, or a
manager checks them in from the portal. Replaces driver_vehicle_assignments.
A session ends when the driver checks out, another driver checks in to the
truck, the driver checks in to another truck, or the truck has not moved for
the organization's auto-end time (organization_settings). Events that need a
driver (scores, trips, charging sessions) take it from here. Assigned-driver
alerts go to the driver checked in and to the portal; a truck moving with
nobody checked in alerts the portal. Seen in full by the truck's
organization; the driver sees only a summary of their own sessions in the app
(times, truck, duration, distance; no route or places, no export), and a
driver's own employer does not see sessions on another organization's truck
(DR-08, DR-11). Closed rows are never edited, so no change history.
@vi-name Phiên lái xe
@vi Ai cầm lái xe nào, trong khoảng thời gian nào (DR-07): tài xế nhận xe bằng cách quét mã QR trên xe hoặc chọn xe ở gần trên ứng dụng, hoặc quản lý nhận xe giúp trên portal. Thay thế driver_vehicle_assignments. Phiên kết thúc khi tài xế trả xe, tài xế khác nhận xe, tài xế nhận xe khác, hoặc xe không di chuyển quá thời gian tự kết thúc của tổ chức (organization_settings). Các sự kiện cần biết tài xế (điểm, chuyến, phiên sạc) lấy tài xế từ đây. Cảnh báo cho tài xế gửi tới tài xế đang nhận xe và portal; xe chạy mà không ai nhận xe sẽ cảnh báo lên portal. Tổ chức sở hữu xe xem đầy đủ phiên lái; tài xế chỉ xem bản tóm tắt các phiên của mình trên ứng dụng (thời gian, xe, thời lượng, quãng đường; không có lộ trình hay địa điểm, không xuất dữ liệu), và tổ chức tuyển dụng tài xế không xem được phiên lái trên xe của tổ chức khác (DR-08, DR-11). Dòng đã đóng không bao giờ bị sửa nên không cần lịch sử thay đổi.'''
}

Ref: drivers.membership_id - memberships.membership_id [delete: restrict]
Ref: driver_vehicle_assignments.organization_id > organizations.organization_id [delete: restrict]
Ref: driver_vehicle_assignments.driver_id > drivers.driver_id [delete: restrict]
Ref: driver_vehicle_assignments.vehicle_id > vehicles.vehicle_id [delete: restrict]
Ref: driving_sessions.organization_id > organizations.organization_id [delete: restrict]
Ref: driving_sessions.driver_id > drivers.driver_id [delete: restrict]
Ref: driving_sessions.vehicle_id > vehicles.vehicle_id [delete: restrict]

TableGroup drivers {
  drivers
  driver_vehicle_assignments
  driving_sessions
  Note: '''
The people who drive the trucks, and who is at the wheel of which truck.

- A **driver profile** belongs to one membership: one person in one organization.
- A **driving session** records who is at the wheel of which truck: the driver checks in by QR, in the app or through a manager in the portal; any active driver may drive any organization's truck. It replaces the built **assignments**, which are dropped in the refactor.
- No charging credential is stored: every charge at launch starts with a QR scan (CO-13). RFID cards and VIN Autocharge may be implemented later (deferred.md 90).

@vi-name Tài xế
@vi Những người lái xe, và ai đang cầm lái xe nào.
- Một **hồ sơ tài xế** thuộc một thành viên: một người trong một tổ chức.
- Một **phiên lái** ghi nhận ai đang cầm lái xe nào: tài xế nhận xe bằng QR, trên ứng dụng hoặc qua quản lý trên portal; tài xế đang hoạt động nào cũng có thể lái xe của bất kỳ tổ chức nào. Phiên lái thay thế **phân công** đã xây dựng, sẽ bị bỏ khi tái cấu trúc.
- Không lưu phương thức xác thực sạc: lúc ra mắt mọi lần sạc đều bắt đầu bằng quét mã QR (CO-13). Thẻ RFID và VIN Autocharge có thể được triển khai sau (deferred.md 90).
'''
}

// ===========================================================================
// fleet: fleets and vehicle membership (F-E1)
// ===========================================================================

Table fleets {
  fleet_id uuid [pk, note: 'Internal ID of the fleet. @vi Mã nội bộ của đội xe. @example 8d5f2b7e-1a9c-4f3d-b8e2-6c0a4d9f1e77']
  organization_id uuid [not null, note: '@planned FL-08: Organization the fleet belongs to, its own owner (DM-24 case A). @vi Tổ chức sở hữu đội xe, là chủ sở hữu trực tiếp (DM-24 trường hợp A). @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  parent_fleet_id uuid [note: '@planned: The fleet this one sits under, so a customer can build its own structure (region > branch > depot, any depth); NULL for a top-level fleet. Must belong to the same organization and must not create a loop. A user assigned to a fleet also covers every fleet below it. @vi Đội xe cấp trên chứa đội này, để khách hàng tự xây dựng cơ cấu của mình (miền > chi nhánh > bãi xe, không giới hạn số cấp); NULL với đội cấp cao nhất. Phải cùng tổ chức và không được tạo vòng lặp. Người dùng được gán vào một đội cũng quản lý mọi đội bên dưới. @example NULL']
  fleet_code varchar(50) [not null, unique, note: 'Short code chosen by the customer, for imports and reports. Planned (FL-08): optional, and unique only within its organization among fleets not deleted. @vi Mã ngắn do khách hàng chọn, dùng khi nhập dữ liệu và trong báo cáo. Dự kiến (FL-08): không bắt buộc, và chỉ duy nhất trong tổ chức giữa các đội chưa bị xóa. @example HCM-01']
  name varchar(100) [not null, note: 'Name chosen by the customer, shown in the portal. Planned (FL-08): optional; a fleet has at least a name or a code (check constraint). @vi Tên do khách hàng chọn, hiển thị trên portal. Dự kiến (FL-08): không bắt buộc; một đội có ít nhất tên hoặc mã (ràng buộc kiểm tra). @example Đội xe Hồ Chí Minh']
  status fleetstatus [not null, note: '@remove FL-08: Fleet lifecycle status; a fleet is a grouping, so it either exists or is deleted. @vi Trạng thái của đội xe; đội xe chỉ là một nhóm nên chỉ có tồn tại hoặc đã xóa. @example ACTIVE']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the fleet no longer exists (DM-25); its member trucks leave it (FL-06) and its history is kept. Why it was deleted is the change reason in its history. NULL while it exists. @vi Thời điểm xóa mềm: đội xe không còn tồn tại (DM-25); các xe thành viên rời đội (FL-06) và lịch sử được giữ lại. Lý do xóa là lý do thay đổi trong lịch sử. NULL khi đội còn tồn tại. @example NULL']
  indexes {
    status [name: 'ix_fleets_status', note: 'Dropped with status (FL-08)']
    fleet_code [unique, name: 'ix_fleets_fleet_code', note: 'Replaced by uq_fleets_live_organization_code (FL-08)']
    (organization_id, fleet_code) [unique, name: 'uq_fleets_live_organization_code', note: 'Planned (FL-08): WHERE deleted_at IS NULL AND fleet_code IS NOT NULL']
    organization_id [name: 'ix_fleets_organization_id', note: 'Planned (FL-08)']
    parent_fleet_id [name: 'ix_fleets_parent_fleet_id', note: 'Planned (FL-08): walking the tree']
  }
  Note: '''@status built @owner customer @features F-E1 @tracked *
A named group of vehicles inside an organization: a node of the customer's
own structure (region, branch, depot, team - any name, any depth, through
parent_fleet_id). Reorganising is editing data, never the schema.
Change history on (FL-08): renaming, moving or deleting a fleet is a
decision, and a move changes what a manager assigned to a parent fleet can
see (FL-03). Deleting a fleet that still has live sub-fleets is refused.
Check constraint (FL-08): num_nonnulls(name, fleet_code) >= 1.
@vi-name Đội xe
@vi Một nhóm xe có tên bên trong một tổ chức: một nút trong cơ cấu riêng của khách hàng (miền, chi nhánh, bãi xe, nhóm - tên tùy ý, không giới hạn số cấp, qua parent_fleet_id). Tái cơ cấu chỉ là sửa dữ liệu, không bao giờ phải đổi thiết kế. Bật lịch sử thay đổi (FL-08): đổi tên, di chuyển hay xóa đội là một quyết định, và việc di chuyển làm thay đổi phạm vi xem của người quản lý được gán vào đội cấp trên (FL-03). Không được xóa đội còn đội con đang tồn tại. Ràng buộc kiểm tra (FL-08): đội phải có ít nhất tên hoặc mã.'''
}

Table fleet_vehicle_memberships {
  fleet_vehicle_membership_id uuid [pk, note: '@built-as membership_id: Internal ID of one membership period. Renamed because memberships.membership_id (identity) means a person in an organization, a different thing (FL-09). @vi Mã nội bộ của một giai đoạn thành viên. Đổi tên vì memberships.membership_id (miền danh tính) là một người trong một tổ chức, một khái niệm khác (FL-09). @example 00000005-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  fleet_id uuid [not null, note: 'Fleet the vehicle is in; the row reads its organization through it (DM-24), since a fleet never moves to another organization. @vi Đội xe chứa xe; dòng đọc tổ chức qua đội xe (DM-24), vì đội xe không bao giờ chuyển sang tổ chức khác. @example 8d5f2b7e-1a9c-4f3d-b8e2-6c0a4d9f1e77']
  vehicle_id uuid [not null, note: 'Vehicle in the fleet; it must belong to the fleet\'s organization when added. @vi Xe thuộc đội; xe phải thuộc tổ chức của đội khi được thêm vào. @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  added_at timestamptz [not null, note: '@built-as joined_at: When the vehicle was added to the fleet (FL-09). @vi Thời điểm xe được thêm vào đội (FL-09). @example 2026-09-01T00:00:00Z']
  removed_at timestamptz [note: '@built-as left_at: When it was removed; NULL while still a member (FL-09). @vi Thời điểm xe bị đưa ra khỏi đội; NULL khi vẫn còn trong đội (FL-09). @example NULL']
  added_by uuid [note: '@planned FL-09: User who added the vehicle. @vi Người dùng đã thêm xe vào đội. @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  removed_by uuid [note: '@planned FL-09: User who removed it; NULL while a member, or when the system closed the period (the truck was sold, VH-12, or the fleet deleted, FL-06). @vi Người dùng đã đưa xe ra khỏi đội; NULL khi vẫn là thành viên, hoặc khi hệ thống tự đóng (xe được bán, VH-12, hoặc đội bị xóa, FL-06). @example NULL']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (moves when the membership is closed). @vi Thời điểm bản ghi được sửa gần nhất (thay đổi khi xe rời đội). @example 2026-09-10T07:15:00Z']
  indexes {
    fleet_id [name: 'ix_fleet_vehicle_memberships_fleet_id', note: 'Dropped: covered by ix_fleet_vehicle_memberships_fleet_time (FL-09)']
    (fleet_id, added_at) [name: 'ix_fleet_vehicle_memberships_fleet_time']
    vehicle_id [name: 'ix_fleet_vehicle_memberships_vehicle_id']
    vehicle_id [unique, name: 'uq_fleet_vehicle_memberships_active_vehicle', note: 'WHERE removed_at IS NULL (built as left_at)']
  }
  Note: '''@status built @owner customer @features F-E1
Which vehicle was in which fleet, and when (open/close history). A truck is
in at most one fleet at a time and the period holds no data of its own, so
DM-22 would put fleet_id on vehicles; the table stays because vehicles must
not depend on fleet (FL-01, FL-09). No change history: a row is only ever
closed (DM-20); added_by / removed_by say who. No reason column: why a truck
left is clear from what happened (moved, sold, fleet deleted).
@vi-name Thành viên đội xe
@vi Xe nào thuộc đội nào, trong khoảng thời gian nào (lịch sử mở/đóng). Mỗi xe chỉ thuộc tối đa một đội tại một thời điểm và giai đoạn không có dữ liệu riêng, nên theo DM-22 lẽ ra đặt fleet_id trên vehicles; bảng được giữ vì miền xe không được phụ thuộc miền đội xe (FL-01, FL-09). Không có lịch sử thay đổi: dòng chỉ bị đóng (DM-20); added_by / removed_by cho biết ai thực hiện. Không có cột lý do: lý do xe rời đội rõ từ sự việc (chuyển đội, bán xe, đội bị xóa).'''
}

Ref: fleets.organization_id > organizations.organization_id [delete: restrict]
Ref: fleets.parent_fleet_id > fleets.fleet_id [delete: restrict]
Ref: fleet_vehicle_memberships.fleet_id > fleets.fleet_id [delete: restrict]
Ref: fleet_vehicle_memberships.vehicle_id > vehicles.vehicle_id [delete: restrict]
Ref: fleet_vehicle_memberships.added_by > users.user_id [delete: restrict]
Ref: fleet_vehicle_memberships.removed_by > users.user_id [delete: restrict]

Table fleet_user_assignments {
  fleet_user_assignment_id uuid [pk, note: 'Internal ID of the assignment. @vi Mã nội bộ của lần phân công. @example 0000001c-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  fleet_id uuid [not null, note: 'Fleet the user is limited to, together with every fleet below it. Must belong to the membership\'s organization (checked by the service; the row reads its organization through either, DM-24). @vi Đội xe mà người dùng được giới hạn trong đó, cùng mọi đội xe nằm dưới. Phải thuộc tổ chức của thành viên (dịch vụ kiểm tra; dòng đọc tổ chức qua một trong hai, DM-24). @example 8d5f2b7e-1a9c-4f3d-b8e2-6c0a4d9f1e77']
  membership_id uuid [not null, note: 'Membership (person in this organization) whose fleet-level roles (FLEET_MANAGER, DISPATCHER) apply only to the fleets listed for it. @vi Thành viên (người trong tổ chức này) có các vai trò cấp đội xe (FLEET_MANAGER, DISPATCHER) chỉ áp dụng cho các đội xe được liệt kê. @example 00000022-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  assigned_at timestamptz [not null, note: 'When the user was given this fleet. @vi Thời điểm người dùng được giao đội xe này. @example 2026-09-01T02:00:00Z']
  assigned_by uuid [note: 'Who gave it (usually the ORG_ADMIN); NULL when the system did. @vi Ai đã giao (thường là ORG_ADMIN); NULL khi hệ thống tự giao. @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  unassigned_at timestamptz [note: 'When it was taken away; NULL while in force. @vi Thời điểm bị thu lại; NULL khi còn hiệu lực. @example NULL']
  unassigned_by uuid [note: 'Who took it away; NULL while in force, or when the system ended it (the membership ended or the fleet was deleted). @vi Ai đã thu lại; NULL khi còn hiệu lực, hoặc khi hệ thống tự kết thúc (thành viên rời tổ chức hoặc đội bị xóa). @example NULL']
  indexes {
    (fleet_id, membership_id) [unique, name: 'uq_fleet_user_assignments_active', note: 'WHERE unassigned_at IS NULL']
  }
  Note: '''@status planned @owner customer @features F-F1,F-E1
Limits a user's fleet-level roles to some fleets of a large organization
(e.g. one fleet manager for the Hanoi fleet, another for HCMC). A user with
no open row here covers every fleet of their organization. The visible set
is the union of the assigned fleets and every fleet below them, each truck
once, and covers the trucks currently in those fleets (FL-10). A row for a
fleet already covered by an assigned parent is allowed (it keeps access if
the tree changes); the portal warns about it. Lives in the fleet domain, not
identity, so identity keeps depending on no other domain. No change history:
a row is only ever closed (DM-20); assigned_by / unassigned_by say who.
@vi-name Phân công người dùng - đội xe
@vi Giới hạn vai trò cấp đội xe của một người dùng trong một số đội xe của tổ chức lớn (ví dụ một quản lý cho đội Hà Nội, một quản lý khác cho đội TP.HCM). Người dùng không có dòng nào đang hiệu lực ở đây thì quản lý mọi đội xe của tổ chức. Phạm vi xem là hợp của các đội được giao và mọi đội bên dưới, mỗi xe một lần, gồm các xe đang thuộc các đội đó (FL-10). Được phép giao một đội đã nằm dưới một đội cha được giao (giữ quyền khi cây thay đổi); portal sẽ cảnh báo. Nằm ở miền Đội xe, không ở miền Danh tính, để miền Danh tính không phụ thuộc miền nào. Không có lịch sử thay đổi: dòng chỉ bị đóng (DM-20); assigned_by / unassigned_by cho biết ai thực hiện.'''
}

Ref: fleet_user_assignments.fleet_id > fleets.fleet_id [delete: restrict]
Ref: fleet_user_assignments.membership_id > memberships.membership_id [delete: restrict]
Ref: fleet_user_assignments.assigned_by > users.user_id [delete: restrict]
Ref: fleet_user_assignments.unassigned_by > users.user_id [delete: restrict]

Table geofences {
  geofence_id uuid [pk, note: 'Internal ID of the geofence. @vi Mã nội bộ của vùng địa lý. @example 00000003-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  fleet_id uuid [not null, note: 'Fleet whose current member vehicles the area applies to. @vi Đội xe mà các xe thành viên hiện tại chịu áp dụng vùng này. @example 8d5f2b7e-1a9c-4f3d-b8e2-6c0a4d9f1e77']
  organization_id uuid [note: '@planned: Customer organization that defined it, once organizations exist; until then a geofence is scoped to a fleet. @vi Tổ chức khách hàng đã tạo vùng, khi có tổ chức; trước đó vùng gắn với một đội xe. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  name varchar(100) [not null, note: 'Name shown in alerts. @vi Tên hiển thị trong cảnh báo. @example Kho Tân Uyên']
  boundary "geography(POLYGON,4326)" [not null, note: 'Area as a WGS84 polygon (longitude first). No spatial index: checks always filter by fleet first. @vi Ranh giới vùng, dạng đa giác WGS84 (kinh độ trước). Không có chỉ mục không gian: luôn lọc theo đội xe trước. @example POLYGON((106.70 11.05, 106.72 11.05, 106.72 11.07, 106.70 11.07, 106.70 11.05))']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time; NULL while the row is live. Rows are never hard-deleted. @vi Thời điểm xóa mềm; NULL khi bản ghi còn hiệu lực. Không bao giờ xóa hẳn. @example NULL']
  indexes {
    fleet_id [name: 'ix_geofences_fleet_id']
  }
  Note: '''@status built @owner customer @features F-A5
An area whose entry or exit by a member vehicle of its fleet raises an alert.
Scoped to a fleet for now; the move to the organization is designed and deferred
(FL-11, deferred.md 86).
@vi-name Vùng địa lý (geofence)
@vi Một khu vực mà khi xe thuộc đội xe đi vào hoặc ra sẽ phát cảnh báo. Gắn với đội xe cho đến khi có tổ chức khách hàng (sau đó chuyển sang tổ chức).'''
}

Ref: geofences.fleet_id > fleets.fleet_id [delete: restrict]
Ref: geofences.organization_id > organizations.organization_id [delete: restrict]

TableGroup fleet {
  fleets
  fleet_vehicle_memberships
  geofences
  fleet_user_assignments
  Note: '''
Groups of vehicles managed together by a fleet manager.

- A **fleet** is a group inside one organization, and can sit under another fleet, so each customer models its own structure (region > branch > depot...) as data.
- A vehicle is in at most one fleet at a time; a fleet holds many vehicles. **Memberships** keep the history.
- A fleet's **geofences** raise an alert when a member vehicle enters or leaves them (F-A5).
- A large organization can limit a fleet manager or dispatcher to some fleets (**user assignments**); an assignment covers that fleet and every fleet below it, and without any they cover the whole organization.

@vi-name Đội xe
@vi Nhóm xe do một quản lý đội xe điều hành.
- Một **đội xe** là một nhóm bên trong một tổ chức và có thể nằm dưới một đội xe khác, nên mỗi khách hàng tự mô tả cơ cấu của mình (miền > chi nhánh > bãi xe...) bằng dữ liệu.
- Tại mỗi thời điểm, một xe thuộc tối đa một đội; một đội có nhiều xe. **Thành viên đội** lưu lại lịch sử.
- **Vùng địa lý (geofence)** của đội xe phát cảnh báo khi xe thành viên đi vào hoặc ra (F-A5).
- Tổ chức lớn có thể giới hạn quản lý đội xe hoặc điều vận trong một số đội (**phân công người dùng**); mỗi phân công bao gồm đội đó và mọi đội nằm dưới; nếu không có phân công, họ quản lý toàn bộ tổ chức.
'''
}

// ===========================================================================
// charging_stations: locations, chargers, EVSE/connector topology and OCPP (F-C1, F-G2)
// ===========================================================================

Table charging_locations {
  location_id uuid [pk, note: 'Internal ID of the location. @vi Mã nội bộ của trạm sạc. @example 2c7e5a90-6d1b-4f3a-8e2c-9b0d4a6f1c55']
  organization_id uuid [not null, note: 'Organization that owns the location (CS-10): G3\'s internal organization for its own network, a customer for its own chargers. Its chargers run on our gateway either way, so everything there goes through our system. Charger fault and offline alerts go to the users holding the OPERATIONS role in this organization (CS-11). @vi Tổ chức sở hữu trạm (CS-10): tổ chức nội bộ của G3 với mạng lưới của mình, khách hàng với trụ sạc của họ. Trụ sạc luôn kết nối qua cổng của chúng ta, nên mọi hoạt động ở đó đều đi qua hệ thống. Cảnh báo lỗi và mất kết nối của trụ gửi tới người dùng giữ vai trò OPERATIONS của tổ chức này (CS-11). @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  display_name varchar(200) [not null, note: 'Name shown to drivers and in the portal. Not unique: the portal warns when the same owner already has a location with this name (CS-12). @vi Tên hiển thị cho tài xế và trên portal. Không bắt buộc duy nhất: portal cảnh báo khi cùng tổ chức sở hữu đã có trạm trùng tên (CS-12). @example Trạm sạc G3 Bình Dương']
  address varchar(500) [not null, note: 'Address as one free-text line (number, road or km marker, ward, province), shown in the app. The province, when a filter or report needs it, is derived by a tool from the coordinates or this text, not stored (CS-11). @vi Địa chỉ dạng một dòng văn bản tự do (số nhà, đường hoặc km, phường/xã, tỉnh), hiển thị trên ứng dụng. Tỉnh/thành, khi cần lọc hoặc báo cáo, được suy ra bằng công cụ từ tọa độ hoặc dòng này, không lưu riêng (CS-11). @example Km 1872+500 QL1A, xã Tân Lập, tỉnh Đồng Nai']
  coordinates "geography(POINT,4326)" [not null, note: 'GPS position of the map pin (WGS84 point, longitude first); required, so a location is entered only once its position is known (CS-12). Named after OCPI\'s Location.coordinates. @vi Vị trí GPS của điểm trên bản đồ (điểm WGS84, kinh độ trước); bắt buộc, nên trạm chỉ được nhập khi đã biết vị trí (CS-12). @example POINT(106.6519 10.9804)']
  is_public boolean [not null, note: 'TRUE: anyone may charge here and it is on the public map. FALSE (private): only members of the owner and of the organizations allowed in charging_location_access may charge, and it is shown only to them (CS-10, STN-12; OCPI publish). @vi TRUE: ai cũng sạc được và trạm hiện trên bản đồ công cộng. FALSE (riêng): chỉ thành viên của tổ chức sở hữu và của các tổ chức được cho phép trong charging_location_access mới sạc được và mới thấy trạm (CS-10, STN-12). @example true']
  status varchar(20) [not null, note: 'Set by a person (DM-25). ACTIVE: open; locations are always open 24/7, so there are no opening hours (CS-11). INACTIVE: closed, e.g. repairs, flooding or a holiday; the reason says which. A location that leaves the system is INACTIVE and soft-deleted. Values: ACTIVE | INACTIVE. @vi Do con người đặt (DM-25). ACTIVE: đang mở; trạm luôn mở 24/7 nên không có giờ hoạt động (CS-11). INACTIVE: tạm đóng, ví dụ sửa chữa, ngập nước hoặc nghỉ lễ; lý do cho biết trường hợp nào. Trạm rời hệ thống được chuyển sang INACTIVE và xóa mềm. @example ACTIVE']
  status_reason varchar(200) [note: 'Why the location has its current status, or why it left the system; NULL when ACTIVE. @vi Lý do của trạng thái hiện tại, hoặc lý do trạm rời hệ thống; NULL khi ACTIVE. @example Ngập nước sau bão, tạm đóng']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the location is no longer part of the system, because it left or was entered by mistake (DM-25); all its data is kept, and the reason is in status_reason. NULL while it is part of the system. @vi Thời điểm xóa mềm: trạm không còn thuộc hệ thống, do đã rời đi hoặc nhập nhầm (DM-25); mọi dữ liệu vẫn được giữ, lý do nằm trong status_reason. NULL khi còn thuộc hệ thống. @example NULL']
  indexes {
    coordinates [name: 'ix_charging_locations_coordinates', note: 'GIST; radius search (STN-06). Replaces ix_charging_stations_location']
    organization_id [name: 'ix_charging_locations_organization_id']
  }
  Note: '''@status planned @owner customer @features F-C1,F-D1 @tracked *
One place drivers go to charge: several chargers in a row (CS-09; OCPI
Location; "trạm sạc" in the app). Owned by one organization (CS-10). Always
open 24/7: no opening hours are stored, and a closed location is INACTIVE
with a reason (CS-11). A larger area of one organization holding several
locations (a site) has no table yet (deferred.md 91).
Check constraint: deleted_at IS NULL OR status = 'INACTIVE' (DM-25).
@vi-name Trạm sạc
@vi Một nơi tài xế tới sạc: nhiều trụ sạc đặt thành hàng (CS-09; Location của OCPI; "trạm sạc" trên ứng dụng). Thuộc một tổ chức (CS-10). Luôn mở 24/7: không lưu giờ hoạt động, trạm tạm đóng được chuyển sang INACTIVE kèm lý do (CS-11). Khu vực lớn hơn của một tổ chức gồm nhiều trạm (khu sạc) chưa có bảng (deferred.md 91). Ràng buộc kiểm tra: deleted_at IS NULL OR status = 'INACTIVE' (DM-25).'''
}

Table charging_location_access {
  access_id uuid [pk, note: 'Internal ID of the grant. @vi Mã nội bộ của lần cấp quyền. @example 0000002a-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  location_id uuid [not null, note: 'The private location. @vi Trạm riêng. @example 2c7e5a90-6d1b-4f3a-8e2c-9b0d4a6f1c55']
  allowed_organization_id uuid [not null, note: 'Organization whose members may charge at the location (organization level, not per driver, for now). Named apart from organization_id: it is the grantee, not the owner. @vi Tổ chức có thành viên được sạc tại trạm (theo tổ chức, chưa theo từng tài xế). Đặt tên khác organization_id vì đây là bên được cấp quyền, không phải chủ sở hữu. @example 7c1d9e4b-2a6f-4b8c-9d3e-5f0a1b2c3d44']
  granted_at timestamptz [not null, note: 'When the access was granted. @vi Thời điểm cấp quyền. @example 2026-10-06T02:00:00Z']
  granted_by uuid [not null, note: 'User of the owning organization (or G3 staff) who granted it. @vi Người dùng của tổ chức sở hữu (hoặc nhân viên G3) đã cấp quyền. @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  valid_until date [note: 'Last day the access is valid, inclusive, in Vietnam time, when a partner contract fixes it in advance (DM-23); NULL for no end date. After that day the system closes the row (revoked_at set, revoked_by NULL, revoke_reason "expired"), so a new grant to the same organization is possible (CS-13). @vi Ngày cuối cùng còn quyền (tính cả ngày đó, giờ Việt Nam), khi hợp đồng hợp tác định trước (DM-23); NULL nếu không có ngày kết thúc. Sau ngày đó hệ thống tự đóng dòng (điền revoked_at, revoked_by để NULL, revoke_reason "expired"), để có thể cấp quyền mới cho cùng tổ chức (CS-13). @example 2026-12-31']
  revoked_at timestamptz [note: 'When the access ended (revoked by a person, or closed by the system after valid_until or when the location left the system); NULL while in force. @vi Thời điểm hết quyền (bị thu hồi, hoặc hệ thống tự đóng sau valid_until hay khi trạm rời hệ thống); NULL khi còn hiệu lực. @example NULL']
  revoked_by uuid [note: 'Who revoked it; NULL while in force, or when the system ended it. @vi Ai đã thu hồi; NULL khi còn hiệu lực, hoặc khi hệ thống tự kết thúc. @example NULL']
  revoke_reason varchar(200) [note: 'Why the access ended; NULL while in force. Named after how the row ends, because the table has no status column (DM-28). @vi Lý do kết thúc quyền; NULL khi còn hiệu lực. Đặt tên theo cách dòng kết thúc vì bảng không có cột trạng thái (DM-28). @example Hết hợp đồng hợp tác']
  indexes {
    (location_id, allowed_organization_id) [unique, name: 'uq_charging_location_access_live', note: 'WHERE revoked_at IS NULL: one live grant per location and organization']
    allowed_organization_id [name: 'ix_charging_location_access_allowed_organization_id', note: 'Where may this organization charge?']
  }
  Note: '''@status planned @owner customer @features F-C1
Which other organizations may charge at a private location (CS-10, STN-12):
every member of an allowed organization may charge there; per-driver lists
are not modelled for now. Granted and revoked by the location's owner. Rows
are only ever closed, so there is no change history (DM-20). Who may charge
at a private location: members of its owner plus members of every
organization with a live row here whose valid_until has not passed. A grant
to the owner itself is refused by the service. Grants stay when the location
turns public (they have no effect then) and apply again if it turns private
(CS-13).
@vi-name Quyền sạc tại trạm riêng
@vi Những tổ chức khác được sạc tại một trạm riêng (CS-10, STN-12): mọi thành viên của tổ chức được cho phép đều sạc được; chưa có danh sách theo từng tài xế. Do tổ chức sở hữu trạm cấp và thu hồi. Dòng chỉ bị đóng, không bị sửa, nên không cần lịch sử thay đổi (DM-20). Ai được sạc tại trạm riêng: thành viên của tổ chức sở hữu và thành viên của mọi tổ chức có dòng còn hiệu lực ở đây và chưa quá valid_until. Không cấp quyền cho chính tổ chức sở hữu. Quyền được giữ khi trạm chuyển sang công cộng (khi đó không có tác dụng) và áp dụng lại nếu trạm trở về riêng (CS-13).'''
}

Ref: charging_locations.organization_id > organizations.organization_id [delete: restrict]
Ref: charging_location_access.location_id > charging_locations.location_id [delete: restrict]
Ref: charging_location_access.allowed_organization_id > organizations.organization_id [delete: restrict]
Ref: charging_location_access.granted_by > users.user_id [delete: restrict]
Ref: charging_location_access.revoked_by > users.user_id [delete: restrict]

Table charging_stations {
  station_id uuid [pk, note: 'Internal ID of the charging station: one charger (trụ sạc), one OCPP connection (CS-09). @vi Mã nội bộ của trụ sạc: một trụ, một kết nối OCPP (CS-09). @example 4b9d6f3a-2e8c-4a1b-9d5e-7f0c3a8b2d88']
  location_id uuid [not null, note: '@planned CS-09: The location (trạm) the charger stands at; the charger reads its owner through it (DM-24). @vi Trạm sạc nơi đặt trụ; trụ đọc tổ chức sở hữu qua trạm (DM-24). @example 2c7e5a90-6d1b-4f3a-8e2c-9b0d4a6f1c55']
  ocpp_identity varchar(255) [not null, unique, note: 'Name the charger uses in its OCPP WebSocket URL ("Charger ID" on the Willdigits screen), unique and never reused. @vi Tên trụ sạc dùng trong URL WebSocket OCPP ("Charger ID" trên màn hình Willdigits), duy nhất và không bao giờ dùng lại. @example WD-HCM-001']
  registered_serial_number varchar(100) [not null, note: '@planned CS-14: Serial number read from the charger\'s nameplate and entered at installation: the asset\'s identity for warranty (WAR-01), insurance and vendor support. Unique among chargers not deleted. The serial the charger reports at boot is kept apart in charging_station_state.serial_number; a mismatch is logged as a warning (a swapped controller board or a misconfigured charger). @vi Số serial đọc từ nhãn máy và nhập khi lắp đặt: định danh tài sản cho bảo hành (WAR-01), bảo hiểm và hỗ trợ của hãng. Duy nhất trong các trụ chưa xóa. Serial trụ tự báo khi khởi động được lưu riêng ở charging_station_state.serial_number; nếu khác nhau thì ghi cảnh báo (thay bo mạch điều khiển hoặc cấu hình sai). @example WD2409001234']
  physical_reference varchar(16) [note: '@planned CS-11: Short label printed on the unit and shown to drivers, e.g. "Trụ 1"; NULL until labelled (OCPI physical_reference). @vi Nhãn ngắn in trên trụ và hiển thị cho tài xế, ví dụ "Trụ 1"; NULL khi chưa dán nhãn. @example Trụ 1']
  display_name varchar(200) [not null, note: '@remove CS-09: Station name shown to drivers; now the location\'s display_name, and a charger has its physical_reference. @vi Tên trạm hiển thị cho tài xế; nay là display_name của trạm, còn trụ có physical_reference. @example Trạm sạc G3 Bình Dương']
  location "geography(POINT,4326)" [note: '@remove CS-09: GPS position; now charging_locations.coordinates. @vi Vị trí GPS; nay là charging_locations.coordinates. @example POINT(106.6519 10.9804)']
  max_power_kw numeric(6,2) [note: '@built-as power_rating_kw: Total output of the charger in kW, shared by its guns (a 240 kW dual-gun unit gives about 120 kW per gun when both are in use); NULL if unknown. Per-gun power and the connector standard go on the connectors (deferred.md 80). @vi Tổng công suất của trụ (kW), chia cho các súng (trụ 240 kW hai súng cấp khoảng 120 kW mỗi súng khi cả hai cùng sạc); NULL nếu chưa biết. Công suất và chuẩn đầu sạc theo từng súng nằm ở súng sạc (deferred.md 80). @example 240.00']
  connector_standard varchar(20) [note: '@remove CS-11: Plug standard; moves to each connector (deferred.md 80). @vi Chuẩn đầu sạc; chuyển sang từng súng sạc. @example CCS2']
  operating_hours varchar(100) [note: '@remove CS-11: Opening hours as free text; locations are always open 24/7. @vi Giờ hoạt động dạng văn bản; trạm luôn mở 24/7. @example 24/7']
  status varchar(20) [not null, note: '@planned CS-11: Set by a person (DM-25). ACTIVE: in service. INACTIVE: out of service, e.g. under repair; the reason says which. A charger that leaves the system is INACTIVE and soft-deleted. Whether it is online is computed from charging_station_state.last_seen_at. Values: ACTIVE | INACTIVE. @vi Do con người đặt (DM-25). ACTIVE: đang phục vụ. INACTIVE: ngừng phục vụ, ví dụ đang sửa chữa; lý do cho biết trường hợp nào. Trụ rời hệ thống được chuyển sang INACTIVE và xóa mềm. Trụ online hay không được tính từ charging_station_state.last_seen_at. @example ACTIVE']
  status_reason varchar(200) [note: '@planned DM-19: Why the charger has its current status; NULL when ACTIVE. @vi Lý do của trạng thái hiện tại; NULL khi ACTIVE. @example Hỏng mô-đun công suất, chờ linh kiện']
  maintenance_status chargingstationmaintenancestatus [not null, note: '@remove CS-11: Maintenance state set by an admin; replaced by status ACTIVE / INACTIVE with a reason. @vi Trạng thái bảo trì; thay bằng status ACTIVE / INACTIVE kèm lý do. @example OPERATIONAL']
  ocpp_protocol_version varchar(20) [note: '@remove CS-11: OCPP version of the latest connection; moves to charging_station_state. @vi Phiên bản OCPP của kết nối gần nhất; chuyển sang charging_station_state. @example ocpp1.6']
  vendor varchar(100) [note: '@remove CS-11: Vendor from BootNotification; moves to charging_station_state. @vi Hãng trụ sạc; chuyển sang charging_station_state. @example Willdigits']
  model varchar(100) [note: '@remove CS-11: Model from BootNotification; moves to charging_station_state. @vi Model trụ sạc; chuyển sang charging_station_state. @example WD-DC480']
  serial_number varchar(100) [note: '@remove CS-11: Serial number from BootNotification; moves to charging_station_state. @vi Số serial; chuyển sang charging_station_state. @example WD2409001234']
  firmware_version varchar(100) [note: '@remove CS-11: Firmware from BootNotification; moves to charging_station_state. @vi Firmware; chuyển sang charging_station_state. @example V2.3.7']
  last_boot_at timestamptz [note: '@remove CS-11: Latest accepted BootNotification; moves to charging_station_state. @vi BootNotification gần nhất; chuyển sang charging_station_state. @example 2026-09-14T22:00:05Z']
  last_seen_at timestamptz [note: '@remove CS-11: Latest message of any kind; moves to charging_station_state. @vi Bản tin gần nhất; chuyển sang charging_station_state. @example 2026-09-15T08:29:58Z']
  charger_status chargingconnectorstatus [note: '@remove CS-11: Whole-charger status (1.6J connector 0); moves to charging_station_state. @vi Trạng thái cả trụ (connector 0); chuyển sang charging_station_state. @example Available']
  charger_status_updated_at timestamptz [note: '@remove CS-11: When that status was reported; moves to charging_station_state. @vi Thời điểm báo trạng thái đó; chuyển sang charging_station_state. @example 2026-09-15T08:10:00Z']
  charger_error_code varchar(50) [note: '@remove CS-11: Whole-charger error code; moves to charging_station_state. @vi Mã lỗi của cả trụ; chuyển sang charging_station_state. @example NoError']
  charger_vendor_error_code varchar(100) [note: '@remove CS-11: Vendor error code for the whole charger; moves to charging_station_state. @vi Mã lỗi riêng của hãng cho cả trụ; chuyển sang charging_station_state. @example E0000']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When a person last edited the row (UTC); device reports go to charging_station_state and never change it. @vi Thời điểm con người sửa bản ghi gần nhất (UTC); báo cáo của thiết bị ghi vào charging_station_state và không làm thay đổi cột này. @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the charger is no longer part of the system, because it was removed or entered by mistake (DM-25); all its data is kept, and the reason is in status_reason. NULL while it is part of the system. @vi Thời điểm xóa mềm: trụ không còn thuộc hệ thống, do đã tháo đi hoặc nhập nhầm (DM-25); mọi dữ liệu vẫn được giữ, lý do nằm trong status_reason. NULL khi còn thuộc hệ thống. @example NULL']
  indexes {
    location [name: 'ix_charging_stations_location', note: 'GIST; replaced by ix_charging_locations_coordinates (CS-09)']
    deleted_at [name: 'ix_charging_stations_deleted_at']
    location_id [name: 'ix_charging_stations_location_id', note: 'Planned (CS-09)']
    registered_serial_number [unique, name: 'uq_charging_stations_live_registered_serial_number', note: 'Planned (CS-14): WHERE deleted_at IS NULL']
  }
  Note: '''@status built @owner customer @features F-C1,F-C2,F-D1,F-G2 @tracked *
One charger (trụ sạc): one OCPP connection, OCPP 2.0.1's "Charging Station"
and 1.6J's "Charge Point" (CS-09). It stands at one location and reads its
owner through it (CS-10). Profile only: what the charger reports (boot
information, liveness, whole-charger status) moves to charging_station_state
(DM-16, DM-17), which also ends the interim "SET updated_at = updated_at"
writes (CS-06).
Check constraint: deleted_at IS NULL OR status = 'INACTIVE' (DM-25).
@vi-name Trụ sạc
@vi Một trụ sạc: một kết nối OCPP, tức "Charging Station" của OCPP 2.0.1 và "Charge Point" của 1.6J (CS-09). Trụ đặt tại một trạm và đọc tổ chức sở hữu qua trạm (CS-10). Chỉ là hồ sơ: những gì trụ tự báo (thông tin khởi động, tín hiệu sống, trạng thái cả trụ) chuyển sang charging_station_state (DM-16, DM-17), nhờ đó bỏ cách ghi tạm "SET updated_at = updated_at" (CS-06). Ràng buộc kiểm tra: deleted_at IS NULL OR status = 'INACTIVE' (DM-25).'''
}

Table charging_station_state {
  station_id uuid [pk, note: 'The charger this state belongs to (1:1 with charging_stations), created with it. @vi Trụ sạc sở hữu trạng thái này (1:1 với charging_stations), tạo cùng trụ. @example 4b9d6f3a-2e8c-4a1b-9d5e-7f0c3a8b2d88']
  last_seen_at timestamptz [note: 'Latest message of any kind; whether the charger is online is computed from it at read time (CS-06). NULL before the first connection. @vi Bản tin bất kỳ gần nhất; trụ online hay không được tính từ cột này lúc đọc. NULL trước lần kết nối đầu tiên. @example 2026-09-15T08:29:58Z']
  last_boot_at timestamptz [note: 'Latest accepted BootNotification. @vi BootNotification được chấp nhận gần nhất. @example 2026-09-14T22:00:05Z']
  ocpp_protocol_version varchar(20) [note: 'OCPP version of the latest connection. @vi Phiên bản OCPP của kết nối gần nhất. @example ocpp1.6']
  vendor varchar(100) [note: 'Vendor as reported at boot. @vi Hãng trụ sạc theo báo cáo khi khởi động. @example Willdigits']
  model varchar(100) [note: 'Model as reported at boot. @vi Model theo báo cáo khi khởi động. @example WD-DC480']
  serial_number varchar(100) [note: 'Serial number as reported at boot; compared with charging_stations.registered_serial_number (CS-14). @vi Số serial theo báo cáo khi khởi động; được so với charging_stations.registered_serial_number (CS-14). @example WD2409001234']
  firmware_version varchar(100) [note: 'Firmware as reported at the latest boot; a change is logged. @vi Firmware theo lần khởi động gần nhất; thay đổi được ghi log. @example V2.3.7']
  charger_status varchar(20) [note: 'Status of the whole charger as reported, same values as the connector status; NULL before the first report. 1.6J: StatusNotification for connector 0 (CS-03). 2.0.1 has no connector 0: its adapter in the gateway fills this from its own messages (the charging station\'s availability in NotifyEvent, StatusNotification for EVSE 0) (CS-15). @vi Trạng thái của cả trụ theo báo cáo, cùng tập giá trị với trạng thái súng; NULL trước lần báo đầu tiên. 1.6J: StatusNotification cho connector 0 (CS-03). 2.0.1 không có connector 0: bộ chuyển đổi 2.0.1 trong cổng OCPP điền cột này từ các bản tin của nó (CS-15). @example Available']
  charger_status_updated_at timestamptz [note: 'When that status was last reported. @vi Thời điểm trạng thái đó được báo gần nhất. @example 2026-09-15T08:10:00Z']
  charger_error_code varchar(50) [note: 'Error code reported for the whole charger, as sent. @vi Mã lỗi của cả trụ, đúng như trụ gửi. @example NoError']
  charger_vendor_error_code varchar(100) [note: 'Vendor-specific error code for the whole charger. @vi Mã lỗi riêng của hãng cho cả trụ. @example E0000']
  Note: '''@status planned @owner customer @features F-C2,F-G2 @state-of charging_stations
What the charger reports about itself, written by the OCPP gateway, often and
with no explanation needed: boot information, liveness and the whole-charger
status (DM-16). Latest values only: the history of boots, firmware and status
is the raw log in charging_ocpp_messages, and an interpreted history table is
added only when a feature reads it often (CS-15).
@vi-name Trạng thái trụ sạc
@vi Những gì trụ sạc tự báo, do cổng OCPP ghi, thường xuyên và không cần giải thích: thông tin khởi động, tín hiệu sống và trạng thái cả trụ (DM-16). Chỉ giữ giá trị mới nhất: lịch sử khởi động, firmware và trạng thái là nhật ký bản tin gốc trong charging_ocpp_messages; bảng lịch sử đã diễn giải chỉ được thêm khi có tính năng đọc thường xuyên (CS-15).'''
}

Table charging_evses {
  evse_id uuid [pk, note: 'Internal ID of the EVSE. @vi Mã nội bộ của EVSE. @example 1e7a4c9f-6b3d-4e2a-8c5f-9d0b2e7a4c99']
  station_id uuid [not null, note: 'The charger (charging station) the EVSE belongs to. @vi Trụ sạc chứa EVSE. @example 4b9d6f3a-2e8c-4a1b-9d5e-7f0c3a8b2d88']
  ocpp_evse_id integer [not null, note: 'EVSE number used in OCPP, unique within the charger, positive. For OCPP 1.6J gun n is EVSE n (CS-03). @vi Số EVSE dùng trong OCPP, duy nhất trong trụ, là số dương. Với OCPP 1.6J súng n là EVSE n (CS-03). @example 1']
  emi3_evse_id varchar(48) [not null, note: '@planned CS-16: Public industry ID of the outlet in eMI3 format VN*<operator ID>*E<code> (OCPI EVSE.evse_id, up to 48 characters), assigned when the EVSE is set up. Unique among EVSEs not deleted: when the hardware is replaced, the new EVSE row takes over the same ID, so the public ID outlives the hardware. Named with its source as a prefix because evse_id is our primary key. The operator ID G3N is provisional until roaming. @vi Mã công khai theo chuẩn ngành của EVSE, định dạng eMI3 VN*<mã nhà vận hành>*E<mã> (OCPI EVSE.evse_id, tối đa 48 ký tự), gán khi khai báo EVSE. Duy nhất trong các EVSE chưa xóa: khi thay phần cứng, EVSE mới nhận lại đúng mã này, nên mã công khai tồn tại lâu hơn phần cứng. Mã nhà vận hành G3N là tạm thời cho tới khi kết nối liên mạng (roaming). @example VN*G3N*E0001A']
  status varchar(20) [not null, note: '@planned CS-16: Set by a person (DM-25). ACTIVE: in service. INACTIVE: taken out of service on its own, e.g. a damaged cable, while the rest of the charger keeps working; the reason says why. Sent to the charger as OCPP ChangeAvailability for this EVSE. An EVSE that leaves the system is INACTIVE and soft-deleted. Values: ACTIVE | INACTIVE. @vi Do con người đặt (DM-25). ACTIVE: đang phục vụ. INACTIVE: ngừng riêng EVSE này, ví dụ cáp hỏng, trong khi phần còn lại của trụ vẫn hoạt động; lý do cho biết vì sao. Gửi xuống trụ bằng lệnh OCPP ChangeAvailability cho EVSE này. EVSE rời hệ thống được chuyển sang INACTIVE và xóa mềm. @example ACTIVE']
  status_reason varchar(200) [note: '@planned DM-19: Why the EVSE is out of service; NULL when ACTIVE. @vi Lý do EVSE ngừng phục vụ; NULL khi ACTIVE. @example Cáp súng 2 bị dập, chờ thay']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the EVSE is no longer part of the system, because it was removed or entered by mistake (DM-25); all its data is kept, and the reason is in status_reason. NULL while it is part of the system. @vi Thời điểm xóa mềm: EVSE không còn thuộc hệ thống, do đã tháo đi hoặc nhập nhầm (DM-25); mọi dữ liệu vẫn được giữ, lý do nằm trong status_reason. NULL khi còn thuộc hệ thống. @example NULL']
  indexes {
    (station_id, deleted_at) [name: 'ix_charging_evses_station_deleted']
    (station_id, ocpp_evse_id) [unique, name: 'uq_charging_evses_station_ocpp_id']
    emi3_evse_id [unique, name: 'uq_charging_evses_live_emi3_evse_id', note: 'Planned (CS-16): WHERE deleted_at IS NULL']
  }
  Note: '''@status built @owner customer @features F-C1,F-G2 @tracked *
One EVSE: an outlet that charges one truck at a time, with one or more
connectors of which only one is used at a time (CS-09). For our OCPP 1.6J
charger each gun is one EVSE with one connector (CS-03). Owned through its
charger and location (CS-10). Plug standard and power are per connector;
a label for the driver, if ever needed, goes on the connector (CS-16).
Check constraint: deleted_at IS NULL OR status = 'INACTIVE' (DM-25).
@vi-name EVSE (cụm cấp điện)
@vi Một EVSE: một đầu ra sạc cho một xe tại một thời điểm, có một hoặc nhiều súng nhưng mỗi lúc chỉ dùng một súng (CS-09). Với trụ OCPP 1.6J của chúng ta, mỗi súng là một EVSE có một đầu cắm (CS-03). Thuộc chủ sở hữu qua trụ và trạm (CS-10). Chuẩn đầu cắm và công suất theo từng súng; nhãn cho tài xế, nếu cần, đặt ở súng (CS-16). Ràng buộc kiểm tra: deleted_at IS NULL OR status = 'INACTIVE' (DM-25).'''
}

Table charging_connectors {
  connector_id uuid [pk, note: 'Internal ID of the connector (one physical gun). @vi Mã nội bộ của súng sạc (một súng vật lý). @example 0f3c8e5b-7d1a-4b9c-a2e6-4f8d1c0b3eaa']
  evse_id uuid [not null, note: 'EVSE the connector belongs to. @vi EVSE chứa súng sạc. @example 1e7a4c9f-6b3d-4e2a-8c5f-9d0b2e7a4c99']
  ocpp_connector_id integer [not null, note: 'Connector number used in OCPP, unique within the EVSE, positive (1 for each gun of our 1.6J charger). @vi Số súng dùng trong OCPP, duy nhất trong EVSE, là số dương (1 với mỗi súng của trụ 1.6J). @example 1']
  standard varchar(30) [not null, note: '@planned CS-17: Plug standard, with OCPI ConnectorType names; entered by a person at setup from the gun\'s nameplate or the purchase order, because OCPP 1.6J never reports it and OCPP 2.0.1\'s ConnectorType has no GB/T value (a 2.0.1 report is only a cross-check). The app shows the short name (CCS2, GB/T). Values: IEC_62196_T2_COMBO (CCS2) | GBT_DC | CHADEMO | CHAOJI | IEC_62196_T1_COMBO (CCS1); MCS added when megawatt chargers come. @vi Chuẩn đầu cắm, theo tên ConnectorType của OCPI; do con người nhập khi khai báo, từ nhãn trên súng hoặc đơn mua hàng, vì OCPP 1.6J không bao giờ báo và ConnectorType của OCPP 2.0.1 không có GB/T. Ứng dụng hiển thị tên ngắn (CCS2, GB/T). @example IEC_62196_T2_COMBO']
  max_power_kw numeric(6,2) [not null, note: '@planned CS-17: Highest power this gun can deliver, in kW, from its nameplate; the charger\'s max_power_kw is shared between its guns, so the real power is the lower of the two and of what the truck asks for (deferred.md 80). @vi Công suất cao nhất súng này cấp được (kW), theo nhãn; max_power_kw của trụ được chia cho các súng, nên công suất thực là giá trị nhỏ hơn giữa hai giá trị đó và mức xe yêu cầu. @example 240.00']
  max_voltage_v integer [not null, note: '@planned CS-17: Highest output voltage in volts, from the nameplate; tells whether the gun suits an 800 V truck (OCPI max_voltage). @vi Điện áp ra cao nhất (V), theo nhãn; cho biết súng có hợp với xe 800 V không. @example 1000']
  max_current_a integer [not null, note: '@planned CS-17: Highest output current in amperes, from the nameplate (OCPI max_amperage). @vi Dòng ra cao nhất (A), theo nhãn. @example 250']
  status chargingconnectorstatus [note: '@remove CS-17: Live status from the latest StatusNotification; moves to charging_connector_state. @vi Trạng thái trực tiếp; chuyển sang charging_connector_state. @example Charging']
  status_updated_at timestamptz [note: '@remove CS-17: When that status was reported; moves to charging_connector_state. @vi Thời điểm báo trạng thái; chuyển sang charging_connector_state. @example 2026-09-15T08:31:00Z']
  error_code varchar(50) [note: '@remove CS-17: Error code from the latest report; moves to charging_connector_state. @vi Mã lỗi theo báo cáo gần nhất; chuyển sang charging_connector_state. @example NoError']
  vendor_error_code varchar(100) [note: '@remove CS-17: Vendor-specific error code; moves to charging_connector_state. @vi Mã lỗi riêng của hãng; chuyển sang charging_connector_state. @example E0000']
  status_info varchar(50) [note: '@remove CS-17: Free-text info from the latest report; moves to charging_connector_state. @vi Thông tin văn bản tự do; chuyển sang charging_connector_state. @example Cable locked']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When a person last edited the row (UTC); status reports go to charging_connector_state. @vi Thời điểm con người sửa bản ghi gần nhất (UTC); báo cáo trạng thái ghi vào charging_connector_state. @example 2026-09-10T07:15:00Z']
  deleted_at timestamptz [note: 'Soft-delete time: the gun is no longer part of the system, because it was removed or entered by mistake (DM-25); all its data is kept. NULL while it is part of the system. A gun is taken out of service through its EVSE\'s status. @vi Thời điểm xóa mềm: súng không còn thuộc hệ thống, do đã tháo đi hoặc nhập nhầm (DM-25); mọi dữ liệu vẫn được giữ. NULL khi còn thuộc hệ thống. Súng ngừng phục vụ qua trạng thái của EVSE. @example NULL']
  indexes {
    (evse_id, deleted_at) [name: 'ix_charging_connectors_evse_deleted']
    (evse_id, ocpp_connector_id) [unique, name: 'uq_charging_connectors_evse_ocpp_id']
  }
  Note: '''@status built @owner customer @features F-C1,F-C2 @tracked *
One physical gun (plug): its standard and its power (CS-17), owned through its
EVSE, charger and location. Profile only: the live status the charger reports
moves to charging_connector_state (DM-16, DM-17). No status of its own: a gun
is taken out of service through its EVSE (CS-16). A driver-facing label, if
ever needed, goes here (physical_reference); AC/DC and cable/socket are not
stored while every G3 charger is DC with a fixed cable.
@vi-name Súng sạc
@vi Một súng (đầu cắm) vật lý: chuẩn đầu cắm và công suất (CS-17), thuộc chủ sở hữu qua EVSE, trụ và trạm. Chỉ là hồ sơ: trạng thái trực tiếp do trụ báo chuyển sang charging_connector_state (DM-16, DM-17). Không có trạng thái riêng: súng ngừng phục vụ qua EVSE (CS-16). Nhãn cho tài xế, nếu cần, đặt ở đây (physical_reference); không lưu AC/DC và cáp/ổ cắm khi mọi trụ của G3 đều là DC có cáp liền.'''
}

Table charging_connector_state {
  connector_id uuid [pk, note: 'The gun this state belongs to (1:1 with charging_connectors), created with it. @vi Súng sạc sở hữu trạng thái này (1:1 với charging_connectors), tạo cùng súng. @example 0f3c8e5b-7d1a-4b9c-a2e6-4f8d1c0b3eaa']
  status varchar(20) [note: 'Live status from the latest StatusNotification, as reported; NULL before the first report. Same values as today (CS-04): OCPP 2.0.1\'s Available, Occupied, Reserved, Unavailable, Faulted plus 1.6J\'s Preparing, Charging, SuspendedEV, SuspendedEVSE, Finishing. A gun is free only when Available. @vi Trạng thái trực tiếp theo StatusNotification gần nhất, đúng như trụ báo; NULL trước lần báo đầu tiên. Cùng tập giá trị như hiện nay (CS-04). Súng chỉ trống khi Available. @example Charging']
  status_updated_at timestamptz [note: 'When that status was last reported. @vi Thời điểm trạng thái đó được báo gần nhất. @example 2026-09-15T08:31:00Z']
  error_code varchar(50) [note: 'Error code from the latest report, as sent; replaced by every report. @vi Mã lỗi theo báo cáo gần nhất, đúng như trụ gửi; bị thay mỗi lần báo. @example NoError']
  vendor_error_code varchar(100) [note: 'Vendor-specific error code from the latest report. @vi Mã lỗi riêng của hãng theo báo cáo gần nhất. @example E0000']
  status_info varchar(50) [note: 'Free-text info from the latest report. @vi Thông tin văn bản tự do theo báo cáo gần nhất. @example Cable locked']
  Note: '''@status planned @owner customer @features F-C2 @state-of charging_connectors
The live status of one gun as the charger reports it, written by the OCPP
gateway (DM-16). Latest values only: the history is the raw log in
charging_ocpp_messages (CS-15).
@vi-name Trạng thái súng sạc
@vi Trạng thái trực tiếp của một súng do trụ báo, do cổng OCPP ghi (DM-16). Chỉ giữ giá trị mới nhất: lịch sử là nhật ký bản tin gốc trong charging_ocpp_messages (CS-15).'''
}

Table charging_ocpp_messages {
  message_id uuid [pk, note: 'Internal ID of the log row. @vi Mã nội bộ của dòng nhật ký. @example 00000006-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  occurred_at timestamptz [pk, note: 'Our server\'s clock: when the gateway received the frame (CP_TO_CSMS) or sent it (CSMS_TO_CP); hypertable time column. The charger\'s own times are inside some payloads and go to the interpreted tables (status time, meter sample time, session start and end), so a frame replayed after an offline period shows its arrival here and its real time there (CS-18). @vi Đồng hồ của máy chủ: thời điểm cổng OCPP nhận bản tin (CP_TO_CSMS) hoặc gửi đi (CSMS_TO_CP); cột thời gian của bảng chuỗi thời gian. Thời gian riêng của trụ nằm trong nội dung một số bản tin và được ghi vào các bảng đã diễn giải, nên bản tin gửi lại sau khi mất kết nối có thời điểm đến ở đây và thời điểm thực ở đó (CS-18). @example 2026-09-15T08:30:00Z']
  station_id uuid [not null, note: 'Station the frame was exchanged with. @vi Trạm trao đổi bản tin. @example 4b9d6f3a-2e8c-4a1b-9d5e-7f0c3a8b2d88']
  ocpp_subprotocol varchar(20) [not null, note: 'OCPP version negotiated for the connection. @vi Phiên bản OCPP đã thỏa thuận cho kết nối. @example ocpp1.6']
  direction chargingocppmessagedirection [not null, note: 'From the charger (CP_TO_CSMS) or to it (CSMS_TO_CP). @vi Chiều bản tin: từ trụ sạc lên (CP_TO_CSMS) hay gửi xuống trụ (CSMS_TO_CP). @example CP_TO_CSMS']
  raw_frame text [not null, note: 'The exact frame text, never re-serialised. Contains RFID idTags: never copy into application logs. @vi Nội dung bản tin nguyên văn, không chuẩn hóa lại. Có chứa mã RFID idTag: không bao giờ chép vào log ứng dụng. @example [2,"19223201","Heartbeat",{}]']
  action varchar(50) [note: '@planned CS-18: Message type copied from the envelope of a request ([2, message ID, action, payload]), e.g. StatusNotification, RemoteStartTransaction; NULL for answers and errors (they carry no action) and for a frame that cannot be read. raw_frame stays the record. @vi Loại bản tin chép từ phần bao của một yêu cầu, ví dụ StatusNotification, RemoteStartTransaction; NULL với bản tin trả lời và báo lỗi (không có action) và với bản tin không đọc được. raw_frame vẫn là bản gốc. @example StatusNotification']
  ocpp_message_id varchar(36) [note: '@planned CS-18: The frame\'s own message ID from the envelope, on every frame; a request and its answer share it, so (station_id, ocpp_message_id) pairs them, e.g. our RemoteStartTransaction with the charger\'s Accepted. NULL for a frame that cannot be read. Not unique: the charger and the gateway number their requests separately. @vi Mã bản tin riêng trong phần bao, có ở mọi bản tin; yêu cầu và câu trả lời dùng chung mã này, nên (station_id, ocpp_message_id) ghép được chúng, ví dụ lệnh RemoteStartTransaction của chúng ta với câu trả lời Accepted của trụ. NULL với bản tin không đọc được. Không duy nhất: trụ và cổng OCPP đánh số yêu cầu riêng. @example 19223201']
  indexes {
    (station_id, occurred_at) [name: 'ix_charging_ocpp_messages_station_time']
    (station_id, action, occurred_at) [name: 'ix_charging_ocpp_messages_station_action_time', note: 'Planned (CS-18): the message viewer filtering by type (STN-15)']
    (station_id, ocpp_message_id) [name: 'ix_charging_ocpp_messages_station_message_id', note: 'Planned (CS-18): pairing a request with its answer']
  }
  Note: '''@status built @owner internal @features F-G2 @hypertable occurred_at
Every OCPP frame in both directions, verbatim and append-only.
@vi-name Nhật ký bản tin OCPP
@vi Mọi bản tin OCPP theo cả hai chiều, lưu nguyên văn, chỉ ghi thêm.'''
}

Table charging_station_configuration_captures {
  capture_id uuid [pk, note: 'Internal ID of one snapshot (photo) of a charger\'s settings. @vi Mã nội bộ của một lần chụp cấu hình trụ sạc. @example 00000008-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  command_id uuid [not null, unique, note: 'The GET_CONFIGURATION command that asked for this snapshot (CS-21), including the automatic one after boot; one command gives one snapshot. The charger, the request time and who asked are read from it. @vi Lệnh GET_CONFIGURATION đã yêu cầu lần chụp này (CS-21), kể cả lệnh tự động sau khi khởi động; mỗi lệnh cho một lần chụp. Trụ sạc, thời điểm yêu cầu và người yêu cầu được đọc từ lệnh. @example 0000000c-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  reason varchar(20) [not null, note: 'Why the snapshot was taken. BOOT: automatically after each boot (CO-05). ON_DEMAND: a person asked for it. AFTER_CHANGE: right after we changed a setting, to confirm the charger applied it (a push itself returns only a verdict, no values). Values: BOOT | ON_DEMAND | AFTER_CHANGE. @vi Lý do chụp. BOOT: tự động sau mỗi lần khởi động. ON_DEMAND: có người yêu cầu. AFTER_CHANGE: ngay sau khi đổi một cấu hình, để xác nhận trụ đã áp dụng (lệnh đổi chỉ trả về kết quả chấp nhận hay từ chối, không có giá trị). @example BOOT']
  ocpp_protocol_version varchar(20) [not null, note: 'Protocol of the connection the snapshot came over; tells how its entries are named (1.6J: a key only; 2.0.1: component and variable). @vi Giao thức của kết nối mà lần chụp đến qua; cho biết các dòng cấu hình được đặt tên thế nào (1.6J: chỉ có khóa; 2.0.1: thành phần và biến). @example ocpp1.6']
  ocpp_request_id integer [note: 'OCPP 2.0.1 only (CO-15): the requestId of GetBaseReport, which joins the several NotifyReport parts into this one snapshot; NULL for 1.6J (one answer). @vi requestId của GetBaseReport trong OCPP 2.0.1, dùng để ghép nhiều phần NotifyReport thành một lần chụp; NULL với 1.6J (một câu trả lời). @example NULL']
  captured_at timestamptz [note: 'When the answer (2.0.1: its last part) arrived; NULL while waiting or when it failed. @vi Thời điểm nhận câu trả lời (2.0.1: phần cuối cùng); NULL khi đang chờ hoặc thất bại. @example 2026-09-14T22:00:10Z']
  outcome varchar(20) [not null, note: 'Observed result, as the charger behaved (no reason column: observed, not decided). PENDING: asked, not complete yet. COMPLETE: every part received. FAILED: no answer in time, an error answer, or parts missing. Values: PENDING | COMPLETE | FAILED. @vi Kết quả quan sát được. PENDING: đã hỏi, chưa đủ. COMPLETE: đã nhận đủ. FAILED: không trả lời kịp, trả lời lỗi, hoặc thiếu phần. @example COMPLETE']
  indexes {
    ocpp_request_id [name: 'ix_charging_config_captures_ocpp_request_id', note: 'Finds the snapshot when a 2.0.1 NotifyReport part arrives, together with the command\'s charger']
  }
  Note: '''@status planned @owner internal @features F-G2
One snapshot of a charger\'s settings: one GetConfiguration answer (1.6J) or
one GetBaseReport answered in several NotifyReport parts (2.0.1). The settings
themselves are rows of charging_station_configuration_entries. Append-only:
comparing two snapshots shows what changed between them (CS-19). Every snapshot comes
from one GET_CONFIGURATION command, so the charger, the request time and
who asked are read from it (CS-21); the current settings of a charger are
its newest COMPLETE snapshot through the command's charger. Changing a
setting is a command too (CHANGE_CONFIGURATION, CS-20); an AFTER_CHANGE
snapshot checks that it was applied.
@vi-name Lần chụp cấu hình trụ
@vi Một lần chụp cấu hình của trụ sạc: một câu trả lời GetConfiguration (1.6J) hoặc một GetBaseReport được trả lời bằng nhiều phần NotifyReport (2.0.1). Các cấu hình nằm ở charging_station_configuration_entries. Chỉ ghi thêm: cấu hình hiện tại là lần chụp COMPLETE mới nhất, so hai lần chụp cho biết những gì đã đổi (CS-19). Đổi một cấu hình là lệnh gửi xuống trụ, không phải một lần chụp. Mỗi lần chụp đến từ một lệnh GET_CONFIGURATION, nên trụ sạc, thời điểm yêu cầu và người yêu cầu được đọc từ lệnh (CS-21).'''
}

Table charging_station_configuration_entries {
  entry_id uuid [pk, note: 'Internal ID of the row: one value of one setting in one snapshot. @vi Mã nội bộ của dòng: một giá trị của một cấu hình trong một lần chụp. @example 00000007-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  station_id uuid [not null, note: '@remove CS-19: The charger; now read through the capture\'s command (CS-21). @vi Trụ sạc; nay đọc qua lệnh của lần chụp (CS-21). @example 4b9d6f3a-2e8c-4a1b-9d5e-7f0c3a8b2d88']
  capture_id uuid [not null, note: 'The snapshot this value belongs to. Built today as a plain grouping ID; it becomes a foreign key to charging_station_configuration_captures.capture_id in the refactor (CS-19; not drawn as a reference while that table is planned). @vi Lần chụp chứa giá trị này. @example 00000008-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  captured_at timestamptz [not null, note: '@remove CS-19: When the answer arrived; now on the capture. @vi Thời điểm nhận câu trả lời; nay nằm ở lần chụp. @example 2026-09-14T22:00:10Z']
  component_name varchar(50) [note: '@planned CS-19: OCPP 2.0.1 only (CO-15): the component, e.g. OCPPCommCtrlr, EVSE, Connector; NULL for 1.6J, which has keys only. @vi Thành phần OCPP 2.0.1, ví dụ OCPPCommCtrlr, EVSE, Connector; NULL với 1.6J (chỉ có khóa). @example NULL']
  component_instance varchar(50) [note: '@planned CS-19: OCPP 2.0.1 only (CO-15): instance of the component when it has several (2.0.1); NULL otherwise. @vi Bản thể của thành phần khi có nhiều (2.0.1); NULL nếu không. @example NULL']
  ocpp_evse_id integer [note: '@planned CS-19: OCPP 2.0.1 only (CO-15): EVSE the component sits on (2.0.1); NULL for the whole charger and for 1.6J. @vi EVSE chứa thành phần (2.0.1); NULL với cả trụ và với 1.6J. @example NULL']
  ocpp_connector_id integer [note: '@planned CS-19: OCPP 2.0.1 only (CO-15): connector the component sits on (2.0.1); NULL otherwise. @vi Súng chứa thành phần (2.0.1); NULL nếu không. @example NULL']
  variable_name varchar(100) [not null, note: '@built-as config_key: The setting: the 1.6J configuration key (e.g. HeartbeatInterval, AuthorizeRemoteTxRequests) or the 2.0.1 variable within its component. @vi Cấu hình: khóa cấu hình của 1.6J (ví dụ HeartbeatInterval) hoặc biến của 2.0.1 trong thành phần của nó. @example HeartbeatInterval']
  variable_instance varchar(50) [note: '@planned CS-19: OCPP 2.0.1 only (CO-15): instance of the variable (2.0.1); NULL otherwise. @vi Bản thể của biến (2.0.1); NULL nếu không. @example NULL']
  attribute_type varchar(10) [not null, note: '@planned CS-19: Which value of the setting: Actual (the current value; always for 1.6J), Target, MinSet or MaxSet (2.0.1). @vi Giá trị nào của cấu hình: Actual (giá trị hiện tại; luôn là Actual với 1.6J), Target, MinSet hoặc MaxSet (2.0.1). @example Actual']
  value text [note: 'The value as text, as the charger sent it; NULL if it sent none (e.g. a write-only setting). @vi Giá trị dạng chuỗi, đúng như trụ gửi; NULL nếu trụ không gửi (ví dụ cấu hình chỉ-ghi). @example 60']
  mutability varchar(10) [not null, note: '@planned CS-19: Whether the setting can be changed: READ_ONLY (a change is refused, e.g. NumberOfConnectors), READ_WRITE, WRITE_ONLY (2.0.1, e.g. a password: no value is shown). 1.6J readonly=true maps to READ_ONLY, false to READ_WRITE. @vi Cấu hình có đổi được không: READ_ONLY (lệnh đổi bị từ chối, ví dụ NumberOfConnectors), READ_WRITE, WRITE_ONLY (2.0.1, ví dụ mật khẩu: không hiện giá trị). Với 1.6J readonly=true là READ_ONLY, false là READ_WRITE. @example READ_WRITE']
  is_readonly boolean [not null, note: '@remove CS-19: Whether the charger reports the key as read-only; replaced by mutability, which also covers 2.0.1. @vi Trụ có báo khóa này là chỉ-đọc không; thay bằng mutability, bao cả 2.0.1. @example false']
  indexes {
    (station_id, captured_at) [name: 'ix_charging_config_entries_station_captured', note: 'Replaced by ix_charging_config_captures_station_captured (CS-19)']
    (capture_id, component_name, component_instance, ocpp_evse_id, ocpp_connector_id, variable_name, variable_instance, attribute_type) [unique, name: 'uq_charging_config_entries_capture_setting', note: 'Planned (CS-19): NULLS NOT DISTINCT; one value per setting and attribute in a snapshot']
  }
  Note: '''@status built @owner internal @features F-G2
One value of one setting in one snapshot (CS-19). Named the OCPP 2.0.1 way
(component + variable + attribute type), which also holds 1.6J: a 1.6J key
is a variable with no component, attribute Actual, and readonly mapped to
mutability. Settings are stored as the charger sent them; 1.6J keys are not
translated to 2.0.1 names. Append-only, through its capture.
@vi-name Cấu hình trụ sạc
@vi Một giá trị của một cấu hình trong một lần chụp (CS-19). Đặt tên theo cách của OCPP 2.0.1 (thành phần + biến + loại thuộc tính), cách này cũng chứa được 1.6J: khóa 1.6J là một biến không có thành phần, thuộc tính Actual, và readonly được quy đổi sang mutability. Cấu hình được lưu đúng như trụ gửi; khóa 1.6J không bị dịch sang tên 2.0.1. Chỉ ghi thêm, theo lần chụp của nó.'''
}

Table charging_station_commands {
  command_id uuid [pk, note: 'Internal ID of the command. @vi Mã nội bộ của lệnh. @example 0000000c-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  station_id uuid [not null, note: 'The charger the command goes to. @vi Trụ sạc nhận lệnh. @example 4b9d6f3a-2e8c-4a1b-9d5e-7f0c3a8b2d88']
  evse_id uuid [note: 'The gun the command targets (an unlock, taking one gun out of service); NULL for the whole charger. @vi Súng mà lệnh nhắm tới (mở khóa, ngừng phục vụ một súng); NULL nếu áp dụng cho cả trụ. @example 1e7a4c9f-6b3d-4e2a-8c5f-9d0b2e7a4c99']
  session_id uuid [note: 'The session the command is about: the PENDING session a remote start begins (CE-10), or the session a remote stop ends; NULL for every other command. @vi Phiên sạc mà lệnh liên quan: phiên PENDING mà lệnh bắt đầu từ xa khởi động (CE-10), hoặc phiên mà lệnh dừng từ xa kết thúc; NULL với mọi lệnh khác. @example e5a2d8f1-4b7c-4e9a-b3d6-2c1f0e9a8dbb']
  command_type varchar(30) [not null, note: 'What we asked, in one shape for both OCPP versions (CO-15); each version\'s adapter turns it into that version\'s message. Values: REMOTE_START | REMOTE_STOP | UNLOCK_CONNECTOR | RESET | CHANGE_AVAILABILITY | CHANGE_CONFIGURATION | GET_CONFIGURATION | TRIGGER_MESSAGE. One CHANGE_CONFIGURATION sets one setting, also in 2.0.1, so a row has one answer (CS-20). @vi Lệnh chúng ta yêu cầu, cùng một dạng cho cả hai phiên bản OCPP (CO-15); bộ chuyển đổi của từng phiên bản đổi nó thành bản tin của phiên bản đó. Giá trị: REMOTE_START | REMOTE_STOP | UNLOCK_CONNECTOR | RESET | CHANGE_AVAILABILITY | CHANGE_CONFIGURATION | GET_CONFIGURATION | TRIGGER_MESSAGE. Mỗi CHANGE_CONFIGURATION chỉ đặt một cấu hình, kể cả với 2.0.1, nên mỗi dòng có một câu trả lời (CS-20). @example REMOTE_START']
  parameters jsonb [note: 'What we sent besides the links: reset type, the availability asked for, the setting\'s key and value, the message to trigger, the 2.0.1 remoteStartId. The remote start\'s token is not copied: it is on the session. NULL when the command has none. @vi Những gì đã gửi ngoài các liên kết: kiểu khởi động lại, trạng thái phục vụ được yêu cầu, khóa và giá trị cấu hình, bản tin cần kích hoạt, remoteStartId của 2.0.1. Mã của lệnh bắt đầu từ xa không chép vào đây vì đã nằm ở phiên sạc. NULL nếu lệnh không có tham số. @example {"remote_start_id": 1042}']
  requested_by uuid [note: 'User who asked for it: the scanning driver for a remote start, an operator for a manual command; NULL when the system sent it on its own (e.g. the configuration request after boot, CO-05). @vi Người dùng đã yêu cầu: tài xế quét mã với lệnh bắt đầu từ xa, nhân viên vận hành với lệnh thủ công; NULL khi hệ thống tự gửi (ví dụ yêu cầu cấu hình sau khi khởi động, CO-05). @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  reason varchar(200) [note: 'Why, typed by the operator for a manual command; NULL for routine ones (a QR start, the configuration request after boot). @vi Lý do, do nhân viên vận hành nhập với lệnh thủ công; NULL với lệnh thường lệ (sạc bằng QR, yêu cầu cấu hình sau khi khởi động). @example Súng 2 kẹt, mở khóa cho tài xế']
  requested_at timestamptz [not null, note: 'When we created the command, by our server\'s clock. @vi Thời điểm tạo lệnh, theo đồng hồ máy chủ của chúng ta. @example 2026-09-15T08:29:11Z']
  ocpp_message_id varchar(36) [note: 'Message ID of the frame we sent; finds that frame and the charger\'s answer in charging_ocpp_messages (CS-18). NULL when nothing was sent. @vi Mã bản tin của khung đã gửi; dùng để tìm khung đó và câu trả lời của trụ trong charging_ocpp_messages (CS-18). NULL khi chưa gửi gì. @example 7f3a9c1e-2b4d-4e8a-9c6f-1d0e2b7a5c33']
  outcome varchar(20) [not null, note: 'Observed result, in one shape (no reason column: observed, not decided). PENDING: sent, waiting for the answer. ACCEPTED / REJECTED: the charger\'s verdict. ERROR: the charger answered with an OCPP error. TIMEOUT: no answer within the configured time. NOT_SENT: the charger was not connected. Values: PENDING | ACCEPTED | REJECTED | ERROR | TIMEOUT | NOT_SENT. @vi Kết quả quan sát được, cùng một dạng (không có cột lý do vì là quan sát, không phải quyết định). PENDING: đã gửi, đang chờ trả lời. ACCEPTED / REJECTED: trụ chấp nhận hoặc từ chối. ERROR: trụ trả lời bằng lỗi OCPP. TIMEOUT: không có trả lời trong thời gian cấu hình. NOT_SENT: trụ không kết nối. @example ACCEPTED']
  response_status varchar(30) [note: 'The charger\'s answer as sent, which may say more than accepted or rejected: Scheduled, RebootRequired, UnlockFailed, NotSupported, or an error code such as NotImplemented. NULL when there was no answer. @vi Câu trả lời của trụ, đúng như gửi, có thể chi tiết hơn chấp nhận hay từ chối: Scheduled, RebootRequired, UnlockFailed, NotSupported, hoặc một mã lỗi như NotImplemented. NULL khi không có trả lời. @example Accepted']
  answered_at timestamptz [note: 'When the answer or the timeout was recorded; NULL while PENDING or when NOT_SENT. @vi Thời điểm ghi nhận câu trả lời hoặc hết thời gian chờ; NULL khi PENDING hoặc NOT_SENT. @example 2026-09-15T08:29:12Z']
  indexes {
    (station_id, requested_at) [name: 'ix_charging_station_commands_station_requested', note: 'A charger\'s commands, newest first (STN-10)']
    session_id [name: 'ix_charging_station_commands_session_id', note: 'A session\'s remote start and stop']
  }
  Note: '''@status planned @owner internal @features F-G2,F-H1
Every command we send to a charger and its answer (STN-10, CS-20): who asked,
why, which session it is about, and outcomes that leave no frame in the raw
log (not sent, timed out). Commands are a capability of the OCPP gateway, so
the table lives in charging_stations, never in charging_sessions (which
never calls back into this domain). Written when the command is created and
updated once with the answer; no change history, no soft delete. Most
answers are a verdict only; the result arrives later as its own message (a
remote start's start message, a configuration read's snapshot). A T-Box
command table (telematic_commands, deferred.md 55) would take the same shape.
Check constraints (CS-20): outcome <> 'NOT_SENT' OR ocpp_message_id IS NULL;
outcome IN ('PENDING', 'NOT_SENT') OR answered_at IS NOT NULL.
@vi-name Lệnh gửi trụ sạc
@vi Mọi lệnh chúng ta gửi tới trụ sạc và câu trả lời (STN-10, CS-20): ai yêu cầu, vì sao, liên quan phiên sạc nào, và các kết quả không để lại bản tin trong nhật ký thô (chưa gửi, hết thời gian chờ). Gửi lệnh là khả năng của cổng OCPP nên bảng thuộc miền charging_stations, không thuộc charging_sessions. Ghi khi tạo lệnh và cập nhật một lần khi có trả lời; không có lịch sử thay đổi, không xóa mềm. Phần lớn câu trả lời chỉ là chấp nhận hay từ chối; kết quả thật đến sau bằng bản tin riêng. Bảng lệnh cho T-Box (telematic_commands, deferred.md 55) sẽ dùng cùng dạng. Ràng buộc kiểm tra (CS-20): lệnh NOT_SENT không có ocpp_message_id; lệnh đã có kết quả (không PENDING, không NOT_SENT) phải có answered_at.'''
}

Ref: charging_stations.location_id > charging_locations.location_id [delete: restrict]
Ref: charging_station_state.station_id - charging_stations.station_id [delete: restrict]
Ref: charging_evses.station_id > charging_stations.station_id [delete: restrict]
Ref: charging_connectors.evse_id > charging_evses.evse_id [delete: restrict]
Ref: charging_connector_state.connector_id - charging_connectors.connector_id [delete: restrict]
Ref: charging_ocpp_messages.station_id > charging_stations.station_id [delete: restrict]
Ref: charging_station_configuration_entries.station_id > charging_stations.station_id [delete: restrict]
Ref: charging_station_commands.station_id > charging_stations.station_id [delete: restrict]
Ref: charging_station_commands.evse_id > charging_evses.evse_id [delete: restrict]
Ref: charging_station_commands.session_id > charging_sessions.session_id [delete: restrict]
Ref: charging_station_commands.requested_by > users.user_id [delete: restrict]
Ref: charging_station_configuration_captures.command_id - charging_station_commands.command_id [delete: restrict]

TableGroup charging_stations {
  charging_locations
  charging_location_access
  charging_stations
  charging_station_state
  charging_evses
  charging_connectors
  charging_connector_state
  charging_ocpp_messages
  charging_station_configuration_captures
  charging_station_configuration_entries
  charging_station_commands
  Note: '''
The charging network and the OCPP link to each charger (terms: CS-09).

- A **location** (trạm) is one place drivers go, owned by one organization; it is public or private, and a private one lists the other organizations allowed to charge there (CS-10).
- A location has one or more **charging stations** (trụ: one charger, one OCPP connection); each has one or more **EVSEs**, and each EVSE one or more **connectors** (súng).
- Every OCPP frame and every configuration snapshot is kept against its charger.
- Every **command** we send to a charger is kept with its answer; a remote start or stop points to its session (CS-20).

@vi-name Trạm sạc
@vi Mạng lưới trạm sạc và kết nối OCPP tới từng trụ sạc (thuật ngữ: CS-09).
- Một **trạm** là một nơi tài xế tới sạc, thuộc một tổ chức; trạm công cộng hoặc riêng, trạm riêng liệt kê các tổ chức khác được sạc tại đó (CS-10).
- Một trạm có một hoặc nhiều **trụ sạc** (một kết nối OCPP); mỗi trụ có một hoặc nhiều **EVSE**, mỗi EVSE có một hoặc nhiều **súng sạc**.
- Mọi bản tin OCPP và mọi bản chụp cấu hình đều được lưu theo trụ.
- Mọi **lệnh** gửi tới trụ được lưu cùng câu trả lời; lệnh bắt đầu hoặc dừng từ xa trỏ tới phiên sạc của nó (CS-20).
'''
}

// ===========================================================================
// charging_sessions: session lifecycle and measurements (F-B2)
// ===========================================================================

Table charging_sessions {
  session_id uuid [pk, note: 'Internal ID of the charging session. @vi Mã nội bộ của phiên sạc. @example e5a2d8f1-4b7c-4e9a-b3d6-2c1f0e9a8dbb']
  station_id uuid [not null, note: 'The charger (charging station) where the session happens, known from the QR code at the scan. @vi Trụ sạc nơi diễn ra phiên sạc, biết được từ mã QR khi quét. @example 4b9d6f3a-2e8c-4a1b-9d5e-7f0c3a8b2d88']
  evse_id uuid [not null, note: 'EVSE used, set from the charger\'s start message. Planned (CE-10): nullable, NULL while PENDING and for an ABANDONED session, because the driver picks the gun on the charger\'s screen after the scan (CO-14). @vi EVSE được dùng, lấy từ bản tin bắt đầu của trụ. Dự kiến (CE-10): cho phép NULL, NULL khi PENDING và với phiên ABANDONED, vì tài xế chọn súng trên màn hình trụ sau khi quét (CO-14). @example 1e7a4c9f-6b3d-4e2a-8c5f-9d0b2e7a4c99']
  connector_id uuid [not null, note: 'Connector (gun) used, set from the charger\'s start message. Planned (CE-10): nullable, NULL while PENDING and for an ABANDONED session. @vi Súng sạc được dùng, lấy từ bản tin bắt đầu của trụ. Dự kiến (CE-10): cho phép NULL, NULL khi PENDING và với phiên ABANDONED. @example 0f3c8e5b-7d1a-4b9c-a2e6-4f8d1c0b3eaa']
  organization_id uuid [not null, note: '@planned CE-10: Organization that pays: the one the scanning user acted for, written once at the scan and never changed (DM-24 case C). Which wallet inside it pays is open decision D5. @vi Tổ chức trả tiền: tổ chức mà người quét mã đại diện, ghi một lần khi quét và không đổi (DM-24 trường hợp C). Ví nào trong tổ chức trả tiền là câu hỏi mở D5. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  started_by uuid [not null, note: '@planned CE-10: User who scanned the QR code in our app; every charge starts this way (CO-13). A start with a token we did not issue is refused and gets no row (CE-11). @vi Người dùng đã quét mã QR trong ứng dụng của chúng ta; mọi lần sạc đều bắt đầu như vậy (CO-13). Lần bắt đầu mang mã không do chúng ta cấp bị từ chối và không tạo dòng (CE-11). @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  vehicle_id uuid [note: '@planned CE-13: Truck being charged, taken at the scan from the scanning driver\'s open driving session (CHG-07); NULL when there is none (a guest truck we have no record of, or a driver who has not checked in). A VIN or MAC address reported by the charger may fill it later (deferred.md 90). @vi Xe được sạc, lấy khi quét mã từ phiên lái đang mở của tài xế quét mã (CHG-07); NULL nếu không có (xe khách vãng lai chưa có hồ sơ, hoặc tài xế chưa nhận xe). Sau này có thể lấy từ VIN hoặc địa chỉ MAC do trụ báo (deferred.md 90). @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  ocpp_transaction_id varchar(255) [not null, note: 'The charger\'s transaction ID, unique per charger: an OCPP 2.0.1 charger chooses its own (a string of up to 36 characters); for 1.6J it is our sequence number as text (CE-03). Planned (CE-10): varchar(36) and nullable, NULL while PENDING and for an ABANDONED session. @vi Mã giao dịch của trụ, duy nhất trong mỗi trụ: trụ OCPP 2.0.1 tự chọn (chuỗi tối đa 36 ký tự); với 1.6J là số thứ tự của chúng ta dạng chữ (CE-03). Dự kiến (CE-10): varchar(36) và cho phép NULL, NULL khi PENDING và với phiên ABANDONED. @example 1042']
  status chargingsessionstatus [not null, note: 'Lifecycle of the session; observed, so no status_reason (DM-19). PENDING: the scan was accepted, waiting for the charger. ACTIVE: transaction running. COMPLETED: stopped by the charger. ABANDONED: the remote start was refused or timed out, or no transaction followed within the configured window. Planned (CE-10): upper-case values; PENDING and ABANDONED are new. @vi Vòng đời của phiên; là trạng thái quan sát được nên không có status_reason (DM-19). PENDING: đã nhận lượt quét, chờ trụ. ACTIVE: giao dịch đang chạy. COMPLETED: trụ đã dừng. ABANDONED: lệnh bắt đầu từ xa bị từ chối hoặc hết thời gian chờ, hoặc không có giao dịch nào trong khoảng thời gian cấu hình. Dự kiến (CE-10): giá trị viết hoa; PENDING và ABANDONED là giá trị mới. @example COMPLETED']
  started_at timestamptz [not null, note: 'The charger\'s time of the start. Planned (CE-10): nullable, NULL while PENDING and for an ABANDONED session; the scan time is created_at. @vi Thời điểm bắt đầu theo đồng hồ của trụ. Dự kiến (CE-10): cho phép NULL, NULL khi PENDING và với phiên ABANDONED; thời điểm quét mã là created_at. @example 2026-09-15T08:30:00Z']
  ended_at timestamptz [note: 'The charger\'s time of the stop; NULL until COMPLETED. @vi Thời điểm dừng theo đồng hồ của trụ; NULL cho đến khi COMPLETED. @example 2026-09-15T09:45:00Z']
  meter_start_wh numeric(24,3) [note: 'Meter reading the charger declares at the start, in Wh; NULL while PENDING. @vi Chỉ số công tơ trụ báo lúc bắt đầu (Wh); NULL khi PENDING. @example 1520340.000']
  meter_end_wh numeric(24,3) [note: '@remove CE-12: Latest accepted meter reading, in Wh; a copy of the newest energy row in charging_session_measurements, read there instead. @vi Chỉ số công tơ mới nhất được chấp nhận (Wh); là bản sao của số đo điện năng mới nhất trong charging_session_measurements, nay đọc ở đó. @example 1712840.000']
  meter_end_sampled_at timestamptz [note: '@remove CE-12: When meter_end_wh was measured; the newest measurement\'s sampled_at. @vi Thời điểm đo meter_end_wh; là sampled_at của số đo mới nhất. @example 2026-09-15T09:44:30Z']
  energy_delivered_wh numeric(24,3) [note: '@remove CE-12: Derived: meter_stop_wh minus meter_start_wh, computed at read time; the billed kWh is frozen on the billing record (PAY-10). @vi Giá trị suy ra: meter_stop_wh trừ meter_start_wh, tính khi đọc; số kWh tính tiền được chốt trên bản ghi thanh toán (PAY-10). @example 192500.000']
  id_token varchar(20) [note: '@built-as id_tag: Identifier the charger reports for the transaction. For a QR start, the single-use token we generate at the scan and send in the remote start (at most 20 characters, the OCPP 1.6J idTag limit); the charger echoes it in its start message, which is how that message finds this row (CE-11). Later also a card number or an Autocharge ID (CHG-08); never copy it into application logs (IS-07). Planned (CE-10): varchar(255) (the OCPP 2.1 width) and required. @vi Mã định danh trụ báo cho giao dịch. Với lần sạc bằng QR, đó là mã dùng một lần chúng ta tạo khi quét và gửi trong lệnh bắt đầu từ xa (tối đa 20 ký tự, giới hạn idTag của OCPP 1.6J); trụ gửi lại mã này trong bản tin bắt đầu, nhờ đó bản tin tìm được dòng này (CE-11). Sau này còn là số thẻ hoặc mã Autocharge (CHG-08); không bao giờ chép vào log ứng dụng (IS-07). Dự kiến (CE-10): varchar(255) (độ dài của OCPP 2.1) và bắt buộc. @example G3K7Q2M9X4T1']
  stop_reason varchar(30) [note: 'The charger\'s stop reason, as sent (1.6J reason, 2.0.1 stoppedReason); NULL unless COMPLETED. Why a session was ABANDONED is not stored here: it belongs to the record of the remote-start command we sent (CS-18). @vi Lý do dừng theo trụ báo, giữ nguyên (reason của 1.6J, stoppedReason của 2.0.1); NULL nếu chưa COMPLETED. Lý do phiên bị ABANDONED không lưu ở đây mà thuộc về bản ghi lệnh bắt đầu từ xa chúng ta đã gửi (CS-18). @example EVDisconnected']
  meter_stop_wh numeric(24,3) [note: 'Meter reading the charger declares in its stop message, in Wh: the billing figure (CE-12), always stored as sent (CE-03). NULL until COMPLETED, or when the stop message carries none; billing then falls back to the newest measurement. @vi Chỉ số công tơ trụ báo trong bản tin dừng (Wh): con số dùng để tính tiền (CE-12), luôn lưu đúng như trụ gửi (CE-03). NULL cho đến khi COMPLETED, hoặc khi bản tin dừng không có; khi đó tính tiền theo số đo mới nhất. @example 1712860.000']
  created_at timestamptz [not null, note: 'When the row was created (UTC): the scan time for a QR start. @vi Thời điểm tạo bản ghi (UTC): là thời điểm quét mã với lần sạc bằng QR. @example 2026-09-15T08:29:10Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC); moves at each step of the session. @vi Thời điểm bản ghi được sửa gần nhất (UTC); thay đổi ở mỗi bước của phiên. @example 2026-09-15T09:45:00Z']
  indexes {
    ended_at [name: 'ix_charging_sessions_ended_at']
    (status, updated_at) [name: 'ix_charging_sessions_status_updated']
    (station_id, status) [name: 'ix_charging_sessions_station_status']
    (evse_id, status) [name: 'ix_charging_sessions_evse_status']
    (connector_id, status) [name: 'ix_charging_sessions_connector_status']
    started_at [name: 'ix_charging_sessions_started_at']
    (station_id, ocpp_transaction_id) [unique, name: 'uq_charging_sessions_station_transaction', note: 'Planned (CE-10): partial, WHERE ocpp_transaction_id IS NOT NULL']
    (station_id, id_token) [name: 'ix_charging_sessions_pending_token', note: 'Planned (CE-11): WHERE status = \'PENDING\'; matches a start message to its scan']
    (organization_id, started_at) [name: 'ix_charging_sessions_organization_started', note: 'Planned (CE-10): a customer\'s charging history (CHG-04)']
    vehicle_id [name: 'ix_charging_sessions_vehicle_id', note: 'Planned (CE-13)']
  }
  Note: '''@status built @owner two-party @features F-B2,F-C5
One charge on one connector of one charger, from the QR scan to the stop
(CE-10). The row is created PENDING when the driver scans the QR code in our
app, with the paying organization, the user and the single-use token we send
in the remote start; the charger's start message carrying that token on the
same charger turns it ACTIVE (CE-11), its stop message COMPLETED; ABANDONED
when the start never came. Live figures (kWh so far, battery %, peak power)
are read from charging_session_measurements; the price and the billed amount
belong to the billing record (PAY-10). No change history and no soft delete:
nobody edits a session.
Check constraints (CE-10): status NOT IN ('ACTIVE', 'COMPLETED') OR
(ocpp_transaction_id IS NOT NULL AND evse_id IS NOT NULL AND connector_id IS
NOT NULL AND started_at IS NOT NULL AND meter_start_wh IS NOT NULL);
status <> 'COMPLETED' OR ended_at IS NOT NULL; status NOT IN ('PENDING',
'ABANDONED') OR ocpp_transaction_id IS NULL.
@vi-name Phiên sạc
@vi Một lần sạc trên một súng của một trụ, từ lúc quét mã QR đến lúc dừng (CE-10). Dòng được tạo ở trạng thái PENDING khi tài xế quét mã QR trong ứng dụng của chúng ta, cùng tổ chức trả tiền, người quét và mã dùng một lần gửi trong lệnh bắt đầu từ xa; bản tin bắt đầu của chính trụ đó mang mã này chuyển phiên sang ACTIVE (CE-11), bản tin dừng chuyển sang COMPLETED; ABANDONED khi lần bắt đầu không xảy ra. Số liệu trực tiếp (kWh đã sạc, % pin, công suất cao nhất) đọc từ charging_session_measurements; đơn giá và số tiền thuộc bản ghi thanh toán (PAY-10). Không có lịch sử thay đổi và không xóa mềm: không ai sửa một phiên sạc. Ràng buộc kiểm tra (CE-10): phiên ACTIVE hoặc COMPLETED phải có mã giao dịch, EVSE, súng, thời điểm bắt đầu và chỉ số công tơ đầu; phiên COMPLETED phải có thời điểm kết thúc; phiên PENDING hoặc ABANDONED không có mã giao dịch.'''
}

Table charging_session_events {
  event_id uuid [pk, note: 'Internal ID of the event. @vi Mã nội bộ của sự kiện. @example 0000000a-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  event_occurred_at timestamptz [pk, note: 'When the event happened; hypertable time column. @vi Thời điểm xảy ra sự kiện; cột thời gian của bảng chuỗi thời gian. @example 2026-09-15T08:30:00Z']
  session_id uuid [not null, note: 'Session the event belongs to. @vi Phiên sạc chứa sự kiện. @example e5a2d8f1-4b7c-4e9a-b3d6-2c1f0e9a8dbb']
  event_type chargingsessioneventtype [not null, note: 'Lifecycle step the event represents. @vi Bước trong vòng đời phiên sạc mà sự kiện thể hiện. @example Started']
  seq_no integer [note: 'OCPP 2.0.1 only (CO-15): the per-transaction sequence number of TransactionEvent; NULL for 1.6J, which has none. @vi Số thứ tự theo giao dịch của OCPP; NULL nếu trụ không gửi. @example 0']
  indexes {
    (session_id, event_occurred_at, event_id) [name: 'ix_charging_session_events_session_time']
  }
  Note: '''@status built @owner two-party @features F-B2 @hypertable event_occurred_at @remove CE-15
Each Started / Updated / Ended event of a session. Dropped by the target
design (CE-15): for OCPP 1.6J it copies the session's start and end, the raw
OCPP log keeps every frame for audit, and no feature reads a session
timeline. OCPP 2.0.1 duplicate handling (seqNo) and charging-state periods
are designed when 2.0.1 support is built (deferred.md 78).
@vi-name Sự kiện phiên sạc
@vi Từng sự kiện Bắt đầu / Cập nhật / Kết thúc của một phiên sạc. Bị bỏ trong thiết kế đích (CE-15): với OCPP 1.6J bảng chỉ chép lại thời điểm bắt đầu và kết thúc của phiên, nhật ký OCPP thô đã giữ mọi bản tin để kiểm tra, và chưa tính năng nào đọc dòng thời gian của phiên. Việc loại bản tin trùng của OCPP 2.0.1 (seqNo) và các khoảng trạng thái sạc được thiết kế khi xây dựng hỗ trợ 2.0.1 (deferred.md 78).'''
}

Table charging_session_measurements {
  measurement_id uuid [pk, note: 'Internal ID of the measurement. @vi Mã nội bộ của số đo. @example 0000000b-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  sampled_at timestamptz [pk, note: 'The charger\'s time of the reading; hypertable time column. @vi Thời điểm đo theo đồng hồ của trụ; cột thời gian của bảng chuỗi thời gian. @example 2026-09-15T08:45:00Z']
  session_id uuid [not null, note: 'Session the measurement belongs to. Readings sent outside a session (clock-aligned samples) are kept only in the raw OCPP log (CE-06, deferred.md 77). @vi Phiên sạc chứa số đo. Số đo gửi ngoài phiên (lấy mẫu theo đồng hồ) chỉ được giữ trong nhật ký OCPP thô (CE-06, deferred.md 77). @example e5a2d8f1-4b7c-4e9a-b3d6-2c1f0e9a8dbb']
  measurand varchar(60) [not null, note: 'What was measured, by its OCPP name (Energy.Active.Import.Register, Power.Active.Import, Current.Import, Voltage, SoC, Temperature); a vendor-specific name is stored as sent. @vi Đại lượng được đo, theo tên của OCPP (Energy.Active.Import.Register, Power.Active.Import, Current.Import, Voltage, SoC, Temperature); tên riêng của hãng được lưu đúng như gửi. @example Energy.Active.Import.Register']
  value numeric(24,6) [not null, note: 'The reading. Energy is stored in Wh today. Planned (CE-14): every known measurand is converted by the gateway to one fixed unit when written: energy Wh (reactive varh), power W (reactive var, apparent VA), current A, voltage V, temperature Celsius, SoC and other percentages Percent; kilo-units are multiplied by 1000, Fahrenheit and K become Celsius. A vendor measurand is stored as sent. @vi Giá trị đo. Hiện điện năng được lưu bằng Wh. Dự kiến (CE-14): cổng OCPP đổi mọi đại lượng đã biết sang một đơn vị cố định khi ghi: điện năng Wh (phản kháng varh), công suất W (phản kháng var, biểu kiến VA), dòng điện A, điện áp V, nhiệt độ Celsius, SoC và các tỷ lệ khác Percent; đơn vị kilo nhân 1000, Fahrenheit và K đổi sang Celsius. Đại lượng riêng của hãng được lưu đúng như gửi. @example 1568340.000000']
  unit varchar(20) [note: 'Unit of value, in OCPP spelling. Planned (CE-14): always the fixed unit of a known measurand; as sent, or NULL, for a vendor one. @vi Đơn vị của giá trị, viết theo OCPP. Dự kiến (CE-14): luôn là đơn vị cố định của đại lượng đã biết; đúng như gửi, hoặc NULL, với đại lượng riêng của hãng. @example Wh']
  context varchar(30) [note: 'Why the charger sent the reading: Sample.Periodic, Transaction.Begin, Transaction.End, Sample.Clock, Trigger, Interruption.Begin, Interruption.End, Other. Planned (CE-14): required; the OCPP default Sample.Periodic is stored when the charger omits it. @vi Lý do trụ gửi số đo: Sample.Periodic, Transaction.Begin, Transaction.End, Sample.Clock, Trigger, Interruption.Begin, Interruption.End, Other. Dự kiến (CE-14): bắt buộc; lưu giá trị mặc định của OCPP là Sample.Periodic khi trụ không gửi. @example Sample.Periodic']
  phase varchar(10) [note: 'Electrical phase the value refers to (L1, L2, L3 ...); NULL for DC, which is every charger we have. @vi Pha điện của giá trị (L1, L2, L3 ...); NULL với sạc DC, là mọi trụ chúng ta đang có. @example NULL']
  measurement_location varchar(20) [note: '@built-as location: Where on the charging path the value was measured (OCPP calls it location): Outlet (the charger\'s output toward the truck: live progress and the billing fallback), Inlet (its input from the grid: losses and our electricity cost), Cable, EV (reported by the truck, e.g. SoC), Body (inside the charger cabinet). Every location is stored; features read Outlet, and EV for SoC, for now (CE-14). Renamed because location reads as a place (charging_locations). Planned (CE-14): required; the OCPP default Outlet is stored when the charger omits it. @vi Điểm đo trên đường sạc (OCPP gọi là location): Outlet (đầu ra của trụ về phía xe: tiến trình trực tiếp và số dự phòng khi tính tiền), Inlet (đầu vào từ lưới: tổn thất và chi phí điện của chúng ta), Cable, EV (do xe báo, ví dụ SoC), Body (bên trong tủ trụ). Mọi điểm đo đều được lưu; hiện các tính năng chỉ đọc Outlet, và EV cho SoC (CE-14). Đổi tên vì location dễ hiểu nhầm là địa điểm (charging_locations). Dự kiến (CE-14): bắt buộc; lưu giá trị mặc định của OCPP là Outlet khi trụ không gửi. @example Outlet']
  indexes {
    (session_id, measurand, sampled_at) [name: 'ix_charging_measurements_session_measurand_time']
  }
  Note: '''@status built @owner two-party @features F-B2 @hypertable sampled_at
Every reading a charger reports during a session (energy, power, current,
voltage, SoC, temperature ...), append-only. The gateway stores each known
measurand in one fixed unit and fills the OCPP defaults for a missing
context or location, so readers never convert units or guess defaults
(CE-14). No change history and no soft delete.
@vi-name Số đo phiên sạc
@vi Mọi giá trị đo trụ sạc gửi trong phiên (điện năng, công suất, dòng điện, điện áp, SoC, nhiệt độ...), chỉ ghi thêm. Cổng OCPP lưu mỗi đại lượng đã biết theo một đơn vị cố định và điền giá trị mặc định của OCPP khi thiếu context hoặc điểm đo, nên nơi đọc không phải đổi đơn vị hay đoán giá trị mặc định (CE-14). Không có lịch sử thay đổi và không xóa mềm.'''
}

Ref: charging_sessions.station_id > charging_stations.station_id [delete: restrict]
Ref: charging_sessions.evse_id > charging_evses.evse_id [delete: restrict]
Ref: charging_sessions.connector_id > charging_connectors.connector_id [delete: restrict]
Ref: charging_sessions.organization_id > organizations.organization_id [delete: restrict]
Ref: charging_sessions.started_by > users.user_id [delete: restrict]
Ref: charging_sessions.vehicle_id > vehicles.vehicle_id [delete: restrict]
Ref: charging_session_events.session_id > charging_sessions.session_id [delete: restrict]
Ref: charging_session_measurements.session_id > charging_sessions.session_id [delete: restrict]

TableGroup charging_sessions {
  charging_sessions
  charging_session_events
  charging_session_measurements
  Note: '''
What happened during each charge: events, meter readings, energy delivered.

- A **session** takes place on one connector of one charger. It is created when a driver scans the QR code on the charger in our app (CE-10) and records who scanned, which organization pays and, when the driver is checked in to a truck, that truck; the charger's start message then fills in the gun and the transaction (CE-11).
- Built today without that link (only a raw `id_tag`); it arrives with the refactor.
- A session has many **measurements**. Its **events** table is built but dropped by the target design (CE-15).

@vi-name Phiên sạc
@vi Những gì diễn ra trong mỗi lần sạc: sự kiện, chỉ số công tơ, điện năng đã cấp.
- Một **phiên sạc** diễn ra trên một súng sạc của một trụ. Phiên được tạo khi tài xế quét mã QR trên trụ bằng ứng dụng của chúng ta (CE-10) và ghi người quét, tổ chức trả tiền và, nếu tài xế đang nhận một xe, chiếc xe đó; sau đó bản tin bắt đầu của trụ điền súng sạc và giao dịch (CE-11).
- Bản đang chạy chưa có liên kết này (chỉ có mã `id_tag` thô); sẽ có khi tái cấu trúc.
- Một phiên sạc có nhiều **số đo**. Bảng **sự kiện** đã được xây dựng nhưng bị bỏ trong thiết kế đích (CE-15).
'''
}

// ===========================================================================
// notifications: operator-facing alerts (F-A2, F-F3)
// ===========================================================================

Table notifications {
  notification_id bigint [pk, increment, note: 'Auto-increasing ID; also the polling cursor (after_id). @vi Mã tự tăng; cũng là con trỏ khi truy vấn thông báo mới (after_id). @example 5821']
  organization_id uuid [note: '@planned: Customer organization that should see the notification. @vi Tổ chức khách hàng được xem thông báo. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  notification_type notificationtype [not null, note: 'Kind of event that raised it. @vi Loại sự kiện đã phát sinh thông báo. @example BATTERY_ALERT']
  severity notificationseverity [not null, note: 'How urgent it is, independent of type. @vi Mức độ khẩn cấp, độc lập với loại thông báo. @example WARNING']
  vehicle_id uuid [note: 'Vehicle it is about; NULL for non-vehicle notifications. @vi Xe mà thông báo nói tới; NULL với thông báo không liên quan xe. @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  title varchar(200) [not null, note: 'Short summary. @vi Tóm tắt ngắn. @example Pin còn 20%']
  body varchar(500) [not null, note: 'Longer description. @vi Mô tả chi tiết. @example Xe 51D-123.45 còn 20% pin. Trạm gần nhất: Trạm sạc G3 Bình Dương (8.4 km).']
  payload jsonb [not null, note: 'Type-specific details as JSON. @vi Chi tiết riêng theo loại thông báo, dạng JSON. @example {"threshold": 20, "soc": 19.8, "nearest_station_id": "4b9d6f3a-2e8c-4a1b-9d5e-7f0c3a8b2d88", "distance_m": 8400}']
  created_at timestamptz [not null, note: 'When the notification was raised. @vi Thời điểm phát sinh thông báo. @example 2026-09-15T08:30:00Z']
  read_at timestamptz [note: 'When an operator marked it read; NULL if unread. @vi Thời điểm người vận hành đánh dấu đã đọc; NULL nếu chưa đọc. @example NULL']
  indexes {
    vehicle_id [name: 'ix_notifications_vehicle_id']
  }
  Note: '''@status built @owner customer @features F-A2,F-A3,F-A4,F-J1,F-J3
One alert (battery, anomaly, SOH, device offline ...). One generic table;
each alert type is an enum value plus a payload shape.
Reviewed last in the design review, after every domain that raises alerts
(NT-08, which lists the points to settle).
@vi-name Thông báo
@vi Một cảnh báo (pin, bất thường, SOH, thiết bị mất kết nối...). Một bảng chung; mỗi loại cảnh báo là một giá trị enum và một cấu trúc payload. Được rà soát sau cùng, sau mọi miền phát sinh cảnh báo (NT-08, ghi các điểm cần quyết định).'''
}

Ref: notifications.organization_id > organizations.organization_id [delete: restrict]
Ref: notifications.vehicle_id > vehicles.vehicle_id [delete: cascade]

TableGroup notifications {
  notifications
  Note: '''
Alerts raised by other domains, stored for operators to poll.

- A **notification** is usually about one vehicle.
- It is not yet scoped to a recipient; the planned `organization_id` gives it to the organization that owns the vehicle.

@vi-name Thông báo & cảnh báo
@vi Cảnh báo do các miền khác phát sinh, được lưu để người vận hành truy vấn.
- Một **thông báo** thường nói về một xe.
- Hiện chưa gắn với người nhận; cột `organization_id` (dự kiến) sẽ gán thông báo cho tổ chức sở hữu xe.
'''
}

// ===========================================================================
// support: tickets, SOS, repair partners, maintenance (F-I1 ... F-I4)
// ===========================================================================

Table support_cases {
  case_id uuid [pk, note: 'Internal ID of the case. @vi Mã nội bộ của ca hỗ trợ. @example 0000000c-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  organization_id uuid [note: '@planned: Customer organization the case belongs to. @vi Tổ chức khách hàng của ca hỗ trợ. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  case_type supportcasetype [not null, note: 'Ordinary ticket or SOS. @vi Yêu cầu thường hay SOS. @example SOS']
  category supportcasecategory [not null, note: 'Business category of the problem. @vi Nhóm vấn đề theo nghiệp vụ. @example BREAKDOWN']
  channel supportcasechannel [not null, note: 'Where the case came in. @vi Kênh tiếp nhận ca. @example IN_APP']
  status supportcasestatus [not null, note: 'Current lifecycle status. @vi Trạng thái hiện tại trong vòng đời ca. @example ACKNOWLEDGED']
  vehicle_id uuid [note: 'Vehicle concerned, resolved from the VIN; NULL if not resolved. @vi Xe liên quan, suy ra từ VIN; NULL nếu không xác định được. @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  driver_id uuid [note: 'Driver who raised the case; NULL if not supplied. @vi Tài xế tạo ca; NULL nếu không cung cấp. @example 6e3b9d2a-4c1f-4e8b-9a7d-0c2e5f1b8d66']
  assigned_partner_id uuid [note: '@planned: Repair/rescue partner the case was dispatched to. @vi Đối tác sửa chữa/cứu hộ được điều phối xử lý ca. @example a9c6e3b1-5f2d-4a8c-b7e4-3d1f0a6c9bdd']
  vin varchar(17) [note: 'VIN as sent with the case, kept even if the vehicle changes later. @vi VIN gửi kèm ca, được giữ nguyên kể cả khi xe thay đổi sau này. @example LZGJLGR4XNX000123']
  error_code varchar(50) [note: 'Vehicle fault code active when the case was created, as sent. @vi Mã lỗi của xe tại thời điểm tạo ca, đúng như gửi lên. @example P0A80']
  location "geography(POINT,4326)" [note: 'GPS position when the case was created. Snapshot only; no spatial index. @vi Vị trí GPS khi tạo ca. Chỉ là ảnh chụp; không có chỉ mục không gian. @example POINT(106.7009 10.7769)']
  subject varchar(200) [note: 'Short subject; auto-filled for SOS. @vi Tiêu đề ngắn; tự điền với SOS. @example SOS: xe dừng giữa đường']
  description text [note: 'Free-text details. @vi Mô tả chi tiết dạng văn bản tự do. @example Xe báo lỗi pin và không khởi động được.']
  sla_response_minutes integer [not null, note: 'Response SLA in force when the case was created, in minutes. @vi SLA phản hồi (phút) có hiệu lực lúc tạo ca. @example 5']
  response_due_at timestamptz [not null, note: 'Deadline for the first response: creation time + SLA. @vi Hạn phản hồi đầu tiên: thời điểm tạo + SLA. @example 2026-09-15T08:35:00Z']
  first_responded_at timestamptz [note: 'When the case first left OPEN; NULL while waiting. @vi Thời điểm ca rời trạng thái OPEN lần đầu; NULL khi đang chờ. @example 2026-09-15T08:33:10Z']
  resolved_at timestamptz [note: 'When the case was resolved; NULL until then. @vi Thời điểm ca được giải quyết; NULL cho tới lúc đó. @example NULL']
  closed_at timestamptz [note: 'When the case was closed; NULL until then. @vi Thời điểm ca được đóng; NULL cho tới lúc đó. @example NULL']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-15T08:30:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-15T08:33:10Z']
  deleted_at timestamptz [note: 'Soft-delete time; NULL while the row is live. Rows are never hard-deleted. @vi Thời điểm xóa mềm; NULL khi bản ghi còn hiệu lực. Không bao giờ xóa hẳn. @example NULL']
  indexes {
    (vehicle_id, created_at) [name: 'ix_support_cases_vehicle_created_at']
    driver_id [name: 'ix_support_cases_driver_id']
    response_due_at [name: 'ix_support_cases_response_due_pending', note: 'WHERE first_responded_at IS NULL']
    deleted_at [name: 'ix_support_cases_deleted_at']
    status [name: 'ix_support_cases_status']
    vehicle_id [name: 'ix_support_cases_vehicle_id']
    (status, created_at) [name: 'ix_support_cases_status_created_at']
  }
  Note: '''@status built @owner customer @features F-I1,F-I2
One support request: a ticket or an SOS, with its SLA timeline.
Review of the support group postponed; the proposal is in SP-07.
@vi-name Ca hỗ trợ
@vi Một yêu cầu hỗ trợ: yêu cầu thường hoặc SOS, kèm mốc thời gian SLA.'''
}

Table repair_partners {
  partner_id uuid [pk, note: 'Internal ID of the partner. @vi Mã nội bộ của đối tác. @example a9c6e3b1-5f2d-4a8c-b7e4-3d1f0a6c9bdd']
  organization_id uuid [not null, note: 'The partner\'s row in organizations (type PARTNER); its technicians are users of that organization. @vi Dòng của đối tác trong bảng organizations (loại PARTNER); kỹ thuật viên của đối tác là người dùng thuộc tổ chức đó. @example 0000001b-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  name varchar(200) [not null, note: 'Partner name. @vi Tên đối tác. @example Garage Tín Phát - Thủ Đức']
  partner_type varchar(30) [not null, note: 'Kind of partner. Values: G3_WORKSHOP | DEALER | THIRD_PARTY (feature-list item 9). @vi Loại đối tác. Giá trị: G3_WORKSHOP | DEALER | THIRD_PARTY (mục 9 của feature-list). @example THIRD_PARTY']
  location "geography(POINT,4326)" [note: 'Base location (WGS84 point, longitude first). @vi Vị trí cơ sở (điểm WGS84, kinh độ trước). @example POINT(106.7700 10.8500)']
  phone_number varchar(20) [note: 'Contact number for dispatch. @vi Số liên hệ để điều phối. @example +842838123456']
  status varchar(20) [not null, note: 'Whether the partner accepts dispatches. @vi Đối tác có nhận điều phối không. @example ACTIVE']
  Note: '''@status planned @owner internal @features F-I4,F-I3
A workshop or rescue partner that support can dispatch to.
@vi-name Đối tác sửa chữa & cứu hộ
@vi Một xưởng hoặc đơn vị cứu hộ mà CSKH có thể điều phối tới.'''
}

Table maintenance_bookings {
  booking_id uuid [pk, note: 'Internal ID of the booking. @vi Mã nội bộ của lịch hẹn. @example 0000000d-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  organization_id uuid [not null, note: 'Customer organization that booked. @vi Tổ chức khách hàng đặt lịch. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  vehicle_id uuid [not null, note: 'Vehicle to be serviced. @vi Xe cần bảo dưỡng. @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  partner_id uuid [not null, note: 'Workshop booked. @vi Xưởng được đặt. @example a9c6e3b1-5f2d-4a8c-b7e4-3d1f0a6c9bdd']
  scheduled_at timestamptz [not null, note: 'Appointment time. @vi Thời gian hẹn. @example 2026-09-20T01:00:00Z']
  status varchar(20) [not null, note: 'Booking status. Values: REQUESTED | CONFIRMED | DONE | CANCELLED. @vi Trạng thái lịch hẹn. Giá trị: REQUESTED | CONFIRMED | DONE | CANCELLED. @example CONFIRMED']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-10T07:15:00Z']
  Note: '''@status planned @owner customer @features F-I3
A maintenance appointment for a vehicle at a partner workshop.
@vi-name Lịch bảo dưỡng
@vi Một lịch hẹn bảo dưỡng xe tại xưởng đối tác.'''
}

Ref: support_cases.organization_id > organizations.organization_id [delete: restrict]
Ref: support_cases.vehicle_id > vehicles.vehicle_id [delete: restrict]
Ref: support_cases.driver_id > drivers.driver_id [delete: restrict]
Ref: support_cases.assigned_partner_id > repair_partners.partner_id [delete: restrict]
Ref: repair_partners.organization_id - organizations.organization_id [delete: restrict]
Ref: maintenance_bookings.organization_id > organizations.organization_id [delete: restrict]
Ref: maintenance_bookings.vehicle_id > vehicles.vehicle_id [delete: restrict]
Ref: maintenance_bookings.partner_id > repair_partners.partner_id [delete: restrict]

TableGroup support {
  support_cases
  repair_partners
  maintenance_bookings
  Note: '''
Customer support: tickets, SOS, rescue dispatch, and maintenance bookings.

- A **support case** (ticket or SOS) is about a vehicle and/or a driver of one organization.
- Support can dispatch a case to a **repair partner** (F-I4).
- A customer books **maintenance** for a vehicle at a partner (F-I3).

@vi-name CSKH & cứu hộ
@vi Chăm sóc khách hàng: yêu cầu hỗ trợ, SOS, điều phối cứu hộ và đặt lịch bảo dưỡng.
- Một **ca hỗ trợ** (yêu cầu thường hoặc SOS) liên quan đến một xe và/hoặc một tài xế của một tổ chức.
- CSKH có thể điều phối ca tới một **đối tác sửa chữa** (F-I4).
- Khách hàng **đặt lịch bảo dưỡng** cho xe tại một đối tác (F-I3).
'''
}

// ===========================================================================
// policy: warranty-linked charging policies and violations (F-B1, F-B3)
// ===========================================================================

Table charging_policies {
  policy_id uuid [pk, note: 'Internal ID of the policy. @vi Mã nội bộ của chính sách. @example b8e5a2d9-3c6f-4b1e-a9d7-5f2c0e8b1aee']
  policy_code varchar(50) [not null, unique, note: 'Stable code, unique. @vi Mã cố định, duy nhất. @example WARRANTY-STD-2026']
  name varchar(100) [not null, note: 'Policy name. @vi Tên chính sách. @example Chính sách sạc bảo hành tiêu chuẩn']
  status varchar(20) [not null, note: 'Whether the policy is in use. @vi Chính sách có đang được dùng không. @example ACTIVE']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  Note: '''@status planned @owner internal @features F-B1
A named warranty charging policy defined by G3 Mobility.
@vi-name Chính sách sạc
@vi Một chính sách sạc bảo hành có tên do G3 Mobility định nghĩa.'''
}

Table charging_policy_versions {
  version_id uuid [pk, note: 'Internal ID of this version. @vi Mã nội bộ của phiên bản. @example c7d4f1a8-2b5e-4c9d-8f6a-1e3b0d7c4aff']
  policy_id uuid [not null, note: 'Policy this version belongs to. @vi Chính sách chứa phiên bản. @example b8e5a2d9-3c6f-4b1e-a9d7-5f2c0e8b1aee']
  version_no integer [not null, note: 'Version number within the policy, starting at 1. @vi Số phiên bản trong chính sách, bắt đầu từ 1. @example 3']
  soc_min_percent numeric(5,2) [note: 'Lowest SOC allowed before charging, in %. @vi SOC thấp nhất được phép trước khi sạc (%). @example 20.00']
  soc_max_percent numeric(5,2) [note: 'Highest SOC to charge to, in %. @vi SOC cao nhất được sạc tới (%). @example 90.00']
  allowed_window_start time [note: 'Start of the allowed daily charging window (local time). @vi Bắt đầu khung giờ sạc cho phép trong ngày (giờ địa phương). @example 22:00']
  allowed_window_end time [note: 'End of the allowed daily charging window (local time). @vi Kết thúc khung giờ sạc cho phép trong ngày (giờ địa phương). @example 06:00']
  max_power_kw numeric(6,2) [note: 'Maximum charging power allowed, in kW. @vi Công suất sạc tối đa được phép (kW). @example 240.00']
  effective_from timestamptz [not null, note: 'When this version takes effect. @vi Thời điểm phiên bản có hiệu lực. @example 2026-10-01T00:00:00Z']
  created_by uuid [not null, note: 'G3 user who published the version. @vi Người dùng G3 đã ban hành phiên bản. @example 9b2e7d4a-1c3f-4a8e-b6d2-5e0f1a9c3d22']
  indexes {
    (policy_id, version_no) [unique]
  }
  Note: '''@status planned @owner internal @features F-B1
One immutable version of a policy's rules. Every version is kept for audit.
@vi-name Phiên bản chính sách sạc
@vi Một phiên bản quy tắc không sửa được của chính sách. Mọi phiên bản đều được giữ để kiểm toán.'''
}

Table charging_policy_assignments {
  assignment_id uuid [pk, note: 'Internal ID of the assignment. @vi Mã nội bộ của lần áp dụng. @example 0000000e-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  organization_id uuid [not null, note: 'Customer organization the assignment belongs to. @vi Tổ chức khách hàng của lần áp dụng. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  policy_id uuid [not null, note: 'Policy applied. @vi Chính sách được áp dụng. @example b8e5a2d9-3c6f-4b1e-a9d7-5f2c0e8b1aee']
  vehicle_id uuid [note: 'Vehicle it applies to, if scoped to one vehicle. Exactly one of vehicle_id / fleet_id / vehicle_model is set. @vi Xe được áp dụng, nếu phạm vi là một xe. Chỉ đúng một trong vehicle_id / fleet_id / vehicle_model có giá trị. @example NULL']
  fleet_id uuid [note: 'Fleet it applies to, if scoped to a fleet. @vi Đội xe được áp dụng, nếu phạm vi là một đội. @example 8d5f2b7e-1a9c-4f3d-b8e2-6c0a4d9f1e77']
  vehicle_model varchar(50) [note: 'Model line it applies to, if scoped to a model. @vi Dòng xe được áp dụng, nếu phạm vi là một dòng xe. @example NULL']
  assigned_at timestamptz [not null, note: 'When the assignment began. @vi Thời điểm bắt đầu áp dụng. @example 2026-10-01T00:00:00Z']
  unassigned_at timestamptz [note: 'When it ended; NULL while in force. @vi Thời điểm kết thúc; NULL khi còn hiệu lực. @example NULL']
  Note: '''@status planned @owner customer @features F-B1
Which policy applies to a vehicle, a fleet, or a vehicle model.
@vi-name Áp dụng chính sách sạc
@vi Chính sách nào áp dụng cho một xe, một đội xe hay một dòng xe.'''
}

Table policy_violations {
  violation_id uuid [pk, note: 'Internal ID of the violation. @vi Mã nội bộ của vi phạm. @example 0000000f-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  organization_id uuid [not null, note: 'Customer organization of the vehicle. @vi Tổ chức khách hàng sở hữu xe. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  session_id uuid [not null, note: 'Charging session that broke the policy. @vi Phiên sạc đã vi phạm chính sách. @example e5a2d8f1-4b7c-4e9a-b3d6-2c1f0e9a8dbb']
  vehicle_id uuid [not null, note: 'Vehicle concerned. @vi Xe liên quan. @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  policy_version_id uuid [not null, note: 'Exact policy version that was broken. @vi Đúng phiên bản chính sách bị vi phạm. @example c7d4f1a8-2b5e-4c9d-8f6a-1e3b0d7c4aff']
  violation_type varchar(30) [not null, note: 'Which rule was broken. @vi Quy tắc nào bị vi phạm. @example SOC_ABOVE_MAX']
  detected_at timestamptz [not null, note: 'When the violation was detected. @vi Thời điểm phát hiện vi phạm. @example 2026-09-15T09:45:00Z']
  evidence jsonb [not null, note: 'Snapshot of the data that proves it, as JSON. @vi Ảnh chụp dữ liệu chứng minh vi phạm, dạng JSON. @example {"soc_end": 98.5, "soc_max": 90, "meter_stop_wh": 1712860}']
  Note: '''@status planned @owner customer @features F-B3,F-B6
A charging session that broke a policy, with evidence. Consequences are
still an open business question (feature-list item 3).
@vi-name Vi phạm chính sách sạc
@vi Một phiên sạc vi phạm chính sách, kèm bằng chứng. Hệ quả của vi phạm vẫn là câu hỏi kinh doanh còn mở (mục 3 của feature-list).'''
}

Ref: charging_policy_versions.policy_id > charging_policies.policy_id [delete: restrict]
Ref: charging_policy_versions.created_by > users.user_id [delete: restrict]
Ref: charging_policy_assignments.organization_id > organizations.organization_id [delete: restrict]
Ref: charging_policy_assignments.policy_id > charging_policies.policy_id [delete: restrict]
Ref: charging_policy_assignments.vehicle_id > vehicles.vehicle_id [delete: restrict]
Ref: charging_policy_assignments.fleet_id > fleets.fleet_id [delete: restrict]
Ref: policy_violations.organization_id > organizations.organization_id [delete: restrict]
Ref: policy_violations.session_id > charging_sessions.session_id [delete: restrict]
Ref: policy_violations.vehicle_id > vehicles.vehicle_id [delete: restrict]
Ref: policy_violations.policy_version_id > charging_policy_versions.version_id [delete: restrict]

TableGroup policy {
  charging_policies
  charging_policy_versions
  charging_policy_assignments
  policy_violations
  Note: '''
Warranty-linked charging rules and the violations detected against them.
Review parked until the battery warranty terms are known (open question 10 in the decision log).

- A **policy** has many immutable **versions**; the values are G3 Mobility's decision.
- A policy is **assigned** to a vehicle, a fleet, or a vehicle model.
- A **violation** links one charging session to the policy version it broke. This needs the session → vehicle link.

@vi-name Chính sách sạc (bảo hành)
@vi Quy tắc sạc gắn với bảo hành và các vi phạm được phát hiện.
- Một **chính sách** có nhiều **phiên bản** không sửa được; giá trị cụ thể do G3 Mobility quyết định.
- Chính sách được **áp dụng** cho một xe, một đội xe hoặc một dòng xe.
- Một **vi phạm** gắn một phiên sạc với đúng phiên bản chính sách bị vi phạm. Điều này cần liên kết phiên sạc → xe.
'''
}

// ===========================================================================
// billing: tariffs, payments, wallets, invoices, subscriptions (F-H1 ... F-H4, F-C8)
// ===========================================================================

Table tariffs {
  tariff_id uuid [pk, note: 'Internal ID of the tariff. @vi Mã nội bộ của biểu giá. @example f2b9e6c3-1d8a-4f5b-a3c7-9e0d4b1f8a10']
  organization_id uuid [not null, note: 'Owner: the organization whose locations this prices (BL-08): our internal organization for the public network, or a customer for its own private chargers (CS-10). Which internal organization owns the public network (G3 Energy or G3 Network, PAY-09) is data, not design. @vi Chủ sở hữu: tổ chức có các trạm được định giá bởi biểu giá này (BL-08): tổ chức nội bộ của chúng ta với mạng công cộng, hoặc khách hàng với các trụ riêng của mình (CS-10). Tổ chức nội bộ nào sở hữu mạng công cộng (G3 Energy hay G3 Network, PAY-09) là dữ liệu, không phải thiết kế. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  location_id uuid [note: 'The location it prices; NULL for the owner\'s default for all its locations. Must belong to the owner. Drivers see one price per place. @vi Trạm được định giá; NULL là biểu giá mặc định của chủ sở hữu cho mọi trạm của mình. Trạm phải thuộc chủ sở hữu. Tài xế thấy một giá cho mỗi địa điểm. @example NULL']
  name varchar(100) [not null, note: 'Name shown in the app and on receipts. @vi Tên hiển thị trên ứng dụng và biên nhận. @example Giá chuẩn 2026']
  currency char(3) [not null, note: 'ISO 4217 currency code. @vi Mã tiền tệ ISO 4217. @example VND']
  status varchar(20) [not null, note: 'Decided by the owner. ACTIVE: in use. INACTIVE: retired. Values: ACTIVE | INACTIVE. @vi Do chủ sở hữu quyết định. ACTIVE: đang dùng. INACTIVE: đã ngừng. @example ACTIVE']
  status_reason varchar(200) [note: 'Why the tariff has its status, e.g. why it was retired (DM-19); NULL when there is nothing to explain. @vi Lý do biểu giá có trạng thái hiện tại, ví dụ vì sao ngừng dùng (DM-19); NULL nếu không cần giải thích. @example NULL']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-01T02:00:00Z']
  updated_at timestamptz [not null, note: 'When the row was last changed (UTC). @vi Thời điểm bản ghi được sửa gần nhất (UTC). @example 2026-09-10T07:15:00Z']
  indexes {
    (organization_id, location_id) [unique, name: 'uq_tariffs_active_owner_location', note: 'WHERE status = ACTIVE, NULLS NOT DISTINCT: one active tariff per location and one default per owner']
    location_id [name: 'ix_tariffs_location_id']
  }
  Note: '''@status planned @owner customer @features F-C8,F-H1 @tracked *
Whose price it is and where it applies (BL-08); the prices themselves are
immutable versions in tariff_versions, so a receipt always shows the price
actually charged. The price at a location is its own ACTIVE tariff,
otherwise the owner's default. Change history on (retiring or renaming is a
decision); no soft delete (sessions point to its versions forever). Later:
a special price for one customer's contract, and a different price per
charger at the same location.
@vi-name Biểu giá
@vi Giá của ai và áp dụng ở đâu (BL-08); giá cụ thể là các phiên bản không sửa được trong tariff_versions, nên biên nhận luôn hiện đúng giá đã tính. Giá tại một trạm là biểu giá ACTIVE của chính trạm đó, nếu không có thì là biểu giá mặc định của chủ sở hữu. Bật lịch sử thay đổi; không xóa mềm. Sau này: giá riêng theo hợp đồng của một khách hàng, và giá khác nhau theo từng trụ trong cùng một trạm.'''
}

Table payments {
  payment_id uuid [pk, note: 'Internal ID of the payment. @vi Mã nội bộ của thanh toán. @example 3e1c8b5f-9a2d-4e7b-b4f1-6c0a9e3d2b21']
  organization_id uuid [not null, note: 'Customer organization that paid. @vi Tổ chức khách hàng đã thanh toán. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  session_id uuid [note: 'Charging session paid for; NULL for other payments. @vi Phiên sạc được thanh toán; NULL với các khoản khác. @example e5a2d8f1-4b7c-4e9a-b3d6-2c1f0e9a8dbb']
  amount numeric(14,2) [not null, note: 'Amount paid. @vi Số tiền đã thanh toán. @example 866250.00']
  currency char(3) [not null, note: 'ISO 4217 currency code. @vi Mã tiền tệ ISO 4217. @example VND']
  method varchar(20) [not null, note: 'Payment method. Values: VNPAY | MOMO | WALLET. @vi Phương thức thanh toán. Giá trị: VNPAY | MOMO | WALLET. @example VNPAY']
  gateway_reference varchar(100) [note: 'Reference/token from the payment gateway (never card data). (NF-05) @vi Mã tham chiếu/token của cổng thanh toán (không bao giờ lưu dữ liệu thẻ) (NF-05). @example VNP14592873']
  status varchar(20) [not null, note: 'Payment status. @vi Trạng thái thanh toán. @example SUCCEEDED']
  paid_at timestamptz [note: 'When the gateway confirmed the payment; NULL until then. @vi Thời điểm cổng thanh toán xác nhận; NULL cho tới lúc đó. @example 2026-09-15T09:46:12Z']
  created_at timestamptz [not null, note: 'When the row was created (UTC). @vi Thời điểm tạo bản ghi (UTC). @example 2026-09-15T09:45:00Z']
  Note: '''@status planned @owner customer @features F-H1
One payment through a gateway or wallet, usually for one session.
@vi-name Thanh toán
@vi Một lần thanh toán qua cổng thanh toán hoặc ví, thường cho một phiên sạc.'''
}

Table wallets {
  wallet_id uuid [pk, note: 'Internal ID of the wallet. @vi Mã nội bộ của ví. @example 5c3a0e7d-2f9b-4c1e-a8d3-7b6f0c2e9a32']
  organization_id uuid [not null, note: 'Customer organization the wallet belongs to. @vi Tổ chức khách hàng sở hữu ví. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  driver_id uuid [note: 'Driver it belongs to; NULL for the organization-level wallet. (decision D5) @vi Tài xế sở hữu ví; NULL với ví cấp tổ chức (quyết định D5). @example NULL']
  balance numeric(14,2) [not null, note: 'Current balance; must equal the sum of its transactions. @vi Số dư hiện tại; phải bằng tổng các giao dịch của ví. @example 12500000.00']
  currency char(3) [not null, note: 'ISO 4217 currency code. @vi Mã tiền tệ ISO 4217. @example VND']
  status varchar(20) [not null, note: 'Whether the wallet can be used. @vi Ví có dùng được không. @example ACTIVE']
  Note: '''@status planned @owner customer @features F-H2
A prepaid balance for a driver or for a whole organization.
@vi-name Ví
@vi Số dư trả trước của một tài xế hoặc của cả tổ chức.'''
}

Table wallet_transactions {
  transaction_id uuid [pk, note: 'Internal ID of the transaction. @vi Mã nội bộ của giao dịch. @example 00000010-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  organization_id uuid [not null, note: 'Customer organization of the wallet. @vi Tổ chức khách hàng của ví. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  wallet_id uuid [not null, note: 'Wallet affected. @vi Ví bị ảnh hưởng. @example 5c3a0e7d-2f9b-4c1e-a8d3-7b6f0c2e9a32']
  transaction_type varchar(20) [not null, note: 'Kind of money movement. Values: TOP_UP | CHARGE | WITHDRAW | REFUND. @vi Loại biến động tiền. Giá trị: TOP_UP | CHARGE | WITHDRAW | REFUND. @example CHARGE']
  amount numeric(14,2) [not null, note: 'Signed amount: positive adds money, negative removes it. @vi Số tiền có dấu: dương là cộng tiền, âm là trừ tiền. @example -866250.00']
  balance_after numeric(14,2) [not null, note: 'Wallet balance right after this transaction. @vi Số dư ví ngay sau giao dịch. @example 11633750.00']
  session_id uuid [note: 'Charging session paid, for CHARGE transactions. @vi Phiên sạc được trả tiền, với giao dịch CHARGE. @example e5a2d8f1-4b7c-4e9a-b3d6-2c1f0e9a8dbb']
  payment_id uuid [note: 'Gateway payment behind a top-up, if any. @vi Thanh toán qua cổng đứng sau một lần nạp tiền, nếu có. @example NULL']
  occurred_at timestamptz [not null, note: 'When the transaction happened. @vi Thời điểm phát sinh giao dịch. @example 2026-09-15T09:46:12Z']
  Note: '''@status planned @owner customer @features F-H2
Append-only movement of money in or out of a wallet.
@vi-name Giao dịch ví
@vi Biến động tiền vào/ra khỏi ví, chỉ ghi thêm.'''
}

Table invoices {
  invoice_id uuid [pk, note: 'Internal ID of the invoice. @vi Mã nội bộ của hóa đơn. @example 7e5c2a9f-4b1d-4e3a-9c8f-0d6b1e4a7c43']
  organization_id uuid [not null, note: 'Customer organization invoiced. @vi Tổ chức khách hàng được xuất hóa đơn. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  invoice_type varchar(20) [not null, note: 'Per-session retail invoice or monthly fleet invoice. Values: RETAIL | FLEET_MONTHLY. @vi Hóa đơn lẻ theo phiên hay hóa đơn tổng hợp tháng cho đội xe. Giá trị: RETAIL | FLEET_MONTHLY. @example FLEET_MONTHLY']
  period_start date [note: 'First day covered; NULL for a single-session invoice. @vi Ngày đầu kỳ; NULL với hóa đơn một phiên. @example 2026-09-01']
  period_end date [note: 'Last day covered; NULL for a single-session invoice. @vi Ngày cuối kỳ; NULL với hóa đơn một phiên. @example 2026-09-30']
  total_amount numeric(14,2) [not null, note: 'Invoice total including tax. @vi Tổng tiền hóa đơn, gồm thuế. @example 256800000.00']
  currency char(3) [not null, note: 'ISO 4217 currency code. @vi Mã tiền tệ ISO 4217. @example VND']
  einvoice_number varchar(50) [note: 'Number issued by the e-invoice provider; NULL until issued. @vi Số hóa đơn do nhà cung cấp hóa đơn điện tử cấp; NULL trước khi phát hành. @example C26TMP0001234']
  status varchar(20) [not null, note: 'Invoice status; ISSUED invoices are never edited. Values: DRAFT | ISSUED | ADJUSTED | CANCELLED. @vi Trạng thái hóa đơn; hóa đơn đã ISSUED không bao giờ bị sửa. Giá trị: DRAFT | ISSUED | ADJUSTED | CANCELLED. @example ISSUED']
  issued_at timestamptz [note: 'When the e-invoice was issued; NULL until then. @vi Thời điểm phát hành hóa đơn điện tử; NULL trước khi phát hành. @example 2026-10-01T03:00:00Z']
  Note: '''@status planned @owner customer @features F-H3,F-H4
A legal e-invoice. Once ISSUED it is never edited, only adjusted or cancelled
by a new invoice.
@vi-name Hóa đơn
@vi Một hóa đơn điện tử hợp lệ. Khi đã PHÁT HÀNH thì không sửa, chỉ điều chỉnh hoặc hủy bằng hóa đơn mới.'''
}

Table invoice_lines {
  line_id uuid [pk, note: 'Internal ID of the line. @vi Mã nội bộ của dòng hóa đơn. @example 00000011-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  invoice_id uuid [not null, note: 'Invoice the line belongs to. @vi Hóa đơn chứa dòng. @example 7e5c2a9f-4b1d-4e3a-9c8f-0d6b1e4a7c43']
  organization_id uuid [not null, note: 'Customer organization invoiced. @vi Tổ chức khách hàng được xuất hóa đơn. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  session_id uuid [note: 'Charging session billed on this line, if any. @vi Phiên sạc được tính tiền ở dòng này, nếu có. @example e5a2d8f1-4b7c-4e9a-b3d6-2c1f0e9a8dbb']
  subscription_id uuid [note: 'Subscription period billed on this line, if any. @vi Kỳ thuê bao được tính tiền ở dòng này, nếu có. @example NULL']
  description varchar(200) [not null, note: 'Line text printed on the invoice. @vi Nội dung dòng in trên hóa đơn. @example Sạc điện 192.5 kWh - Trạm sạc G3 Bình Dương - 15/09/2026']
  quantity numeric(14,3) [not null, note: 'Quantity billed (kWh or months). @vi Số lượng tính tiền (kWh hoặc số tháng). @example 192.500']
  unit_price numeric(12,2) [not null, note: 'Price per unit. @vi Đơn giá. @example 4500.00']
  amount numeric(14,2) [not null, note: 'Line amount: quantity × unit price. @vi Thành tiền: số lượng × đơn giá. @example 866250.00']
  Note: '''@status planned @owner customer @features F-H3,F-H4
One line of an invoice: a charging session or a subscription period.
@vi-name Dòng hóa đơn
@vi Một dòng của hóa đơn: một phiên sạc hoặc một kỳ thuê bao.'''
}

Table subscription_plans {
  plan_id uuid [pk, note: 'Internal ID of the plan. @vi Mã nội bộ của gói. @example 0c9a6e3d-8f5b-4c7e-a2d1-4b3f9e6c0a65']
  plan_code varchar(50) [not null, unique, note: 'Stable plan code, unique. @vi Mã gói cố định, duy nhất. @example STANDARD']
  name varchar(100) [not null, note: 'Plan name. @vi Tên gói. @example Gói Cơ bản']
  price_per_vehicle_month numeric(12,2) [not null, note: 'Monthly price per vehicle. The price itself is still open (feature-list item 7). @vi Giá theo xe theo tháng. Mức giá cụ thể vẫn còn mở (mục 7 của feature-list). @example 500000.00']
  currency char(3) [not null, note: 'ISO 4217 currency code. @vi Mã tiền tệ ISO 4217. @example VND']
  is_default boolean [not null, note: 'TRUE for the one plan that applies when an organization has no active subscription (the GUEST plan: charging, wallet, receipts, history). Exactly one plan is the default. @vi TRUE với gói duy nhất được áp dụng khi tổ chức không có thuê bao nào còn hiệu lực (gói GUEST: sạc, ví, biên nhận, lịch sử). Chỉ đúng một gói là mặc định. @example false']
  status varchar(20) [not null, note: 'Whether the plan can be sold. @vi Gói có đang được bán không. @example ACTIVE']
  Note: '''@status planned @owner internal @features F-H4
A plan: one row per offer (GUEST as the free default, STANDARD, ADVANCED,
PRO, ..., or a private plan for one customer); its features are in
plan_features. Pricing is per feature (see the billing domain note).
@vi-name Gói dịch vụ
@vi Một gói dịch vụ: mỗi gói là một dòng (GUEST là gói mặc định miễn phí, STANDARD, ADVANCED, PRO, ..., hoặc gói riêng cho một khách hàng); tính năng của gói nằm ở plan_features. Giá được tính theo từng tính năng (xem ghi chú của miền thanh toán).'''
}

Table subscriptions {
  subscription_id uuid [pk, note: 'Internal ID of the subscription. @vi Mã nội bộ của thuê bao. @example 9a7e4c1b-6d3f-4a5c-b0e8-2f1d7c9b3e54']
  organization_id uuid [not null, note: 'Customer organization subscribed. @vi Tổ chức khách hàng đăng ký. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  plan_id uuid [not null, note: 'Plan subscribed to. @vi Gói được đăng ký. @example 0c9a6e3d-8f5b-4c7e-a2d1-4b3f9e6c0a65']
  vehicle_id uuid [not null, note: 'Vehicle covered. @vi Xe được áp dụng. @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  started_at timestamptz [not null, note: 'When the subscription started. @vi Thời điểm bắt đầu thuê bao. @example 2026-09-01T00:00:00Z']
  ends_at timestamptz [note: 'When it ends; NULL if it renews until cancelled. @vi Thời điểm kết thúc; NULL nếu tự gia hạn cho tới khi hủy. @example NULL']
  status varchar(20) [not null, note: 'Subscription status; OVERDUE locks paid features. Values: ACTIVE | OVERDUE | EXPIRED | CANCELLED. @vi Trạng thái thuê bao; OVERDUE sẽ khóa các tính năng trả phí. Giá trị: ACTIVE | OVERDUE | EXPIRED | CANCELLED. @example ACTIVE']
  Note: '''@status planned @owner customer @features F-H4
One vehicle subscribed to a plan; overdue locks features.
@vi-name Thuê bao
@vi Một xe đăng ký một gói; quá hạn thanh toán sẽ khóa tính năng.'''
}

Ref: tariffs.organization_id > organizations.organization_id [delete: restrict]
Ref: tariffs.location_id > charging_locations.location_id [delete: restrict]
Ref: payments.organization_id > organizations.organization_id [delete: restrict]
Ref: payments.session_id > charging_sessions.session_id [delete: restrict]
Ref: wallets.organization_id > organizations.organization_id [delete: restrict]
Ref: wallets.driver_id > drivers.driver_id [delete: restrict]
Ref: wallet_transactions.organization_id > organizations.organization_id [delete: restrict]
Ref: wallet_transactions.wallet_id > wallets.wallet_id [delete: restrict]
Ref: wallet_transactions.session_id > charging_sessions.session_id [delete: restrict]
Ref: wallet_transactions.payment_id > payments.payment_id [delete: restrict]
Ref: invoices.organization_id > organizations.organization_id [delete: restrict]
Ref: invoice_lines.invoice_id > invoices.invoice_id [delete: restrict]
Ref: invoice_lines.organization_id > organizations.organization_id [delete: restrict]
Ref: invoice_lines.session_id > charging_sessions.session_id [delete: restrict]
Ref: invoice_lines.subscription_id > subscriptions.subscription_id [delete: restrict]
Ref: subscriptions.organization_id > organizations.organization_id [delete: restrict]
Ref: subscriptions.plan_id > subscription_plans.plan_id [delete: restrict]

Table plan_features {
  plan_feature_id uuid [pk, note: 'Internal ID of the row. @vi Mã nội bộ của dòng. @example 0000001d-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  plan_id uuid [not null, note: 'Plan that includes the feature. @vi Gói dịch vụ có tính năng này. @example 0c9a6e3d-8f5b-4c7e-a2d1-4b3f9e6c0a65']
  feature_code varchar(60) [not null, note: 'Feature included, from the feature list defined in code (the same list roles are built from). A user can use a feature only if one of their roles AND their plan include it. @vi Tính năng được bao gồm, lấy từ danh sách tính năng định nghĩa trong mã nguồn (cùng danh sách dùng để xây dựng vai trò). Người dùng chỉ dùng được một tính năng khi một vai trò của họ VÀ gói dịch vụ của họ đều có tính năng đó. @example view_adas_events']
  created_at timestamptz [not null, note: 'When the feature was added to the plan. @vi Thời điểm tính năng được thêm vào gói. @example 2026-09-01T02:00:00Z']
  indexes {
    (plan_id, feature_code) [unique, name: 'uq_plan_features_plan_feature']
  }
  Note: '''@status proposed @owner internal @features F-H4
Which features each plan includes. Plans are data, so G3 can create a new
plan (Pro, Max, a private plan for one customer) in the portal without a
developer; only a brand-new feature needs code.
@vi-name Tính năng của gói dịch vụ
@vi Mỗi gói dịch vụ gồm những tính năng nào. Gói dịch vụ là dữ liệu, nên G3 có thể tạo gói mới (Pro, Max, gói riêng cho một khách hàng) trên portal mà không cần lập trình viên; chỉ tính năng hoàn toàn mới mới cần viết mã.'''
}

Ref: plan_features.plan_id > subscription_plans.plan_id [delete: restrict]
Ref: subscriptions.vehicle_id > vehicles.vehicle_id [delete: restrict]

TableGroup billing {
  tariffs
  payments
  wallets
  wallet_transactions
  invoices
  invoice_lines
  subscription_plans
  plan_features
  subscriptions
  Note: '''
Money: energy prices, payments, prepaid wallets, e-invoices, and SaaS subscriptions.

- A **tariff** belongs to the organization owning the locations it prices (the owner's default, or one location); its prices are immutable **versions** (BL-08).
- A **payment** usually settles one charging session; a **wallet** belongs to an organization or one driver (D5).
- An **invoice** belongs to one organization and has **lines** for sessions or subscription periods.
- A **subscription** puts one vehicle on one **plan**.
- Billing a session requires knowing whose session it was.
- **Pricing direction (owner decision, 2026-10-03), tables designed in the billing review:** a catalog of a few dozen features, each with its own list price and pricing unit (per vehicle/month, per organization/month, per user, per message - e.g. SMS). Plans are bundles of features; public plans (GUEST as the free default, STANDARD, ADVANCED, PRO, ...) serve most customers, and a private custom plan can be built for one customer. A customer may also add single features on top of a plan (add-ons). Agreed prices are copied onto the subscription/add-on rows. What an organization can use = its plan's features + active add-ons, intersected with each person's role. Companies buy through our sales team; an individual (a guest's personal organization) buys self-service in the app. Each organization decides, per message service, whether push, SMS and e-mail are used (SMS only if its plan includes it); the fleet portal list is always on.

@vi-name Thanh toán & hóa đơn
@vi Tiền: giá điện, thanh toán, ví trả trước, hóa đơn điện tử và thuê bao SaaS.
- **Biểu giá** định giá điện cho toàn mạng hoặc từng trạm, theo khung giờ.
- Một **thanh toán** thường cho một phiên sạc; một **ví** thuộc một tổ chức hoặc một tài xế (D5).
- Một **hóa đơn** thuộc một tổ chức và có các **dòng hóa đơn** cho phiên sạc hoặc kỳ thuê bao.
- Một **thuê bao** đưa một xe vào một **gói dịch vụ**.
- Muốn tính tiền một phiên sạc phải biết phiên đó của ai.
- **Định hướng định giá (quyết định ngày 03/10/2026), bảng sẽ được thiết kế khi rà soát miền thanh toán:** danh mục khoảng vài chục tính năng, mỗi tính năng có giá niêm yết và đơn vị tính riêng (theo xe/tháng, theo tổ chức/tháng, theo người dùng, theo tin nhắn - ví dụ SMS). Gói dịch vụ là nhóm tính năng; các gói công khai (GUEST là gói mặc định miễn phí, STANDARD, ADVANCED, PRO, ...) phục vụ đa số khách hàng, và có thể tạo gói riêng cho một khách hàng. Khách hàng cũng có thể mua thêm từng tính năng ngoài gói (add-on). Giá đã thỏa thuận được chép vào dòng thuê bao/add-on. Tổ chức được dùng = tính năng của gói + add-on còn hiệu lực, giao với vai trò của từng người. Doanh nghiệp mua qua đội bán hàng của chúng ta; cá nhân (tổ chức cá nhân của khách vãng lai) tự mua trên app. Mỗi tổ chức tự chọn, cho từng loại thông tin, có gửi qua thông báo đẩy, SMS và email hay không (SMS chỉ khi gói có tính năng này); danh sách trên fleet portal luôn bật.
'''
}

// ===========================================================================
// scoring: driver safety scoring (F-K1)
// ===========================================================================

Table driver_scores {
  score_id uuid [pk, note: 'Internal ID of the score. @vi Mã nội bộ của điểm. @example 00000012-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  organization_id uuid [not null, note: 'Customer organization of the driver. @vi Tổ chức khách hàng của tài xế. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  driver_id uuid [not null, note: 'Driver scored. @vi Tài xế được chấm điểm. @example 6e3b9d2a-4c1f-4e8b-9a7d-0c2e5f1b8d66']
  week_start date [not null, note: 'Monday of the scored week. @vi Thứ Hai của tuần được chấm. @example 2026-09-14']
  score numeric(5,2) [not null, note: 'Safety score from 0 to 100. @vi Điểm an toàn từ 0 đến 100. @example 86.50']
  breakdown jsonb [note: 'Contribution of each factor, as JSON. @vi Mức đóng góp của từng yếu tố, dạng JSON. @example {"harsh_braking": -6.0, "speeding": -4.5, "continuous_driving": -3.0}']
  computed_at timestamptz [not null, note: 'When the score was calculated. @vi Thời điểm tính điểm. @example 2026-09-21T17:00:00Z']
  indexes {
    (driver_id, week_start) [unique]
  }
  Note: '''@status planned @owner customer @features F-K1
A driver's weekly safety score, computed from telemetry.
@vi-name Điểm tài xế
@vi Điểm an toàn hằng tuần của tài xế, tính từ dữ liệu vận hành xe.'''
}

Ref: driver_scores.organization_id > organizations.organization_id [delete: restrict]
Ref: driver_scores.driver_id > drivers.driver_id [delete: restrict]

TableGroup scoring {
  driver_scores
  Note: '''
Driver safety scoring from driving behaviour.

- A driver has one **score** per week, computed from telemetry by the vehicle they drove.

@vi-name Chấm điểm tài xế
@vi Chấm điểm an toàn cho tài xế từ hành vi lái xe.
- Mỗi tuần, mỗi tài xế có một **điểm**, tính từ dữ liệu vận hành của xe họ lái.
'''
}

// ===========================================================================
// unassigned: features with no domain decided yet
// ===========================================================================

Table promotion_campaigns {
  campaign_id uuid [pk, note: 'Internal ID of the campaign. @vi Mã nội bộ của chiến dịch. @example 00000013-5a6b-4c7d-8e9f-0a1b2c3d4e5f']
  name varchar(200) [not null, note: 'Campaign name. @vi Tên chiến dịch. @example Giảm 10% sạc đêm tháng 10']
  starts_at timestamptz [not null, note: 'When the campaign starts. @vi Thời điểm bắt đầu. @example 2026-10-01T00:00:00Z']
  ends_at timestamptz [note: 'When it ends; NULL if open-ended. @vi Thời điểm kết thúc; NULL nếu không thời hạn. @example 2026-10-31T16:59:59Z']
  target jsonb [note: 'Who receives it, as JSON criteria. @vi Đối tượng nhận, dạng tiêu chí JSON. @example {"vehicle_models": ["EVT-400"], "organizations": "all"}']
  status varchar(20) [not null, note: 'Campaign status. @vi Trạng thái chiến dịch. @example SCHEDULED']
  Note: '''@status planned @owner internal @features F-F4
A maintenance reminder or promotion campaign.
@vi-name Chiến dịch khuyến mãi
@vi Một chiến dịch nhắc bảo dưỡng hoặc khuyến mãi.'''
}

Table trips {
  trip_id uuid [pk, note: 'Internal ID of the trip. @vi Mã nội bộ của chuyến đi. @example 2e1c8a5f-0b7d-4e9c-b4a3-6d5f1e8c2b76']
  organization_id uuid [not null, note: 'Customer organization of the vehicle. @vi Tổ chức khách hàng sở hữu xe. @example 3f6c2a1e-8b4d-4e2a-9c1f-0a7d5b2e4c11']
  vehicle_id uuid [not null, note: 'Vehicle that made the trip. @vi Xe thực hiện chuyến. @example 7a4c1e9b-3d2f-4b8a-a6c5-1e0d9f8b7a44']
  driver_id uuid [note: 'Driver on the trip, if known. @vi Tài xế của chuyến, nếu biết. @example 6e3b9d2a-4c1f-4e8b-9a7d-0c2e5f1b8d66']
  started_at timestamptz [not null, note: 'When the trip started. @vi Thời điểm bắt đầu chuyến. @example 2026-09-15T00:30:00Z']
  ended_at timestamptz [note: 'When it ended; NULL while under way. @vi Thời điểm kết thúc; NULL khi đang chạy. @example 2026-09-15T06:10:00Z']
  declared_load_status varchar(20) [note: 'Load status the driver declared. Values: LOADED | EMPTY. @vi Trạng thái tải do tài xế khai báo. Giá trị: LOADED | EMPTY. @example LOADED']
  inferred_load_status varchar(20) [note: 'Load status inferred from telemetry. Values: LOADED | EMPTY. @vi Trạng thái tải suy ra từ dữ liệu vận hành. Giá trị: LOADED | EMPTY. @example LOADED']
  Note: '''@status planned @owner customer @features F-A9
One trip of a vehicle. F-A9 is suspended: no trip concept exists yet.
@vi-name Chuyến đi
@vi Một chuyến đi của xe. F-A9 đang tạm dừng: chưa có khái niệm chuyến đi.'''
}

Ref: trips.organization_id > organizations.organization_id [delete: restrict]
Ref: trips.vehicle_id > vehicles.vehicle_id [delete: restrict]
Ref: trips.driver_id > drivers.driver_id [delete: restrict]

